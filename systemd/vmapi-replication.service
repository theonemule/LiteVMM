[Unit]
Description=LiteVMM continuous disk replication controller
After=network-online.target nginx.service lighttpd.service vmapi-autostart.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/replicationctl daemon
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
