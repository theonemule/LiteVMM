# Long-running named GOST TAP overlay manager. Networking must be online before it reconciles overlay state.
[Unit]
Description=VMAPI named GOST TAP overlays
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/overlayctl run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
