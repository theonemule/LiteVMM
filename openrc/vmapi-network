#!/sbin/openrc-run
# Restores only standard bridges explicitly persisted through VMAPI.
name="VMAPI bridge restore"
description="Restore persisted VMAPI Linux bridges"

depend() {
  need localmount
  after networking
  before vmapi-autostart vmapi-overlay
}

start() {
  ebegin "Restoring persisted VMAPI Linux bridges"
  /usr/local/bin/netctl restore
  eend $?
}
