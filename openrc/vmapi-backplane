#!/sbin/openrc-run
name="vmapi-backplane"
description="LiteVMM peer storage backplane client"
supervisor="supervise-daemon"
command="/usr/local/bin/backplanectl"
command_args="daemon"
command_background="no"
respawn_delay="3"
respawn_max="0"
output_log="/var/log/vmapi-backplane.log"
error_log="/var/log/vmapi-backplane.log"
depend() {
  need net
  before docker vmapi-replication vmapi-autostart
}
stop_post() {
  /usr/local/bin/backplanectl suspend >/dev/null 2>&1 || true
}
