#!/sbin/openrc-run
name="vmapi-remote-volume"
description="LiteVMM peer-backed FUSE volume mounts"
supervisor="supervise-daemon"
command="/usr/local/bin/remote-volumectl"
command_args="daemon"
command_background="no"
respawn_delay="3"
respawn_max="0"
output_log="/var/log/vmapi-remote-volume.log"
error_log="/var/log/vmapi-remote-volume.log"

depend() {
  need net
  before docker
}

start_pre() {
  /usr/local/bin/remote-volumectl resume-all || true
}

stop_post() {
  /usr/local/bin/remote-volumectl suspend >/dev/null 2>&1 || true
}
