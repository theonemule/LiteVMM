#!/sbin/openrc-run
# Purpose: OpenRC service definition for a VMAPI runtime component.
# The web server provides public access; this service owns only the local runtime process.
supervisor=supervise-daemon
name="VMAPI console groomer"
description="Clean stale VMAPI noVNC/WebSocket console sessions"
command=/usr/local/bin/vmapi-console-gc
command_user=root:root
pidfile=/run/vmapi-console-gc.pid
output_log=/var/log/vmapi-console-gc.log
error_log=/var/log/vmapi-console-gc.log
depend() {
  need localmount
  after lighttpd fcgiwrap-vmapi
}
