#!/sbin/openrc-run
# Purpose: OpenRC service definition for a VMAPI runtime component.
# The web server provides public access; this service owns only the local runtime process.
supervisor=supervise-daemon
name="VMAPI websockify broker"
description="Token-routed WebSockify broker for VMAPI noVNC consoles"
command=/usr/bin/websockify
command_args="--token-plugin=TokenFile --token-source=/run/vmapi/console.tokens 127.0.0.1:6080"
pidfile=/run/websockify-vmapi.pid
output_log=/var/log/websockify-vmapi.log
error_log=/var/log/websockify-vmapi.log
depend() {
  need localmount
  after net
}
start_pre() {
  checkpath -d -m 0755 -o vmapi:vmapi /run/vmapi
  checkpath -d -m 0755 -o vmapi:vmapi /run/vmapi/consoles
  checkpath -f -m 0640 -o vmapi:vmapi /run/vmapi/console.tokens
  pkill -f '/usr/bin/websockify' >/dev/null 2>&1 || true
  rm -f /run/websockify-vmapi.pid
}
