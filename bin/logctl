#!/usr/bin/env bash
# Purpose: VMAPI privileged command-line component.
# Called by the CGI API or service units; environment variables may override paths for tests.
# Validate externally supplied values before passing them to host virtualization or container tools.
set -Eeuo pipefail
source_name=${1:-all}; limit=${2:-300}
[[ $limit =~ ^[0-9]+$ ]] && ((limit>0 && limit<=2000)) || { echo 'invalid limit' >&2; exit 1; }
emit(){ local source=$1 path=$2; [[ -r $path ]] || return 0; tail -n "$limit" "$path" 2>/dev/null | awk '{ lines[NR]=$0 } END { for (i=NR; i>0; i--) print lines[i] }' | while IFS= read -r line; do line=${line//\\/\\\\}; line=${line//\"/\\\"}; line=${line//$'\r'/}; line=${line//$'\n'/\\n}; printf '{"source":"%s","message":"%s"}\n' "$source" "$line"; done; }
case $source_name in all) emit system /var/log/messages; emit overlay /var/log/vmapi-overlay.log; emit docker /var/log/docker.log; emit fcgi /var/log/fcgiwrap-vmapi.log; emit ttyd /var/log/ttyd-vmapi.log; emit websockify /var/log/websockify-vmapi.log;; system) emit system /var/log/messages;; overlay) emit overlay /var/log/vmapi-overlay.log;; docker) emit docker /var/log/docker.log;; fcgi) emit fcgi /var/log/fcgiwrap-vmapi.log;; ttyd) emit ttyd /var/log/ttyd-vmapi.log;; websockify) emit websockify /var/log/websockify-vmapi.log;; *) echo 'unknown log source' >&2; exit 1;; esac
