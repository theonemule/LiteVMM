#!/usr/bin/env bash
# Purpose: return recent host service logs as newline-delimited JSON.
set -Eeuo pipefail
source_name=${1:-all}; limit=${2:-300}
[[ $limit =~ ^[0-9]+$ ]] && ((limit>0 && limit<=2000)) || { echo 'invalid limit' >&2; exit 1; }

emit(){
  local source=$1 path=$2
  [[ -r $path ]] || return 0
  tail -n "$limit" "$path" 2>/dev/null |
    awk '{ lines[NR]=$0 } END { for (i=NR; i>0; i--) print lines[i] }' |
    while IFS= read -r line; do
      line=${line//\\/\\\\}; line=${line//\"/\\\"}; line=${line//$'\r'/}; line=${line//$'\n'/\\n}
      printf '{"source":"%s","message":"%s"}\n' "$source" "$line"
    done
}

emit_transports(){
  local f
  emit transport /var/log/vmapi-overlay.log
  emit transport /var/log/vmapi-backplane.log
  emit transport /var/log/vmapi-backplane-server.log
  shopt -s nullglob
  for f in /run/vmapi/consoles/*.websocat.log /run/vmapi-backplane/*.websocat.log /run/vmapi-backplane/websocat-server.log; do emit transport "$f"; done
  # Include pre-upgrade GOST logs if they remain on disk.
  for f in /run/vmapi/consoles/*.gost.log /run/vmapi-backplane/*.gost.log; do emit legacy-gost "$f"; done
  shopt -u nullglob
}

case $source_name in
  all)
    emit system /var/log/messages
    emit overlay /var/log/vmapi-overlay.log
    emit docker /var/log/docker.log
    emit fcgi /var/log/fcgiwrap-vmapi.log
    emit ttyd /var/log/ttyd-vmapi.log
    emit_transports
    ;;
  system) emit system /var/log/messages;;
  overlay) emit overlay /var/log/vmapi-overlay.log;;
  docker) emit docker /var/log/docker.log;;
  fcgi) emit fcgi /var/log/fcgiwrap-vmapi.log;;
  ttyd) emit ttyd /var/log/ttyd-vmapi.log;;
  transport|gost) emit_transports;;
  *) echo 'unknown log source' >&2; exit 1;;
esac
