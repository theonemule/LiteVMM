#!/usr/bin/env bash
# LiteVMM trusted peer storage backplane: NFS over the existing peer WebSocket endpoint.
set -Eeuo pipefail
LIB=${VMAPI_LIB:-/usr/local/lib/vmapi/common.sh}
[[ -r "$LIB" ]] || LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)/common.sh"
source "$LIB"

PEERCTL=${VMAPI_PEERCTL:-/usr/local/bin/peerctl}
WEBSOCAT=${VMAPI_WEBSOCAT:-$(command -v websocat 2>/dev/null || printf %s /usr/local/bin/websocat)}
MOUNT_BIN=${VMAPI_MOUNT_BIN:-/bin/mount}
UMOUNT_BIN=${VMAPI_UMOUNT_BIN:-/bin/umount}
EXPORTFS=${VMAPI_EXPORTFS:-$(command -v exportfs 2>/dev/null || printf %s /usr/sbin/exportfs)}
RPC_NFSD=${VMAPI_RPC_NFSD:-$(command -v rpc.nfsd 2>/dev/null || printf %s /usr/sbin/rpc.nfsd)}
UNFSD=${VMAPI_UNFSD:-$(command -v unfsd 2>/dev/null || printf %s /usr/local/sbin/unfsd)}
NFS_BACKEND=${VMAPI_BACKPLANE_NFS_BACKEND:-kernel}
NFS_VERSION=${VMAPI_BACKPLANE_NFS_VERSION:-4.2}
NFS_EXPORT=${VMAPI_BACKPLANE_NFS_EXPORT:-/}
NFS_INTERNAL_ONLY=${VMAPI_BACKPLANE_NFS_INTERNAL_ONLY:-false}
# Tool locations differ by distribution (Debian: /usr/bin/ss, Alpine: /sbin/ss)
# and service managers may start us with a short PATH, so search the sbin dirs.
find_tool(){
  local name=$1 dir path
  path=$(command -v "$name" 2>/dev/null) && { printf '%s\n' "$path"; return; }
  for dir in /usr/sbin /sbin /usr/bin /bin; do [[ -x $dir/$name ]] && { printf '%s\n' "$dir/$name"; return; }; done
  printf '/usr/sbin/%s\n' "$name"
}
NFS_EXPORTD=${VMAPI_NFS_EXPORTD:-$(find_tool nfsv4.exportd)}
# Alpine's nfs-utils has no nfsv4.exportd; rpc.mountd answers the same kernel
# export upcalls when NFSv2/v3 and UDP are disabled.
RPC_MOUNTD=${VMAPI_RPC_MOUNTD:-$(find_tool rpc.mountd)}
SS=${VMAPI_SS:-$(find_tool ss)}

BACKPLANE_ROOT=${VMAPI_BACKPLANE_ROOT:-/var/lib/vmapi/backplane}
MOUNT_ROOT=${VMAPI_BACKPLANE_MOUNT_ROOT:-/var/lib/vmapi/peer-storage}
SHARED_ROOT="$BACKPLANE_ROOT/shared"
STATE_ROOT=${VMAPI_BACKPLANE_STATE_ROOT:-/var/lib/vmapi/backplane-peers}
RUN_ROOT=${VMAPI_BACKPLANE_RUN_ROOT:-/run/vmapi-backplane}
NFS_BIND=${VMAPI_BACKPLANE_NFS_BIND:-127.0.0.1}
NFS_PORT=${VMAPI_BACKPLANE_NFS_PORT:-2049}
NFS_EXPORT_CLIENT=${VMAPI_BACKPLANE_NFS_EXPORT_CLIENT:-127.0.0.1}
WS_BIND=${VMAPI_BACKPLANE_WS_BIND:-127.0.0.1}
WS_PORT=${VMAPI_BACKPLANE_WS_PORT:-6091}
DAEMON_INTERVAL=${VMAPI_BACKPLANE_DAEMON_INTERVAL:-10}
SERVER_ENABLED=${VMAPI_BACKPLANE_SERVER:-false}
NFS_THREADS=${VMAPI_BACKPLANE_NFS_THREADS:-8}

valid_peer(){ [[ ${1:-} =~ ^[A-Fa-f0-9]{32}$ ]] || die 'Invalid peer node id'; }
valid_kind(){ [[ ${1:-} =~ ^(backups|replicas|vm-disks|docker-volumes|registry|artifacts)$ ]] || die "Invalid backplane storage class: ${1:-}"; }
valid_shared_kind(){ [[ ${1:-} =~ ^(isos|docker-rootfs)$ ]] || die "Invalid shared backplane storage class: ${1:-}"; }
valid_name(){ [[ ${1:-} =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || die "Invalid backplane name: ${1:-}"; }
valid_port(){ validate_positive_int "$1"; ((10#$1 <= 65535)) || die 'Invalid port'; }
valid_ipv4_bind(){ [[ ${1:-} =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || die 'Backplane NFS bind must be an IPv4 address'; }
state_file(){ valid_peer "$1"; printf '%s/%s.conf\n' "$STATE_ROOT" "${1,,}"; }
pid_file(){ valid_peer "$1"; printf '%s/%s.websocat.pid\n' "$RUN_ROOT" "${1,,}"; }
legacy_pid_file(){ valid_peer "$1"; printf '%s/%s.gost.pid\n' "$RUN_ROOT" "${1,,}"; }
log_file(){ valid_peer "$1"; printf '%s/%s.websocat.log\n' "$RUN_ROOT" "${1,,}"; }
mountpoint(){ valid_peer "$1"; printf '%s/%s\n' "$MOUNT_ROOT" "${1,,}"; }

ensure_dirs(){
  # The NFS export root and the peers container are path components for QEMU
  # and the unprivileged vmapi worker on the client. They need execute
  # permission without granting directory listing or write access. Individual
  # peer namespaces remain 0770 and are owned by the client's vmapi uid/gid.
  install -d -m 0711 "$BACKPLANE_ROOT"
  install -d -m 0750 "$STATE_ROOT"
  install -d -m 0755 "$MOUNT_ROOT"
  install -d -m 0700 "$RUN_ROOT"
  install -d -m 0711 "$BACKPLANE_ROOT/peers"
  install -d -m 0755 "$SHARED_ROOT" "$SHARED_ROOT/docker-rootfs"
  chmod 0711 "$BACKPLANE_ROOT" "$BACKPLANE_ROOT/peers"
}

json_field(){ local json=$1 key=$2; printf '%s' "$json" | sed -n 's/.*"'"$key"'":"\([^"]*\)".*/\1/p' | head -n1; }
json_has_cap(){ local json=$1 cap=$2; printf '%s' "$json" | grep -Fq '"'"$cap"'"'; }

local_node_id(){
  local out id
  out=$("$PEERCTL" identity)
  id=$(json_field "$out" node_id)
  valid_peer "$id"
  printf '%s\n' "${id,,}"
}

peer_profile(){ "$PEERCTL" transport-profile "$1"; }

# Returns 0 if the peer advertises the backplane, 1 if it does not, 2 if it
# could not be queried (reason in PEER_QUERY_ERROR). Never exits: the daemon's
# reconcile loop must keep serving other peers.
peer_supports_backplane(){
  local peer=$1 out
  valid_peer "$peer"; PEER_QUERY_ERROR=''; PEER_NFS_VERSION=''; PEER_NFS_EXPORT=''
  if ! out=$("$PEERCTL" proxy "$peer" GET / 2>&1); then
    PEER_QUERY_ERROR="Could not query paired host $peer: ${out:0:300}"; return 2
  fi
  json_has_cap "$out" storage-backplane || return 1
  PEER_NFS_VERSION=$(json_field "$out" backplane_nfs_version)
  [[ -n $PEER_NFS_VERSION ]] || PEER_NFS_VERSION=4.2
  [[ $PEER_NFS_VERSION =~ ^(3|4|4[.]1|4[.]2)$ ]] || { PEER_QUERY_ERROR="Peer advertised an invalid backplane NFS version"; return 2; }
  PEER_NFS_EXPORT=$(json_field "$out" backplane_nfs_export)
  [[ -n $PEER_NFS_EXPORT ]] || PEER_NFS_EXPORT=/
  [[ $PEER_NFS_EXPORT == /* && $PEER_NFS_EXPORT != *'..'* ]] || { PEER_QUERY_ERROR="Peer advertised an invalid backplane NFS export path"; return 2; }
}

load_state(){
  local peer=$1 f
  f=$(state_file "$peer")
  [[ -r $f ]] || return 1
  PEER='' PORT='' MOUNTPOINT=''
  source "$f"
  valid_peer "$PEER"; valid_port "$PORT"
  [[ $MOUNTPOINT == "$(mountpoint "$PEER")" ]] || die 'Invalid backplane mount state'
}

write_state(){
  local peer=$1 port=$2 mp tmp
  valid_peer "$peer"; valid_port "$port"; mp=$(mountpoint "$peer")
  tmp=$(mktemp "$STATE_ROOT/.peer.XXXXXX")
  printf 'PEER=%q\nPORT=%q\nMOUNTPOINT=%q\n' "${peer,,}" "$port" "$mp" > "$tmp"
  chmod 0600 "$tmp"; mv "$tmp" "$(state_file "$peer")"
}

pid_from_file(){ local f=$1 p=''; [[ -r $f ]] && read -r p < "$f" || true; [[ $p =~ ^[0-9]+$ ]] && printf '%s\n' "$p"; }
pid_alive(){ local p; p=$(pid_from_file "$1" || true); [[ -n $p ]] && kill -0 "$p" 2>/dev/null; }
kill_pidfile(){
  local f=$1 p; p=$(pid_from_file "$f" || true)
  if [[ -n $p ]] && kill -0 "$p" 2>/dev/null; then
    kill "$p" 2>/dev/null || true
    for _ in {1..30}; do kill -0 "$p" 2>/dev/null || break; sleep .05; done
    kill -0 "$p" 2>/dev/null && kill -KILL "$p" 2>/dev/null || true
  fi
  rm -f -- "$f"
}

port_in_use(){ "$SS" -ltnH 2>/dev/null | awk '{print $4}' | grep -Eq "(^|:)$1$"; }
free_port(){
  local start=${1:-32000} end=${2:-38999} p
  for _ in {1..700}; do
    p=$((start + RANDOM % (end-start+1)))
    port_in_use "$p" || { printf '%s\n' "$p"; return; }
  done
  die 'Could not allocate a loopback port for the peer backplane'
}
wait_port(){ local p=$1; for _ in {1..100}; do port_in_use "$p" && return 0; sleep .05; done; return 1; }
is_mounted(){ local mp=$1; awk -v p="$mp" '$2==p && $3 ~ /^nfs/ {found=1} END{exit !found}' /proc/mounts; }

start_tunnel(){
  local peer=$1 port=$2 profile endpoint user pass ca_file header scheme host remote_port pf lf legacy_pf url
  local -a args env_args
  need_cmd "$WEBSOCAT"; need_cmd "$SS"
  profile=$(peer_profile "$peer"); endpoint=$(json_field "$profile" endpoint); user=$(json_field "$profile" username); pass=$(json_field "$profile" password); ca_file=$(json_field "$profile" ca_file)
  [[ -n $user && -n $pass ]] || die 'Peer backplane credentials are unavailable'
  [[ $endpoint =~ ^(wss?)://([A-Za-z0-9.-]+)(:([0-9]{1,5}))?(/.*)?$ ]] || die 'Peer has no WebSocket-capable endpoint'
  scheme=${BASH_REMATCH[1]}; host=${BASH_REMATCH[2]}; remote_port=${BASH_REMATCH[4]}; [[ -n $remote_port ]] || { [[ $scheme == wss ]] && remote_port=443 || remote_port=80; }
  header=$(printf '%s:%s' "$user" "$pass"|base64|tr -d '\n')
  pf=$(pid_file "$peer"); legacy_pf=$(legacy_pid_file "$peer"); lf=$(log_file "$peer")
  kill_pidfile "$pf"; kill_pidfile "$legacy_pf"; rm -f -- "$RUN_ROOT/${peer,,}.gost.yaml"
  port_in_use "$port" && die "Backplane loopback port is already in use: $port"
  url="$scheme://$host:$remote_port/backplane/storage"
  args=(--binary --exit-on-eof --ping-interval 20 --basic-auth "$header")
  env_args=()
  if [[ $scheme == wss ]]; then
    args+=(--tls-domain "$host")
    if [[ -n $ca_file ]]; then
      [[ -r $ca_file ]] || die 'Peer TLS CA certificate is missing'
      env_args+=("SSL_CERT_FILE=$ca_file")
    fi
  fi
  : >"$lf"; chmod 0600 "$lf"
  setsid env "${env_args[@]}" "$WEBSOCAT" "${args[@]}" "tcp-l:127.0.0.1:$port" "$url" </dev/null >>"$lf" 2>&1 & echo $! >"$pf"
  wait_port "$port" && pid_alive "$pf" || { tail -40 "$lf" >&2 2>/dev/null || true; die 'Peer backplane WebSocket tunnel failed to start'; }
}

repair_mount_traversal(){
  local peer=$1 mp
  mp=$(mountpoint "$peer")
  # Older servers exported these parent directories as 0750/0770. Because the
  # export uses no_root_squash, the privileged client can repair the two path
  # components in-place so vmapi/QEMU can traverse an already-mounted peer
  # immediately after an upgrade.
  [[ -d $mp ]] || return 0
  chmod 0711 "$mp" 2>/dev/null || true
  [[ -d $mp/peers ]] && chmod 0711 "$mp/peers" 2>/dev/null || true
}

mount_peer(){
  local peer=$1 port=$2 version=${3:-4.2} export_path=${4:-/} mp id opts source
  need_cmd "$MOUNT_BIN"
  mp=$(mountpoint "$peer"); install -d -m 0755 "$mp"
  # retry=0 + timeout: one attempt per call. Retrying is the daemon's job, with
  # backoff; mount.nfs's own retry loop against an unreachable peer generated
  # enough connections to exhaust nf_conntrack on small hosts.
  if [[ $version == 3 ]]; then
    opts="vers=3,proto=tcp,port=$port,mountport=$port,nolock,hard,timeo=600,retrans=2,retry=0"
    source="127.0.0.1:$export_path"
  else
    opts="vers=$version,proto=tcp,port=$port,nconnect=1,hard,timeo=600,retrans=2,retry=0"
    source="127.0.0.1:/"
  fi
  is_mounted "$mp" || timeout "${VMAPI_BACKPLANE_MOUNT_TIMEOUT:-90}" "$MOUNT_BIN" -t nfs -o "$opts" "$source" "$mp"
  repair_mount_traversal "$peer"
  id=$(local_node_id)
  install -d -m 0770 "$mp/peers/$id"
  install -d -m 0770 "$mp/peers/$id"/{backups,replicas,vm-disks,docker-volumes,registry,artifacts}
  # The client-side vmapi worker and QEMU process must be able to traverse and
  # use their own namespace on the remote NFS export. NFS AUTH_SYS evaluates
  # numeric ownership from this client, so stamp the mounted directories with
  # this host's vmapi uid/gid.
  if id vmapi >/dev/null 2>&1; then
    chown vmapi:vmapi "$mp/peers/$id" "$mp/peers/$id"/{backups,replicas,vm-disks,docker-volumes,registry,artifacts} 2>/dev/null || true
  fi
}

connect_peer(){
  ensure_dirs
  local peer=${1:?peer required} port mp
  valid_peer "$peer"; peer=${peer,,}; mp=$(mountpoint "$peer")
  local rc=0; peer_supports_backplane "$peer" || rc=$?
  ((rc != 2)) || die "$PEER_QUERY_ERROR"
  ((rc == 0)) || die 'Paired host does not advertise the storage-backplane capability (it needs VMAPI_BACKPLANE_SERVER=true in a vmapi.conf its web API can read)'
  if load_state "$peer" 2>/dev/null; then port=$PORT; else port=$(free_port); write_state "$peer" "$port"; fi
  if is_mounted "$mp" && pid_alive "$(pid_file "$peer")"; then
    repair_mount_traversal "$peer"
    show_peer "$peer"
    return
  fi
  is_mounted "$mp" && "$UMOUNT_BIN" "$mp" >/dev/null 2>&1 || true
  pid_alive "$(pid_file "$peer")" || start_tunnel "$peer" "$port"
  # Do not leave a tunnel behind a failed mount; the next attempt starts clean.
  if ! (mount_peer "$peer" "$port" "$PEER_NFS_VERSION" "$PEER_NFS_EXPORT"); then kill_pidfile "$(pid_file "$peer")"; die "Could not mount the storage backplane of peer $peer"; fi
  show_peer "$peer"
}

disconnect_peer(){
  local peer=${1:?peer required} forget=${2:-false} mp
  valid_peer "$peer"; validate_bool "$forget"; peer=${peer,,}; mp=$(mountpoint "$peer")
  if is_mounted "$mp"; then "$UMOUNT_BIN" "$mp" || "$UMOUNT_BIN" -l "$mp" || true; fi
  kill_pidfile "$(pid_file "$peer")"
  kill_pidfile "$(legacy_pid_file "$peer")"
  $forget && rm -f -- "$(state_file "$peer")" "$(log_file "$peer")" "$RUN_ROOT/${peer,,}.gost.log" "$RUN_ROOT/${peer,,}.gost.yaml"
  rmdir "$mp" 2>/dev/null || true
}

show_peer(){
  local peer=${1:?peer required} mounted=false tunnel=false port=0 mp
  valid_peer "$peer"; peer=${peer,,}; mp=$(mountpoint "$peer")
  if load_state "$peer" 2>/dev/null; then port=$PORT; fi
  is_mounted "$mp" && mounted=true
  pid_alive "$(pid_file "$peer")" && tunnel=true
  printf '{"peer_id":"%s","mountpoint":"%s","port":%s,"mounted":%s,"tunnel_running":%s}\n' "$peer" "$(json_escape "$mp")" "$port" "$mounted" "$tunnel"
}

list_peers(){
  ensure_dirs
  local f first=true
  printf '['
  shopt -s nullglob
  for f in "$STATE_ROOT"/*.conf; do
    $first || printf ','; first=false
    show_peer "$(basename "$f" .conf)" | tr -d '\n'
  done
  shopt -u nullglob
  printf ']\n'
}

path_for(){
  local peer=${1:?peer required} kind=${2:?storage class required} name=${3:-} id base
  valid_peer "$peer"; valid_kind "$kind"; [[ -z $name ]] || valid_name "$name"
  connect_peer "$peer" >/dev/null
  id=$(local_node_id)
  base="$(mountpoint "$peer")/peers/$id/$kind"
  install -d -m 0770 "$base"
  if id vmapi >/dev/null 2>&1; then chown vmapi:vmapi "$base" 2>/dev/null || true; fi
  if [[ -n $name ]]; then
    install -d -m 0770 "$base/$name"
    if id vmapi >/dev/null 2>&1; then chown vmapi:vmapi "$base/$name" 2>/dev/null || true; fi
    printf '%s/%s\n' "$base" "$name"
  else
    printf '%s\n' "$base"
  fi
}

shared_path_for(){
  local peer=${1:?peer required} kind=${2:?storage class required} name=${3:-} base
  valid_peer "$peer"; valid_shared_kind "$kind"; [[ -z $name ]] || valid_name "$name"
  connect_peer "$peer" >/dev/null
  base="$(mountpoint "$peer")/shared/$kind"
  [[ -d $base ]] || die "Peer does not publish shared $kind storage"
  if [[ -n $name ]]; then
    [[ -e $base/$name ]] || die "Shared $kind item not found: $name"
    printf '%s/%s\n' "$base" "$name"
  else
    printf '%s\n' "$base"
  fi
}

is_bind_mounted(){
  local path=$1
  awk -v p="$path" '$2==p {found=1} END{exit !found}' /proc/mounts
}
publish_shared_storage(){
  ensure_dirs
  install -d -m 0755 "$ISO_ROOT" "$SHARED_ROOT/isos" "$SHARED_ROOT/docker-rootfs"
  # Container storage profiles place ISO_ROOT directly in the exported tree so
  # no bind mount or CAP_SYS_ADMIN is required. Host installs retain the
  # read-only bind mount because their ISO library lives outside the backplane.
  if [[ "$ISO_ROOT" == "$SHARED_ROOT/isos" ]]; then
    return 0
  fi
  [[ "$NFS_BACKEND" == kernel ]] || die 'Userspace NFS requires ISO_ROOT to be inside the backplane shared/isos tree'
  if ! is_bind_mounted "$SHARED_ROOT/isos"; then
    "$MOUNT_BIN" --bind "$ISO_ROOT" "$SHARED_ROOT/isos"
    "$MOUNT_BIN" -o remount,bind,ro "$SHARED_ROOT/isos"
  fi
}
unpublish_shared_storage(){
  [[ "$ISO_ROOT" == "$SHARED_ROOT/isos" ]] && return 0
  is_bind_mounted "$SHARED_ROOT/isos" && "$UMOUNT_BIN" "$SHARED_ROOT/isos" >/dev/null 2>&1 || true
}

# Per-peer retry backoff for the reconcile loop: 30s doubling to 15 minutes,
# cleared on success. Explicit connects (e.g. a backup) ignore it.
backoff_file(){ printf '%s/%s.backoff\n' "$RUN_ROOT" "$1"; }
backoff_active(){
  local f next=0 delay; f=$(backoff_file "$1"); [[ -r $f ]] || return 1
  read -r next delay < "$f" || return 1
  [[ $next =~ ^[0-9]+$ ]] && (( $(date +%s) < next ))
}
backoff_fail(){
  local f next delay=0; f=$(backoff_file "$1")
  [[ -r $f ]] && read -r next delay < "$f" || true
  [[ $delay =~ ^[0-9]+$ ]] || delay=0
  delay=$(( delay * 2 )); (( delay >= 30 )) || delay=30; (( delay <= 900 )) || delay=900
  printf '%s %s\n' "$(( $(date +%s) + delay ))" "$delay" > "$f"
  echo "Peer $1 backplane unavailable; retrying in ${delay}s" >&2
}
backoff_clear(){ rm -f -- "$(backoff_file "$1")"; }

reconcile(){
  ensure_dirs
  local peers peer f failed=0
  peers=$("$PEERCTL" list 2>/dev/null || printf '[]')
  while IFS= read -r peer; do
    [[ -n $peer ]] || continue
    backoff_active "$peer" && continue
    peer_supports_backplane "$peer" || { [[ -z ${PEER_QUERY_ERROR:-} ]] || backoff_fail "$peer"; continue; }
    if (connect_peer "$peer" >/dev/null); then backoff_clear "$peer"
    else echo "Could not connect storage backplane for peer $peer" >&2; backoff_fail "$peer"; failed=1; fi
  done < <(printf '%s' "$peers" | grep -o '"node_id":"[a-fA-F0-9]\{32\}"' | cut -d'"' -f4)
  shopt -s nullglob
  for f in "$STATE_ROOT"/*.conf; do
    peer=$(basename "$f" .conf)
    printf '%s' "$peers" | grep -Fq "\"node_id\":\"$peer\"" || disconnect_peer "$peer" true
  done
  shopt -u nullglob
  return "$failed"
}

suspend(){
  local f peer
  ensure_dirs; shopt -s nullglob
  for f in "$STATE_ROOT"/*.conf; do peer=$(basename "$f" .conf); disconnect_peer "$peer" false; done
  shopt -u nullglob
  printf '{"suspended":true}\n'
}

revoke_peer(){ local peer=${1:?peer required}; valid_peer "$peer"; disconnect_peer "$peer" true; }

listener_addresses(){
  local port=$1 proto=${2:-tcp}
  if [[ $proto == tcp ]]; then "$SS" -ltnH 2>/dev/null | awk -v p=":$port" '$4 ~ p"$" {print $4}'; else "$SS" -lunH 2>/dev/null | awk -v p=":$port" '$4 ~ p"$" {print $4}'; fi
}

server_verify(){
  valid_ipv4_bind "$NFS_BIND"; valid_port "$NFS_PORT"; valid_port "$WS_PORT"; need_cmd "$SS"
  local addr external=false nfs_ok=false ws_ok=false
  [[ $NFS_BIND == 127.0.0.1 ]] || external=true
  [[ $NFS_EXPORT_CLIENT == 127.0.0.1 ]] || external=true
  [[ $WS_BIND == 127.0.0.1 ]] || external=true
  while IFS= read -r addr; do
    [[ -n $addr ]] || continue
    if [[ $addr == "$NFS_BIND:$NFS_PORT" ||
          ( $NFS_BACKEND == unfs3 && $NFS_BIND == 127.0.0.1 && $addr == "[::ffff:127.0.0.1]:$NFS_PORT" ) ]]; then
      nfs_ok=true
    else
      external=true
    fi
  done < <(listener_addresses "$NFS_PORT" tcp)
  while IFS= read -r addr; do
    [[ -n $addr ]] || continue
    [[ $addr == "$WS_BIND:$WS_PORT" ]] && ws_ok=true || external=true
  done < <(listener_addresses "$WS_PORT" tcp)
  if listener_addresses "$NFS_PORT" udp | grep -q .; then external=true; fi
  printf '{"server_enabled":%s,"nfs_bind":"%s","nfs_export_client":"%s","nfs_port":%s,"nfs_listening":%s,"websocket_bind":"%s","websocket_port":%s,"websocket_listening":%s,"external_exposure":%s}\n' "$SERVER_ENABLED" "$NFS_BIND" "$(json_escape "$NFS_EXPORT_CLIENT")" "$NFS_PORT" "$nfs_ok" "$WS_BIND" "$WS_PORT" "$ws_ok" "$external"
  $nfs_ok && $ws_ok
}

server_cleanup(){
  [[ -r "$RUN_ROOT/websocat-server.pid" ]] && kill_pidfile "$RUN_ROOT/websocat-server.pid" || true
  [[ -r "$RUN_ROOT/gost-server.pid" ]] && kill_pidfile "$RUN_ROOT/gost-server.pid" || true
  rm -f -- "$RUN_ROOT/gost-server.yaml"
  if [[ "$NFS_BACKEND" == unfs3 ]]; then
    [[ -r "$RUN_ROOT/unfs3.pid" ]] && kill_pidfile "$RUN_ROOT/unfs3.pid" || true
    rm -f -- "$RUN_ROOT/unfs3.exports"
  else
    [[ -r "$RUN_ROOT/exportd.pid" ]] && kill_pidfile "$RUN_ROOT/exportd.pid" || true
    "$RPC_NFSD" 0 >/dev/null 2>&1 || true
    "$EXPORTFS" -u "$NFS_EXPORT_CLIENT:$BACKPLANE_ROOT" >/dev/null 2>&1 || true
  fi
  unpublish_shared_storage
}

start_unfs3(){
  need_cmd "$UNFSD"
  [[ $NFS_VERSION == 3 ]] || die 'UNFS3 backend requires VMAPI_BACKPLANE_NFS_VERSION=3'
  ((10#$NFS_PORT >= 1024)) || die 'UNFS3 backend requires an unprivileged NFS port (1024 or higher)'
  [[ $NFS_EXPORT == "$BACKPLANE_ROOT" ]] || die 'UNFS3 export path must match VMAPI_BACKPLANE_ROOT'
  [[ $NFS_EXPORT_CLIENT == 127.0.0.1 ]] || die 'UNFS3 container backend only supports a loopback export client'
  # The WebSocket bridge re-originates the loopback TCP connection from an ephemeral source port.
  # 'insecure' permits that source port; the export itself remains restricted to 127.0.0.1.
  printf '%s %s(rw,no_root_squash,insecure)\n' "$BACKPLANE_ROOT" "$NFS_EXPORT_CLIENT" > "$RUN_ROOT/unfs3.exports"
  chmod 0600 "$RUN_ROOT/unfs3.exports"
  setsid "$UNFSD" -d -t -p -u -l "$NFS_BIND" -n "$NFS_PORT" -m "$NFS_PORT" -e "$RUN_ROOT/unfs3.exports" </dev/null >>"$RUN_ROOT/unfs3.log" 2>&1 &
  echo $! > "$RUN_ROOT/unfs3.pid"
}

server_daemon(){
  [[ $SERVER_ENABLED == true ]] || die 'Storage backplane server is disabled'
  if [[ $NFS_INTERNAL_ONLY == true ]]; then
    [[ $NFS_EXPORT_CLIENT == 127.0.0.1 ]] || die 'Internal-only NFS mode requires a loopback-only export client'
  fi
  ensure_dirs
  publish_shared_storage
  need_cmd "$WEBSOCAT"; need_cmd "$SS"
  valid_ipv4_bind "$NFS_BIND"; valid_port "$NFS_PORT"; valid_port "$WS_PORT"; validate_positive_int "$NFS_THREADS"

  case "$NFS_BACKEND" in
    unfs3)
      start_unfs3
      ;;
    kernel)
      need_cmd "$EXPORTFS"; need_cmd "$RPC_NFSD"
      local -a export_daemon
      if [[ -x $NFS_EXPORTD ]]; then export_daemon=("$NFS_EXPORTD" -F)
      elif [[ -x $RPC_MOUNTD ]]; then export_daemon=("$RPC_MOUNTD" -F -N 2 -N 3 -u)
      else die "Neither nfsv4.exportd nor rpc.mountd is installed ($NFS_EXPORTD, $RPC_MOUNTD)"; fi
      command -v modprobe >/dev/null 2>&1 && modprobe nfsd 2>/dev/null || true
      [[ -d /proc/fs/nfsd ]] || die 'Kernel NFS server support (nfsd) is unavailable'
      install -d -m 0755 /var/lib/nfs
      awk '$2=="/proc/fs/nfsd" && $3=="nfsd" {f=1} END{exit !f}' /proc/mounts || "$MOUNT_BIN" -t nfsd nfsd /proc/fs/nfsd
      "$RPC_NFSD" 0 >/dev/null 2>&1 || true
      "$EXPORTFS" -u "$NFS_EXPORT_CLIENT:$BACKPLANE_ROOT" >/dev/null 2>&1 || true
      "$EXPORTFS" -i -o rw,sync,no_subtree_check,no_root_squash,insecure,crossmnt,fsid=0 "$NFS_EXPORT_CLIENT:$BACKPLANE_ROOT"
      "${export_daemon[@]}" </dev/null >>"$RUN_ROOT/exportd.log" 2>&1 & echo $! > "$RUN_ROOT/exportd.pid"
      "$RPC_NFSD" --host "$NFS_BIND" --port "$NFS_PORT" --no-udp --no-nfs-version 3 --no-nfs-version 4.0 --nfs-version 4.1 --nfs-version 4.2 "$NFS_THREADS"
      ;;
    *)
      die "Unknown NFS backend: $NFS_BACKEND"
      ;;
  esac

  # Lighttpd owns public HTTP(S), TLS and Basic authentication. This listener
  # is deliberately plaintext WebSocket on loopback only.
  : >"$RUN_ROOT/websocat-server.log"; chmod 0600 "$RUN_ROOT/websocat-server.log"
  setsid "$WEBSOCAT" --binary --exit-on-eof --ping-interval 20 "ws-l:$WS_BIND:$WS_PORT" "tcp:$NFS_BIND:$NFS_PORT" </dev/null >>"$RUN_ROOT/websocat-server.log" 2>&1 & echo $! > "$RUN_ROOT/websocat-server.pid"
  trap 'server_cleanup; exit 0' TERM INT EXIT
  for _ in {1..100}; do server_verify >/dev/null 2>&1 && break; sleep .05; done
  if ! server_verify >/dev/null; then
    [[ "$NFS_BACKEND" == unfs3 ]] && tail -100 "$RUN_ROOT/unfs3.log" >&2 2>/dev/null || true
    die 'Storage backplane did not bind to the configured loopback endpoints'
  fi
  while :; do
    if [[ "$NFS_BACKEND" == unfs3 ]]; then
      pid_alive "$RUN_ROOT/unfs3.pid" || die 'Userspace NFS server exited'
    else
      pid_alive "$RUN_ROOT/exportd.pid" || die 'NFSv4 export daemon exited'
    fi
    pid_alive "$RUN_ROOT/websocat-server.pid" || die 'Backplane WebSocket bridge exited'
    sleep "$DAEMON_INTERVAL" & wait $!
  done
}

daemon(){
  trap 'suspend >/dev/null 2>&1 || true; exit 0' TERM INT
  while :; do reconcile || true; sleep "$DAEMON_INTERVAL" & wait $!; done
}

case ${1:-help} in
  connect) shift; connect_peer "$@";;
  disconnect) shift; disconnect_peer "$@" ;;
  show) shift; show_peer "$@";;
  list) list_peers;;
  path) shift; path_for "$@";;
  shared-path) shift; shared_path_for "$@";;
  reconcile) reconcile;;
  revoke-peer) shift; revoke_peer "$@";;
  suspend) suspend;;
  daemon) daemon;;
  server-daemon) server_daemon;;
  server-status|server-verify) server_verify;;
  help|-h|--help) echo 'backplanectl connect PEER | disconnect PEER [FORGET] | show PEER | list | path PEER CLASS [NAME] | shared-path PEER isos|docker-rootfs [NAME] | reconcile | revoke-peer PEER | daemon | server-daemon | server-status';;
  *) die "Unknown backplane command: ${1:-}";;
esac
