#!/usr/bin/env bash
# Manage a loopback-only CNCF Distribution registry behind LiteVMM's HTTPS endpoint.
set -Eeuo pipefail
LIB=${VMAPI_LIB:-/usr/local/lib/vmapi/common.sh}
[[ -r "$LIB" ]] || LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)/common.sh"
source "$LIB"
DOCKER_BIN=${DOCKER_BIN:-/usr/bin/docker}
ROOT=${VMAPI_REGISTRY_ROOT:-/var/lib/vmapi/registry}
CONF=${VMAPI_REGISTRY_CONFIG:-/etc/vmapi/registry.conf}
PASSWD_FILE=${VMAPI_REGISTRY_PASSWD_FILE:-/etc/vmapi-registry.htpasswd}
PEER_PASSWD=${VMAPI_PEER_PASSWD_FILE:-/etc/vmapi-peer.htpasswd}
PORT=${VMAPI_REGISTRY_LOOPBACK_PORT:-5000}
IMAGE=${VMAPI_REGISTRY_IMAGE:-registry:3}
CONTAINER=${VMAPI_REGISTRY_CONTAINER:-litevmm-registry}
LIGHTTPD_ROOT=${VMAPI_LIGHTTPD_ROOT:-/etc/lighttpd}
NGINX_CONF=${VMAPI_NGINX_REGISTRY_CONF:-/etc/nginx/vmapi-registry.conf}
WEB_MODE=${VMAPI_REGISTRY_WEB_MODE:-auto}

valid_user(){ [[ ${1:-} =~ ^[A-Za-z0-9._-]{1,64}$ ]] || die 'Invalid registry username'; }
valid_ref(){ local v=${1:-}; [[ -n $v && ${#v} -le 512 && $v != *[[:space:]]* && $v != /* && $v != *://* ]] || die "Invalid registry image reference: $v"; validate_no_newline "$v"; }
web_mode(){ [[ $WEB_MODE != auto ]] && { printf '%s\n' "$WEB_MODE"; return; }; if command -v lighttpd >/dev/null 2>&1 && [[ -d $LIGHTTPD_ROOT ]]; then echo lighttpd; elif command -v nginx >/dev/null 2>&1; then echo nginx; else echo none; fi; }
load(){ ENABLED=false USERNAME='' PASSWORD=''; if [[ -r $CONF ]]; then source "$CONF"; fi; }
write_conf(){ local tmp; tmp=$(mktemp "${CONF}.XXXXXX"); printf 'ENABLED=%q\nUSERNAME=%q\nPASSWORD=%q\n' "$ENABLED" "$USERNAME" "$PASSWORD" > "$tmp"; chmod 0600 "$tmp"; mv "$tmp" "$CONF"; }
container_running(){ "$DOCKER_BIN" inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -Fxq true; }
render_web(){
  local mode; mode=$(web_mode); [[ $mode != none ]] || return 0
  load
  case $mode in
    lighttpd)
      # lighttpd's mod_proxy forwards the client Host header and adds X-Forwarded-For/Proto by
      # default, so no proxy.header entry is needed (and "host" is not a valid proxy.header key).
      # Stream bodies so multi-GB layer pushes/pulls are not spooled to disk before proxying.
      install -d -m 0755 "$LIGHTTPD_ROOT/conf.d"; local f="$LIGHTTPD_ROOT/conf.d/zz-vmapi-registry.conf" prev errf
      prev=$(mktemp); errf=$(mktemp); if [[ -e $f ]]; then cp -p "$f" "$prev"; fi
      : > "$f"
      if [[ $ENABLED == true ]]; then cat > "$f" <<CFG
\$HTTP["url"] =~ "^/v2(?:/|\$)" {
  auth.backend = "htpasswd"
  auth.backend.htpasswd.userfile = "$PASSWD_FILE"
  auth.require = ( "" => ( "method" => "basic", "realm" => "LiteVMM registry", "require" => "valid-user" ) )
  proxy.server = ( "" => (( "host" => "127.0.0.1", "port" => $PORT )) )
  server.stream-request-body = 2
  server.stream-response-body = 2
}
CFG
      fi
      if [[ ${VMAPI_REGISTRY_SKIP_RELOAD:-false} != true ]]; then
        # Validate before reloading; never leave a config in conf.d that would stop lighttpd from starting.
        if ! lighttpd -tt -f "$LIGHTTPD_ROOT/lighttpd.conf" >/dev/null 2>"$errf"; then
          cat "$prev" > "$f"; err "lighttpd rejected the registry proxy configuration: $(tr '\n' ' ' < "$errf")"; rm -f "$prev" "$errf"; return 1
        fi
        if [[ -x ${VMAPI_WEB_RELOAD:-/usr/local/bin/vmapi-web-reload} ]]; then VMAPI_LIGHTTPD_CONF="$LIGHTTPD_ROOT/lighttpd.conf" "${VMAPI_WEB_RELOAD:-/usr/local/bin/vmapi-web-reload}"; elif command -v rc-service >/dev/null 2>&1; then rc-service lighttpd restart >/dev/null; elif [[ -r /run/lighttpd.pid ]]; then kill -USR1 "$(cat /run/lighttpd.pid)"; fi
      fi
      rm -f "$prev" "$errf";;
    nginx)
      : > "$NGINX_CONF"
      if [[ $ENABLED == true ]]; then cat > "$NGINX_CONF" <<CFG
location /v2/ {
    auth_basic "LiteVMM registry";
    auth_basic_user_file $PASSWD_FILE;
    proxy_pass http://127.0.0.1:$PORT;
    proxy_set_header Host \$http_host;
    proxy_set_header X-Forwarded-Proto \$scheme;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_request_buffering off;
    proxy_buffering off;
}
CFG
      fi
      [[ ${VMAPI_REGISTRY_SKIP_RELOAD:-false} == true ]] || { nginx -t >/dev/null; systemctl reload nginx; };;
  esac
}
enable(){
  need_cmd "$DOCKER_BIN"; need_cmd openssl; local user=${1:-registry}; valid_user "$user"; install -d -m 0750 "$ROOT"
  # Never re-mode an existing config directory: CONF lives in /etc/vmapi, and
  # `install -d -m 0750` on it locked the vmapi web worker out of vmapi.conf,
  # silently dropping settings such as VMAPI_BACKPLANE_SERVER (see peerctl).
  [[ -d $(dirname "$CONF") ]] || install -d -m 0755 "$(dirname "$CONF")"
  load; USERNAME=$user; [[ -n $PASSWORD ]] || PASSWORD=$(openssl rand -hex 24); ENABLED=true
  local hash; hash=$(printf '%s\n' "$PASSWORD" | openssl passwd -apr1 -stdin); printf '%s:%s\n' "$USERNAME" "$hash" > "$PASSWD_FILE"; chmod 0640 "$PASSWD_FILE"; [[ ! -e $PEER_PASSWD ]] || chown --reference="$PEER_PASSWD" "$PASSWD_FILE" 2>/dev/null || true
  "$DOCKER_BIN" image inspect "$IMAGE" >/dev/null 2>&1 || "$DOCKER_BIN" pull "$IMAGE" >/dev/null
  if "$DOCKER_BIN" container inspect "$CONTAINER" >/dev/null 2>&1; then "$DOCKER_BIN" rm -f "$CONTAINER" >/dev/null; fi
  "$DOCKER_BIN" run -d --restart unless-stopped --name "$CONTAINER" -p "127.0.0.1:$PORT:5000" -v "$ROOT:/var/lib/registry" "$IMAGE" >/dev/null
  write_conf
  if ! render_web; then
    ENABLED=false; write_conf; "$DOCKER_BIN" rm -f "$CONTAINER" >/dev/null 2>&1 || true
    die 'Registry was not enabled because the web server configuration could not be applied'
  fi
  status
}
disable(){ load; ENABLED=false; write_conf; "$DOCKER_BIN" rm -f "$CONTAINER" >/dev/null 2>&1 || true; render_web; status; }
status(){ load; local running=false; container_running && running=true; printf '{"enabled":%s,"running":%s,"username":"%s","image":"%s","loopback_port":%s,"path":"/v2/"}\n' "$ENABLED" "$running" "$(json_escape "$USERNAME")" "$(json_escape "$IMAGE")" "$PORT"; }
credentials(){ load; [[ $ENABLED == true && -n $USERNAME && -n $PASSWORD ]] || die 'Registry is not enabled'; printf '{"username":"%s","password":"%s","path":"/v2/"}\n' "$(json_escape "$USERNAME")" "$(json_escape "$PASSWORD")"; }
push(){ load; [[ $ENABLED == true ]] || die 'Registry is not enabled'; container_running || die 'Registry container is not running'; local src=${1:?source image required} dst=${2:?repository/tag required}; valid_ref "$src"; valid_ref "$dst"; local localref="127.0.0.1:$PORT/$dst"; "$DOCKER_BIN" image tag "$src" "$localref"; "$DOCKER_BIN" image push "$localref"; printf '{"published":true,"source":"%s","repository":"%s"}\n' "$(json_escape "$src")" "$(json_escape "$dst")"; }
catalog(){ load; [[ $ENABLED == true ]] || die 'Registry is not enabled'; curl --fail --silent "http://127.0.0.1:$PORT/v2/_catalog"; printf '\n'; }
case ${1:-status} in
  enable) shift; enable "$@";; disable) disable;; status) status;; credentials) credentials;; push) shift; push "$@";; catalog) catalog;; render-web) render_web;;
  *) die 'Usage: registryctl status | enable [USERNAME] | disable | credentials | push SOURCE REPOSITORY[:TAG] | catalog | render-web';;
esac
