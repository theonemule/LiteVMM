#!/usr/bin/env bash
# Purpose: VMAPI privileged command-line component.
# Called by the CGI API or service units; environment variables may override paths for tests.
# Validate externally supplied values before passing them to host virtualization or container tools.
set -Eeuo pipefail

LIB=${VMAPI_LIB:-/usr/local/lib/vmapi/common.sh}
[[ -r "$LIB" ]] || LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)/common.sh"
# shellcheck source=/dev/null
source "$LIB"

PEER_ROOT=${VMAPI_PEER_ROOT:-/var/lib/vmapi/peers}
LEGACY_PEER_ROOT=/etc/vmapi/peers
IDENTITY_ROOT=${VMAPI_IDENTITY_ROOT:-/etc/vmapi/identity}
NODE_ID_FILE=${VMAPI_NODE_ID_FILE:-/etc/vmapi/node-id}
HTPASSWD=${VMAPI_PEER_PASSWD_FILE:-/etc/vmapi-peer.htpasswd}
OVERLAYCTL=${VMAPI_OVERLAYCTL:-/usr/local/bin/overlayctl}
REPLICATIONCTL=${VMAPI_REPLICATIONCTL:-/usr/local/bin/replicationctl}
PEER_VOLUMECTL=${VMAPI_PEER_VOLUMECTL:-/usr/local/bin/peer-volumectl}
BACKPLANECTL=${VMAPI_BACKPLANECTL:-/usr/local/bin/backplanectl}
PAIR_TTL=${VMAPI_PAIR_TTL:-900}
BACKUPCTL=${VMAPI_BACKUPCTL:-/usr/local/bin/vmbackupctl}
VMCTL=${VMAPI_VMCTL:-/usr/local/bin/vmctl}
OPENSSL_BIN=${OPENSSL_BIN:-openssl}
CURL_BIN=${CURL_BIN:-curl}

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
valid_id() { [[ ${1:-} =~ ^[A-Fa-f0-9]{32}$ ]] || die 'Invalid node id'; }
valid_name() { [[ ${1:-} =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die 'Invalid peer name'; }
valid_relay_user() { [[ ${1:-} =~ ^[A-Za-z0-9._-]{1,64}$ ]] || die 'Invalid relay username'; }
valid_relay_password() { [[ ${1:-} =~ ^[A-Fa-f0-9]{48,128}$ ]] || die 'Invalid relay credential'; }
now() { date +%s; }
random_hex() { local bytes=${1:-16}; od -An -N"$bytes" -tx1 /dev/urandom | tr -d ' \n'; }
peer_file() { printf '%s/%s.conf\n' "$PEER_ROOT" "$1"; }
peer_public_file() { printf '%s/%s.pub\n' "$PEER_ROOT" "$1"; }
identity_private_file() { printf '%s/ed25519.pem\n' "$IDENTITY_ROOT"; }
identity_public_file() { printf '%s/ed25519.pub\n' "$IDENTITY_ROOT"; }

ensure_peer_root() {
  local source target
  install -d -m 0700 "$PEER_ROOT"
  # Pairing state is durable host configuration, not web-server configuration.
  # Preserve existing installations when moving the state from the original
  # /etc location to the VMAPI data directory.
  [[ $PEER_ROOT == /var/lib/vmapi/peers && -d $LEGACY_PEER_ROOT && ! -e $PEER_ROOT/.legacy-migrated ]] || return 0
  shopt -s nullglob
  for source in "$LEGACY_PEER_ROOT"/*.conf "$LEGACY_PEER_ROOT"/*.pub "$LEGACY_PEER_ROOT"/.pending; do
    [[ -e $source ]] || continue
    target="$PEER_ROOT/${source##*/}"
    [[ -e $target ]] || cp -p -- "$source" "$target"
  done
  shopt -u nullglob
  touch "$PEER_ROOT/.legacy-migrated"
}

node_id() {
  install -d -m 0700 "$(dirname "$NODE_ID_FILE")"
  if [[ ! -s $NODE_ID_FILE ]]; then random_hex > "$NODE_ID_FILE"; chmod 0600 "$NODE_ID_FILE"; fi
  local id; id=$(cat "$NODE_ID_FILE"); valid_id "$id"; printf '%s' "${id,,}"
}

node_name() {
  local name
  name=$(hostname -s 2>/dev/null || hostname 2>/dev/null || true)
  if ! valid_name "$name" 2>/dev/null; then printf 'node-%s' "$(node_id | cut -c1-8)"; else printf '%s' "$name"; fi
}

ensure_identity() {
  local private public tmp
  command -v "$OPENSSL_BIN" >/dev/null 2>&1 || die 'OpenSSL is required for peer identity keys'
  install -d -m 0700 "$IDENTITY_ROOT"
  private=$(identity_private_file); public=$(identity_public_file)
  if [[ ! -s $private ]]; then
    tmp=$(mktemp "$IDENTITY_ROOT/.ed25519.XXXXXX")
    "$OPENSSL_BIN" genpkey -algorithm ED25519 -out "$tmp" || { rm -f -- "$tmp"; die 'Unable to create an Ed25519 identity key'; }
    chmod 0600 "$tmp"; mv -f "$tmp" "$private"
  fi
  "$OPENSSL_BIN" pkey -in "$private" -noout >/dev/null 2>&1 || die 'The local peer identity key is invalid'
  if [[ ! -s $public ]]; then
    tmp=$(mktemp "$IDENTITY_ROOT/.ed25519.pub.XXXXXX")
    "$OPENSSL_BIN" pkey -in "$private" -pubout -out "$tmp" || { rm -f -- "$tmp"; die 'Unable to export the peer public key'; }
    chmod 0644 "$tmp"; mv -f "$tmp" "$public"
  fi
  "$OPENSSL_BIN" pkey -pubin -in "$public" -noout >/dev/null 2>&1 || die 'The local peer public key is invalid'
}

key_fingerprint() { "$OPENSSL_BIN" pkey -pubin -in "$1" -pubout -outform DER 2>/dev/null | sha256sum | awk '{print $1}'; }
encode_text() { printf '%s' "$1" | base64 | tr -d '\n'; }
decode_text() { printf '%s' "$1" | base64 -d 2>/dev/null || die 'Invalid pairing bundle encoding'; }
field() { printf '%s\n' "$1" | awk -F= -v k="$2" '$1==k {sub(/^[^=]*=/, ""); print; exit}'; }
json_field() { printf '%s\n' "$1" | sed -nE "s/.*\"$2\":\"([^\"]*)\".*/\1/p" | head -n1; }
public_key_b64() { encode_text "$(cat "$(identity_public_file)")"; }

write_public_key() {
  local encoded=${1:?public key required} target=${2:?target required} tmp
  tmp=$(mktemp "$(dirname "$target")/.peer-public.XXXXXX")
  decode_text "$encoded" > "$tmp"
  "$OPENSSL_BIN" pkey -pubin -in "$tmp" -noout >/dev/null 2>&1 || { rm -f -- "$tmp"; die 'Invalid peer public key'; }
  chmod 0644 "$tmp"; mv -f "$tmp" "$target"
}

sign_text() {
  local key=${1:?private key required} text=${2-} input sig
  input=$(mktemp); sig=$(mktemp)
  printf '%s' "$text" > "$input"
  "$OPENSSL_BIN" pkeyutl -sign -inkey "$key" -rawin -in "$input" -out "$sig" 2>/dev/null || { rm -f -- "$input" "$sig"; die 'Unable to sign peer credential'; }
  base64 < "$sig" | tr -d '\n'
  rm -f -- "$input" "$sig"
}

verify_text() {
  local key=${1:?public key required} text=${2-} signature=${3:?signature required} input sig
  input=$(mktemp); sig=$(mktemp)
  printf '%s' "$text" > "$input"
  if ! printf '%s' "$signature" | base64 -d > "$sig" 2>/dev/null || ! "$OPENSSL_BIN" pkeyutl -verify -pubin -inkey "$key" -rawin -in "$input" -sigfile "$sig" >/dev/null 2>&1; then
    rm -f -- "$input" "$sig"; return 1
  fi
  rm -f -- "$input" "$sig"
}

request_payload() {
  local name=$1 id=$2 public_key=$3 fingerprint=$4 relay_user=$5 relay_password=$6 token=$7 expires=$8 endpoint=$9
  printf 'VMAPI-PAIR-REQUEST-3\nNODE_NAME=%s\nNODE_ID=%s\nPUBLIC_KEY=%s\nPUBLIC_FINGERPRINT=%s\nRELAY_USER=%s\nRELAY_PASSWORD=%s\nPAIR_TOKEN=%s\nEXPIRES=%s\nAPI_ENDPOINT=%s' "$name" "$id" "$public_key" "$fingerprint" "$relay_user" "$relay_password" "$token" "$expires" "$endpoint"
}

response_payload() {
  local name=$1 id=$2 public_key=$3 fingerprint=$4 token=$5 expires=$6 endpoint=$7
  printf 'VMAPI-PAIR-RESPONSE-3\nNODE_NAME=%s\nNODE_ID=%s\nPUBLIC_KEY=%s\nPUBLIC_FINGERPRINT=%s\nPAIR_TOKEN=%s\nEXPIRES=%s\nAPI_ENDPOINT=%s' "$name" "$id" "$public_key" "$fingerprint" "$token" "$expires" "$endpoint"
}

write_pending() {
  local name=$1 id=$2 relay_user=$3 relay_password=$4 token=$5 expires=$6 endpoint=$7 tmp
  install -d -m 0700 "$PEER_ROOT"
  tmp=$(mktemp "$PEER_ROOT/.pending.XXXXXX")
  {
    printf 'NAME=%q\n' "$name"; printf 'NODE_ID=%q\n' "$id"; printf 'RELAY_USER=%q\n' "$relay_user"; printf 'RELAY_PASSWORD=%q\n' "$relay_password"; printf 'PAIR_TOKEN=%q\n' "$token"; printf 'EXPIRES=%q\n' "$expires"; printf 'ENDPOINT=%q\n' "$endpoint"
  } > "$tmp"
  chmod 0600 "$tmp"; mv -f "$tmp" "$PEER_ROOT/.pending"
}

write_peer() {
  local id=$1 name=$2 public_key=$3 relay_user=$4 relay_password=$5 url=${6-} tmp
  valid_id "$id"; valid_name "$name"; valid_relay_user "$relay_user"; valid_relay_password "$relay_password"
  local other RELAY_USER='' RELAY_PASSWORD=''
  for other in "$PEER_ROOT"/*.conf; do
    [[ -f $other && $other != "$(peer_file "$id")" ]] || continue
    # shellcheck source=/dev/null
    source "$other"
    [[ $RELAY_USER != "$relay_user" ]] || die 'Pairing credential already belongs to another peer; export a new request'
  done
  install -d -m 0700 "$PEER_ROOT"
  write_public_key "$public_key" "$(peer_public_file "$id")"
  tmp=$(mktemp "$PEER_ROOT/.${id}.XXXXXX")
  {
    printf 'NAME=%q\n' "$name"; printf 'NODE_ID=%q\n' "${id,,}"; printf 'PUBLIC_KEY_FILE=%q\n' "$(peer_public_file "$id")"; printf 'PUBLIC_FINGERPRINT=%q\n' "$(key_fingerprint "$(peer_public_file "$id")")"; printf 'RELAY_USER=%q\n' "$relay_user"; printf 'RELAY_PASSWORD=%q\n' "$relay_password"; printf 'URL=%q\n' "$url"; printf 'TRUSTED_AT=%q\n' "$(now)"
  } > "$tmp"
  chmod 0600 "$tmp"; mv -f "$tmp" "$(peer_file "$id")"
  cmd_sync_auth
}

# One credential database for the peer API and hub WebSocket routes. No
# Lighttpd executable/service is needed on a client-only installation.
cmd_sync_auth() (
  local file user password hash tmp group=${VMAPI_PEER_AUTH_GROUP:-root}
  declare -A seen=()
  if [[ -z ${VMAPI_PEER_AUTH_GROUP:-} ]]; then
    if getent group lighttpd >/dev/null; then group=lighttpd
    elif getent group www-data >/dev/null; then group=www-data; fi
  fi
  install -d -m 0755 "$(dirname "$HTPASSWD")"
  tmp=$(mktemp "${HTPASSWD}.XXXXXX")
  trap 'rm -f -- "$tmp"' EXIT
  for file in "$PEER_ROOT"/*.conf; do
    [[ -f $file ]] || continue
    RELAY_USER=''; RELAY_PASSWORD=''
    # shellcheck source=/dev/null
    source "$file"
    user=$RELAY_USER; password=$RELAY_PASSWORD
    valid_relay_user "$user"; valid_relay_password "$password"
    [[ -z ${seen[$user]+x} ]] || die 'Duplicate peer username; revoke and re-pair these peers'
    seen[$user]=1
    hash=$(printf '%s\n' "$password" | "$OPENSSL_BIN" passwd -apr1 -stdin)
    printf '%s:%s\n' "$user" "$hash" >> "$tmp"
  done
  chown "root:$group" "$tmp"; chmod 0640 "$tmp"
  mv -f -- "$tmp" "$HTPASSWD"
)

# REMOTE_USER comes from the web server's Basic authentication result, never
# from a client-supplied X-* header. Recheck trust so revocation takes effect.
cmd_authorize_user() {
  local user=${1:-} file RELAY_USER=''
  valid_relay_user "$user"
  for file in "$PEER_ROOT"/*.conf; do
    [[ -f $file ]] || continue
    RELAY_USER=''
    # shellcheck source=/dev/null
    source "$file"
    [[ $RELAY_USER == "$user" ]] && return 0
  done
  die 'HTTP user is not a paired peer'
}

load_peer() {
  local id=${1:?node id required} NAME='' NODE_ID='' PUBLIC_KEY_FILE='' RELAY_USER='' RELAY_PASSWORD='' URL=''
  valid_id "$id"; [[ -r $(peer_file "$id") ]] || die 'Peer not found'
  # Peer configuration files are written only by this root-owned program.
  # shellcheck source=/dev/null
  source "$(peer_file "$id")"
  PEER_NODE_ID=${NODE_ID,,}; PEER_PUBLIC_KEY_FILE=$PUBLIC_KEY_FILE; PEER_RELAY_USER=$RELAY_USER; PEER_RELAY_PASSWORD=$RELAY_PASSWORD; PEER_URL=$URL
  valid_id "$PEER_NODE_ID"; [[ -r $PEER_PUBLIC_KEY_FILE ]] || die 'Peer public key is missing'; valid_relay_user "$PEER_RELAY_USER"; valid_relay_password "$PEER_RELAY_PASSWORD"
}

valid_url() { [[ ${1:-} =~ ^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[^[:space:]?#]*)?$ ]] || die 'Peer endpoint must be an HTTP(S) base URL'; }
normalized_peer_url() { local url=${1%/}; url=${url%/api}; url=${url%/peer-api}; printf '%s' "$url"; }
url_origin() { printf '%s\n' "$1" | sed -nE 's#^(https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?).*$#\1#p'; }
valid_proxy_path() { local path=${1:-}; [[ $path == /* && $path != //* && $path != *$'\r'* && $path != *$'\n'* && $path != *'..'* ]] || die 'Invalid peer API path'; [[ $path != /peer-api* && $path != /api* ]] || die 'Peer API path must be relative to the API root'; }
peer_api_path() { printf '/peer-api%s' "$1"; }

cmd_identity() {
  local id fingerprint
  ensure_identity; id=$(node_id); fingerprint=$(key_fingerprint "$(identity_public_file)")
  printf '{"node_id":"%s","name":"%s","key_algorithm":"ed25519","public_key_fingerprint":"%s"}\n' "$id" "$(json_escape "$(node_name)")" "$fingerprint"
}

cmd_request() {
  local requested_name=${1-} requested_endpoint=${2-} name endpoint id public_key fingerprint relay_user relay_password token expires payload signature pending_id pending_name pending_relay_user pending_relay_password pending_token pending_expires pending_endpoint
  ensure_identity; id=$(node_id); public_key=$(public_key_b64); fingerprint=$(key_fingerprint "$(identity_public_file)")

  # A pairing response is bound to this request's token and expiration.  Export is
  # intentionally idempotent while a valid request is pending: a second click in
  # the UI must not invalidate the bundle that was already taken to the other host.
  if [[ -r $PEER_ROOT/.pending ]]; then
    NAME=''; NODE_ID=''; RELAY_USER=''; RELAY_PASSWORD=''; PAIR_TOKEN=''; EXPIRES=''; ENDPOINT=''
    source "$PEER_ROOT/.pending"
    pending_name=$NAME; pending_id=${NODE_ID,,}; pending_relay_user=$RELAY_USER; pending_relay_password=$RELAY_PASSWORD; pending_token=$PAIR_TOKEN; pending_expires=$EXPIRES; pending_endpoint=$ENDPOINT
    if [[ $pending_id == "$id" && $pending_name =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ && $pending_relay_user =~ ^[A-Za-z0-9._-]{1,64}$ && $pending_relay_password =~ ^[A-Fa-f0-9]{48,128}$ && $pending_token =~ ^[A-Fa-f0-9]{32}$ && $pending_expires =~ ^[0-9]{10}$ && $pending_expires -ge $(now) && -n $pending_endpoint ]]; then
      valid_url "$pending_endpoint"
      payload=$(request_payload "$pending_name" "$id" "$public_key" "$fingerprint" "$pending_relay_user" "$pending_relay_password" "$pending_token" "$pending_expires" "$pending_endpoint")
      signature=$(sign_text "$(identity_private_file)" "$payload")
      encode_text "${payload}"$'\n'"SIGNATURE=${signature}"; printf '\n'
      return
    fi
    rm -f -- "$PEER_ROOT/.pending"
  fi

  name=${requested_name:-$(node_name)}; endpoint=$(normalized_peer_url "${requested_endpoint:?local API endpoint required}"); valid_name "$name"; valid_url "$endpoint"
  relay_user="relay_$(random_hex 16)"; relay_password=$(random_hex 32); token=$(random_hex 16); expires=$(( $(now) + PAIR_TTL ))
  write_pending "$name" "$id" "$relay_user" "$relay_password" "$token" "$expires" "$endpoint"
  payload=$(request_payload "$name" "$id" "$public_key" "$fingerprint" "$relay_user" "$relay_password" "$token" "$expires" "$endpoint")
  signature=$(sign_text "$(identity_private_file)" "$payload")
  encode_text "${payload}"$'\n'"SIGNATURE=${signature}"; printf '\n'
}

cmd_pending() {
  local id public_key fingerprint pending_id pending_name pending_relay_user pending_relay_password pending_token pending_expires pending_endpoint payload signature
  ensure_identity; [[ -r $PEER_ROOT/.pending ]] || die 'No pending pairing request'
  id=$(node_id); public_key=$(public_key_b64); fingerprint=$(key_fingerprint "$(identity_public_file)")
  NAME=''; NODE_ID=''; RELAY_USER=''; RELAY_PASSWORD=''; PAIR_TOKEN=''; EXPIRES=''; ENDPOINT=''
  source "$PEER_ROOT/.pending"
  pending_name=$NAME; pending_id=${NODE_ID,,}; pending_relay_user=$RELAY_USER; pending_relay_password=$RELAY_PASSWORD; pending_token=$PAIR_TOKEN; pending_expires=$EXPIRES; pending_endpoint=$ENDPOINT
  [[ $pending_id == "$id" && $pending_name =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ && $pending_relay_user =~ ^[A-Za-z0-9._-]{1,64}$ && $pending_relay_password =~ ^[A-Fa-f0-9]{48,128}$ && $pending_token =~ ^[A-Fa-f0-9]{32}$ && $pending_expires =~ ^[0-9]{10}$ && $pending_expires -ge $(now) && -n $pending_endpoint ]] || die 'The pending pairing request is incomplete; revoke it and export a new request with an API endpoint'
  valid_url "$pending_endpoint"
  payload=$(request_payload "$pending_name" "$id" "$public_key" "$fingerprint" "$pending_relay_user" "$pending_relay_password" "$pending_token" "$pending_expires" "$pending_endpoint")
  signature=$(sign_text "$(identity_private_file)" "$payload")
  encode_text "${payload}"$'\n'"SIGNATURE=${signature}"; printf '\n'
}

cmd_cancel_pending() {
  [[ -e $PEER_ROOT/.pending ]] || die 'No pending pairing request'
  rm -f -- "$PEER_ROOT/.pending"
  printf '{"revoked":true}\n'
}

cmd_accept() {
  local bundle=${1:?request bundle required} requested_name=${2-} requested_endpoint=${3-} data name id public_key fingerprint relay_user relay_password token expires endpoint signature payload incoming_public myid myname myendpoint mypublic myfingerprint response response_signature
  ensure_identity; data=$(decode_text "$bundle")
  [[ ${data%%$'\n'*} == VMAPI-PAIR-REQUEST-3 ]] || die 'Unsupported pairing request; export a new request that includes an API endpoint'
  name=$(field "$data" NODE_NAME); id=$(field "$data" NODE_ID); public_key=$(field "$data" PUBLIC_KEY); fingerprint=$(field "$data" PUBLIC_FINGERPRINT); relay_user=$(field "$data" RELAY_USER); relay_password=$(field "$data" RELAY_PASSWORD); token=$(field "$data" PAIR_TOKEN); expires=$(field "$data" EXPIRES); endpoint=$(normalized_peer_url "$(field "$data" API_ENDPOINT)"); signature=$(field "$data" SIGNATURE)
  valid_name "$name"; valid_id "$id"; valid_relay_user "$relay_user"; valid_relay_password "$relay_password"; valid_url "$endpoint"
  [[ $fingerprint =~ ^[A-Fa-f0-9]{64}$ && $token =~ ^[A-Fa-f0-9]{32}$ && $expires =~ ^[0-9]{10}$ && $expires -ge $(now) && $expires -le $(( $(now) + PAIR_TTL + 60 )) ]] || die 'Invalid or expired pairing request'
  incoming_public=$(mktemp); write_public_key "$public_key" "$incoming_public"
  [[ $(key_fingerprint "$incoming_public") == "${fingerprint,,}" ]] || { rm -f -- "$incoming_public"; die 'Pairing request public-key fingerprint mismatch'; }
  payload=$(request_payload "$name" "$id" "$public_key" "$fingerprint" "$relay_user" "$relay_password" "$token" "$expires" "$endpoint")
  verify_text "$incoming_public" "$payload" "$signature" || { rm -f -- "$incoming_public"; die 'Pairing request signature is invalid'; }
  rm -f -- "$incoming_public"; myid=$(node_id); [[ ${id,,} != "$myid" ]] || die 'A node cannot pair with itself'; [[ ! -e $(peer_file "$id") ]] || die 'Peer already exists; revoke it before pairing again'
  write_peer "$id" "$name" "$public_key" "$relay_user" "$relay_password" "$endpoint"
  myname=${requested_name:-$(node_name)}; myendpoint=$(normalized_peer_url "${requested_endpoint:?local API endpoint required}"); valid_name "$myname"; valid_url "$myendpoint"; mypublic=$(public_key_b64); myfingerprint=$(key_fingerprint "$(identity_public_file)")
  response=$(response_payload "$myname" "$myid" "$mypublic" "$myfingerprint" "$token" "$expires" "$myendpoint"); response_signature=$(sign_text "$(identity_private_file)" "$response")
  encode_text "${response}"$'\n'"SIGNATURE=${response_signature}"; printf '\n'
}

cmd_complete() {
  local bundle=${1:?response bundle required} data pending_name pending_id pending_relay_user pending_relay_password pending_token pending_expires name id public_key fingerprint token expires endpoint signature payload incoming_public
  [[ -r $PEER_ROOT/.pending ]] || die 'No pending pairing request'
  source "$PEER_ROOT/.pending"; pending_name=$NAME; pending_id=$NODE_ID; pending_relay_user=$RELAY_USER; pending_relay_password=$RELAY_PASSWORD; pending_token=$PAIR_TOKEN; pending_expires=$EXPIRES
  [[ $pending_expires =~ ^[0-9]{10}$ && $pending_expires -ge $(now) ]] || die 'The pending pairing request expired; create a new one'
  data=$(decode_text "$bundle"); [[ ${data%%$'\n'*} == VMAPI-PAIR-RESPONSE-3 ]] || die 'Unsupported pairing response; create a new request bundle'
  name=$(field "$data" NODE_NAME); id=$(field "$data" NODE_ID); public_key=$(field "$data" PUBLIC_KEY); fingerprint=$(field "$data" PUBLIC_FINGERPRINT); token=$(field "$data" PAIR_TOKEN); expires=$(field "$data" EXPIRES); endpoint=$(normalized_peer_url "$(field "$data" API_ENDPOINT)"); signature=$(field "$data" SIGNATURE)
  valid_name "$name"; valid_id "$id"; valid_url "$endpoint"; [[ $fingerprint =~ ^[A-Fa-f0-9]{64}$ && $token == "$pending_token" && $expires == "$pending_expires" ]] || die 'Pairing response does not match the pending request'; [[ ${id,,} != "${pending_id,,}" ]] || die 'A node cannot pair with itself'; [[ ! -e $(peer_file "$id") ]] || die 'Peer already exists; revoke it before pairing again'
  incoming_public=$(mktemp); write_public_key "$public_key" "$incoming_public"
  [[ $(key_fingerprint "$incoming_public") == "${fingerprint,,}" ]] || { rm -f -- "$incoming_public"; die 'Pairing response public-key fingerprint mismatch'; }
  payload=$(response_payload "$name" "$id" "$public_key" "$fingerprint" "$token" "$expires" "$endpoint")
  verify_text "$incoming_public" "$payload" "$signature" || { rm -f -- "$incoming_public"; die 'Pairing response signature is invalid'; }
  rm -f -- "$incoming_public"; write_peer "$id" "$name" "$public_key" "$pending_relay_user" "$pending_relay_password" "$endpoint"; rm -f -- "$PEER_ROOT/.pending"
  printf '{"trusted":true,"node_id":"%s","name":"%s","api_auth":"basic","public_key_fingerprint":"%s"}\n' "${id,,}" "$(json_escape "$name")" "${fingerprint,,}"
}

cmd_list() {
  local file NAME NODE_ID URL PUBLIC_KEY_FILE RELAY_USER RELAY_PASSWORD PUBLIC_FINGERPRINT api_auth relay_configured first=true
  install -d -m 0700 "$PEER_ROOT"; printf '['; shopt -s nullglob
  for file in "$PEER_ROOT"/*.conf; do
    NAME=''; NODE_ID=''; URL=''; PUBLIC_KEY_FILE=''; RELAY_USER=''; RELAY_PASSWORD=''; PUBLIC_FINGERPRINT=''
    # shellcheck source=/dev/null
    source "$file"; [[ -n $NODE_ID ]] || continue
    api_auth=basic; [[ -r $PUBLIC_KEY_FILE && -n $PUBLIC_FINGERPRINT ]] || api_auth=re-pair-required
    relay_configured=false; [[ $api_auth == basic && -n $RELAY_USER && -n $RELAY_PASSWORD ]] && relay_configured=true
    $first || printf ','; first=false
    printf '{"node_id":"%s","name":"%s","url":"%s","api_auth":"%s","public_key_fingerprint":"%s","relay_configured":%s}' "$(json_escape "$NODE_ID")" "$(json_escape "$NAME")" "$(json_escape "$URL")" "$api_auth" "$(json_escape "$PUBLIC_FINGERPRINT")" "$relay_configured"
  done
  shopt -u nullglob; printf ']\n'
}

cmd_set_url() { local id=${1:?node id required} url=${2:?peer URL required} file; valid_id "$id"; valid_url "$url"; file=$(peer_file "$id"); [[ -f $file ]] || die 'Peer not found'; cfg_set_file "$file" URL "$(normalized_peer_url "$url")"; }
cmd_overlay_credentials() { local id=${1:?node id required}; load_peer "$id"; printf '{"node_id":"%s","username":"%s","password":"%s"}\n' "$(json_escape "$PEER_NODE_ID")" "$(json_escape "$PEER_RELAY_USER")" "$(json_escape "$PEER_RELAY_PASSWORD")"; }
cmd_transport_profile() {
  local id=${1:?node id required} scheme endpoint
  load_peer "$id"
  [[ -n $PEER_URL ]] || die 'Peer has no API endpoint; set its endpoint first'
  [[ -n $PEER_RELAY_USER && -n $PEER_RELAY_PASSWORD ]] || die 'Peer has no transport credential; re-pair this host'
  case "$PEER_URL" in
    https://*) scheme=wss;;
    http://*) scheme=ws;;
    *) die 'Peer API endpoint uses an unsupported scheme';;
  esac
  endpoint="${scheme}://$(url_origin "$PEER_URL" | cut -d/ -f3)"
  printf '{"node_id":"%s","endpoint":"%s","username":"%s","password":"%s"}\n'     "$(json_escape "$PEER_NODE_ID")" "$(json_escape "$endpoint")" "$(json_escape "$PEER_RELAY_USER")" "$(json_escape "$PEER_RELAY_PASSWORD")"
}

cmd_overlay_profile() {
  local id=${1:?node id required} scheme endpoint
  load_peer "$id"
  [[ -n $PEER_URL ]] || die 'Peer has no API endpoint; set its endpoint before configuring an overlay'
  [[ -n $PEER_RELAY_USER && -n $PEER_RELAY_PASSWORD ]] || die 'Peer has no relay credential; re-pair this host'
  case "$PEER_URL" in
    https://*) scheme=wss;;
    http://*) scheme=ws;;
    *) die 'Peer API endpoint uses an unsupported scheme';;
  esac
  endpoint="${scheme}://$(url_origin "$PEER_URL" | cut -d/ -f3)/overlay"
  printf '{"node_id":"%s","endpoint":"%s","username":"%s","password":"%s"}\n' \
    "$(json_escape "$PEER_NODE_ID")" "$(json_escape "$endpoint")" "$(json_escape "$PEER_RELAY_USER")" "$(json_escape "$PEER_RELAY_PASSWORD")"
}

cmd_cors_origin() {
  local origin=${1:?origin required} file URL='' allowed=''
  [[ $origin =~ ^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?$ ]] || exit 1; shopt -s nullglob
  for file in "$PEER_ROOT"/*.conf; do URL=''
    # shellcheck source=/dev/null
    source "$file"; [[ -n $URL && $(url_origin "$URL") == "$origin" ]] && { allowed=$origin; break; }; done
  shopt -u nullglob; [[ -n $allowed ]] || exit 1; printf '%s\n' "$allowed"
}

cmd_proxy() {
  local id=${1:?node id required} method=${2:?method required} path=${3:?path required} content_type=${4-} remote_path target_url
  [[ $method =~ ^(GET|POST|PUT|PATCH|DELETE|HEAD)$ ]] || die 'Invalid peer request method'; valid_proxy_path "$path"; load_peer "$id"; [[ -n $PEER_URL ]] || die 'Peer has no API URL; set its endpoint first'; [[ -z $content_type || ($content_type != *$'\r'* && $content_type != *$'\n'* && ${#content_type} -le 256) ]] || die 'Invalid content type'
  remote_path=$(peer_api_path "$path"); target_url="$(normalized_peer_url "$PEER_URL")$remote_path"
  local -a args=("$CURL_BIN" --fail-with-body --show-error --silent --request "$method" --connect-timeout 10 --max-time 3600 --basic --user "$PEER_RELAY_USER:$PEER_RELAY_PASSWORD")
  [[ -n $content_type ]] && args+=(--header "Content-Type: $content_type")
  case "$method" in GET|HEAD) ;; *) args+=(--data-binary @-);; esac
  "${args[@]}" "$target_url"
}

cmd_migrate() {
  local name=${1:?VM name required} id=${2:?peer node id required} result archive path
  validate_vm_name "$name"; valid_id "$id"; load_peer "$id"; [[ -n $PEER_URL ]] || die 'Peer has no API URL; set its endpoint first'; [[ $($VMCTL status "$name") == stopped ]] || die "VM must be stopped before migration: $name"
  result=$("$BACKUPCTL" create "$name" --label migration); archive=$(json_field "$result" archive); path=$(json_field "$result" path); [[ -n $archive && -f $path ]] || die 'Migration archive creation failed'
  cmd_proxy "$id" POST "/migrations/import/$archive" application/gzip < "$path" >/dev/null || die 'Peer import failed; source VM was retained'; "$VMCTL" delete "$name"
  printf '{"migrated":true,"vm":"%s","peer":"%s","archive":"%s"}\n' "$(json_escape "$name")" "$(json_escape "$id")" "$(json_escape "$archive")"
}

cmd_revoke() {
  local id=${1:?node id required} relay_user=''
  valid_id "$id"; id=${id,,}; load_peer "$id"; relay_user=$PEER_RELAY_USER
  # Tear down peer-bound data paths while the paired credential still exists,
  # so source-side replication can clean its peer-backed state before trust is removed.
  if [[ -x $REPLICATIONCTL ]]; then "$REPLICATIONCTL" revoke-peer "$id" "$relay_user" || true; fi
  if [[ -x $PEER_VOLUMECTL ]]; then "$PEER_VOLUMECTL" revoke-peer "$id" "$relay_user" || true; fi
  if [[ -x $BACKPLANECTL ]]; then "$BACKPLANECTL" revoke-peer "$id" || true; fi
  rm -f -- "$(peer_file "$id")" "$(peer_public_file "$id")"
  cmd_sync_auth
  # Close existing WebSockets as well as rejecting future upgrades.
  flock -u 9
  if [[ -x $OVERLAYCTL ]]; then "$OVERLAYCTL" revoke-peer "$id"; fi
}

ensure_peer_root
case "${1:-}" in
  request|accept|complete|revoke|sync-auth|cancel-pending|set-url)
    exec 9>"$PEER_ROOT/.lock"; flock -x 9;;
esac

case "${1:-help}" in
  identity) cmd_identity;; request) shift; cmd_request "$@";; pending) cmd_pending;; cancel-pending) cmd_cancel_pending;; accept) shift; cmd_accept "$@";; complete) shift; cmd_complete "$@";; list) cmd_list;; set-url) shift; cmd_set_url "$@";; overlay-credentials) shift; cmd_overlay_credentials "$@";; overlay-profile) shift; cmd_overlay_profile "$@";; transport-profile) shift; cmd_transport_profile "$@";; authorize-user) shift; cmd_authorize_user "$@";; sync-auth) cmd_sync_auth;; cors-origin) shift; cmd_cors_origin "$@";; proxy) shift; cmd_proxy "$@";; migrate) shift; cmd_migrate "$@";; revoke) shift; cmd_revoke "$@";;
  help|-h|--help) printf '%s\n' 'peerctl identity|request|pending|cancel-pending|accept BUNDLE [NAME]|complete BUNDLE|list|set-url NODE_ID URL|overlay-credentials NODE_ID|overlay-profile NODE_ID|transport-profile NODE_ID|authorize-user USER|sync-auth|proxy NODE_ID METHOD PATH [CONTENT_TYPE]|migrate VM NODE_ID|revoke NODE_ID';;
  *) die "Unknown command: ${1:-}";;
esac
