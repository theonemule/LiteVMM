#!/usr/bin/env bash
# Continuous QEMU disk replication onto the shared LiteVMM NFSv4/WebSocket peer backplane.
set -Eeuo pipefail
LIB=${VMAPI_LIB:-/usr/local/lib/vmapi/common.sh}
[[ -r "$LIB" ]] || LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)/common.sh"
source "$LIB"

BACKPLANECTL=${VMAPI_BACKPLANECTL:-/usr/local/bin/backplanectl}
PEERCTL=${VMAPI_PEERCTL:-/usr/local/bin/peerctl}
QEMU_IMG=${QEMU_IMG:-/usr/bin/qemu-img}
SOCAT=${SOCAT:-$(command -v socat 2>/dev/null || printf '%s' /usr/bin/socat)}
BACKPLANE_ROOT=${VMAPI_BACKPLANE_ROOT:-/var/lib/vmapi/backplane}
JOB_ROOT=${VMAPI_REPLICATION_JOB_ROOT:-/var/lib/vmapi/replication-jobs}
DAEMON_INTERVAL=${VMAPI_REPLICATION_DAEMON_INTERVAL:-10}
STALE_SECONDS=${VMAPI_REPLICATION_STALE_SECONDS:-45}

valid_peer_id(){ [[ ${1:-} =~ ^[a-fA-F0-9]{32}$ ]] || die "Invalid peer node id: ${1:-}"; }
valid_replica_id(){ [[ ${1:-} =~ ^[a-f0-9]{24}$ ]] || die "Invalid replica id: ${1:-}"; }
job_dir(){ validate_vm_name "$1"; printf '%s/%s\n' "$JOB_ROOT" "$1"; }
state_disk_indexes(){ sed -nE 's/^DISK_([0-9]+)_JOB=.*/\1/p' "$1" | sort -n -u; }
ensure_dirs(){ install -d -m 0750 "$JOB_ROOT"; }
# Load a job's state.conf, clearing DISK_* values left over from another job.
load_state(){ [[ -z ${!DISK_@} ]] || unset "${!DISK_@}"; PEER=''; SPEED=0; OWNER=''; source "$1"; }
# A pause marker holds a VM's replication off while another block job (a live
# backup) needs its disks. It records the holder's PID so a holder that dies
# without unpausing cannot leave replication stopped: the marker is then stale.
pause_file(){ printf '%s/paused\n' "$(job_dir "$1")"; }
replication_paused(){
  local file pid; file=$(pause_file "$1"); [[ -f $file ]] || return 1
  pid=$(sed -n 's/^PID=//p' "$file" | head -n1)
  [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null && return 0
  rm -f -- "$file"; return 1
}
replica_id(){ printf '%s' "$1/$2/$3" | sha256sum | cut -c1-24; }

qmp(){
  local vm=$1 payload=$2 sock="$(vm_dir "$vm")/runtime/qmp.sock"
  [[ -S $sock ]] || die "QMP socket is unavailable for $vm"
  need_cmd "$SOCAT"
  { printf '%s\n' '{"execute":"qmp_capabilities"}'; sleep .03; printf '%s\n' "$payload"; sleep .08; } | "$SOCAT" -T 5 - "UNIX-CONNECT:$sock"
}
qmp_ok(){ [[ $1 != *'"error"'* ]] || die "QMP rejected replication request: $1"; }
disk_qemu_id(){ local conf=$1 idx=$2 bus; bus=$(cfg_get_file "$conf" "DISK_${idx}_BUS" virtio); [[ $bus == virtio ]] && printf 'drive%s' "$idx" || printf 'disk%s' "$idx"; }
query_job_json(){
  local vm=$1 job=$2 out compact
  out=$(qmp "$vm" '{"execute":"query-block-jobs"}' 2>/dev/null || true)
  compact=$(printf '%s' "$out" | tr -d ' \t\r\n')
  printf '%s' "$compact" | grep -o '{[^{}]*"device":"'"$job"'"[^{}]*}' | head -n1 || true
}
cancel_job(){ local vm=$1 job=$2; qmp "$vm" '{"execute":"block-job-cancel","arguments":{"device":"'"$job"'"}}' >/dev/null 2>&1 || true; }

meta_get(){ local f=$1 k=$2; sed -n "s/^$k=//p" "$f" | head -n1; }
read_meta(){
  local meta=$1
  OWNER=$(meta_get "$meta" OWNER); VM=$(meta_get "$meta" VM); DISK_INDEX=$(meta_get "$meta" DISK_INDEX)
  BYTES=$(meta_get "$meta" BYTES); FILE_NAME=$(meta_get "$meta" FILE_NAME); ACTIVE=$(meta_get "$meta" ACTIVE); UPDATED=$(meta_get "$meta" UPDATED)
}
write_meta(){
  local meta=$1 owner=$2 vm=$3 idx=$4 bytes=$5 file=$6 active=$7 tmp
  valid_peer_id "$owner"; validate_vm_name "$vm"; validate_int "$idx"; validate_positive_int "$bytes"
  [[ $file =~ ^[A-Za-z0-9._-]+$ ]] || die 'Invalid replica metadata file name'
  tmp="${meta}.tmp.$$"
  printf 'OWNER=%s\nVM=%s\nDISK_INDEX=%s\nBYTES=%s\nFILE_NAME=%s\nACTIVE=%s\nUPDATED=%s\n' \
    "$owner" "$vm" "$idx" "$bytes" "$file" "$active" "$(date +%s)" > "$tmp"
  chmod 0640 "$tmp"; mv -f "$tmp" "$meta"
}

refresh_meta(){
  local meta=$1 active=${2:-true}
  [[ -r $meta ]] || return 0
  read_meta "$meta"
  [[ -n $OWNER && -n $VM && -n $DISK_INDEX && -n $BYTES && -n $FILE_NAME ]] || return 0
  write_meta "$meta" "$OWNER" "$VM" "$DISK_INDEX" "$BYTES" "$FILE_NAME" "$active"
}

image_virtual_size(){
  local file=$1 out bytes
  need_cmd "$QEMU_IMG"
  # A running QEMU owns the qcow2 write lock. Metadata inspection for
  # replication must not try to acquire a conflicting shared lock.
  out=$("$QEMU_IMG" info --force-share --output=json "$file" 2>&1) ||
    die "Could not inspect image $file: $out"
  bytes=$(printf '%s' "$out" | qemu_img_top_int virtual-size)
  validate_positive_int "$bytes"
  printf '%s\n' "$bytes"
}

prepare_new_replica_target(){
  local file=$1 dir
  dir=$(dirname -- "$file")
  [[ -d $dir ]] || die "Replica directory is unavailable: $dir"
  # Let QEMU create the mirror image itself. Pre-creating qcow2 with qemu-img
  # and then using mode=existing makes QEMU enforce an exact size match before
  # the copy starts; that has proven fragile across qcow2/QEMU versions. The
  # backplane directory is already owned by vmapi and writable by the running
  # QEMU process, so removing any stale target lets drive-mirror derive the
  # destination geometry directly from the live source block node.
  rm -f -- "$file"
}

start_mirror_job(){
  local vm=$1 idx=$2 target=$3 job=$4 speed=$5 mode=${6:-existing} conf qid escaped payload out
  conf=$(vm_conf "$vm"); qid=$(disk_qemu_id "$conf" "$idx"); escaped=$(json_escape "$target")
  [[ $mode == existing || $mode == absolute-paths ]] || die "Invalid mirror image mode: $mode"
  payload='{"execute":"drive-mirror","arguments":{"device":"'"$qid"'","job-id":"'"$job"'","target":"'"$escaped"'","format":"qcow2","sync":"full","mode":"'"$mode"'"'
  ((speed>0)) && payload+=',"speed":'"$speed"
  payload+='}}'
  out=$(qmp "$vm" "$payload"); qmp_ok "$out"
  # drive-mirror returns before the background copy completes. A target-open or
  # geometry error can arrive immediately afterwards as BLOCK_JOB_COMPLETED;
  # verify that the mirror job actually survived command acceptance.
  sleep 0.1
  [[ -n $(query_job_json "$vm" "$job") ]] || die "Replication mirror for $vm disk $idx stopped immediately after it was started"
}

backplane_ready(){
  local peer=$1 out
  out=$("$BACKPLANECTL" show "$peer" 2>/dev/null || true)
  [[ $out == *'"mounted":true'* && $out == *'"tunnel_running":true'* ]]
}

start_replication(){
  ensure_dirs
  local vm=${1:?VM required} peer=${2:?peer required} speed=${3:-0}
  validate_vm_name "$vm"; valid_peer_id "$peer"; require_vm "$vm"; require_running "$vm"; validate_int "$speed"
  need_cmd "$BACKPLANECTL"; need_cmd "$QEMU_IMG"; need_cmd sha256sum
  local dir state conf idx source bytes remote target meta job owner
  dir=$(job_dir "$vm"); [[ ! -e $dir ]] || die "Replication already configured for $vm"
  remote=$("$BACKPLANECTL" path "$peer" replicas "$vm")
  [[ $remote == /* && -d $remote ]] || die 'Peer backplane replica directory is unavailable'
  owner=$("$PEERCTL" identity | sed -n 's/.*"node_id":"\([a-fA-F0-9]*\)".*/\1/p' | head -n1)
  valid_peer_id "$owner"; owner=${owner,,}
  # die() exits directly, which never fires an ERR trap, so a rejected
  # drive-mirror used to leave a half-configured job behind for the daemon to
  # retry forever. Roll back on any exit until every disk's mirror is running.
  trap "stop_replication $(printf '%q' "$vm") true >/dev/null 2>&1 || true; rm -rf -- $(printf '%q' "$dir")" EXIT
  install -d -m 0700 "$dir"; state="$dir/state.conf"
  printf 'PEER=%q\nSPEED=%q\nOWNER=%q\n' "${peer,,}" "$speed" "$owner" > "$state"
  conf=$(vm_conf "$vm")
  while IFS= read -r idx; do
    source=$(vm_disk_path_index "$vm" "$idx")
    [[ -f $source ]] || die "Disk file missing: $source"
    bytes=$(image_virtual_size "$source")
    target="$remote/disk${idx}.qcow2"; meta="$remote/disk${idx}.meta"; job="repl-$idx"
    prepare_new_replica_target "$target"
    write_meta "$meta" "$owner" "$vm" "$idx" "$bytes" "disk${idx}.qcow2" true
    printf 'DISK_%s_JOB=%q\nDISK_%s_TARGET=%q\nDISK_%s_META=%q\nDISK_%s_BYTES=%q\n' \
      "$idx" "$job" "$idx" "$target" "$idx" "$meta" "$idx" "$bytes" >> "$state"
    start_mirror_job "$vm" "$idx" "$target" "$job" "$speed" absolute-paths
  done < <(indexes_for "$conf" DISK)
  trap - EXIT
  status_replication "$vm"
}

resume_replication(){
  local vm=${1:?VM required} dir state peer speed idx job target meta bytes obj current
  validate_vm_name "$vm"; dir=$(job_dir "$vm"); state="$dir/state.conf"; [[ -r $state ]] || return 0
  require_vm "$vm"; [[ $(vm_state "$vm") == running ]] || return 0
  ! replication_paused "$vm" || return 0
  PEER=''; SPEED=0; OWNER=''; source "$state"; peer=$PEER; speed=${SPEED:-0}
  valid_peer_id "$peer"; validate_int "$speed"
  "$BACKPLANECTL" connect "$peer" >/dev/null
  while IFS= read -r idx; do
    eval "job=\${DISK_${idx}_JOB:-}"; eval "target=\${DISK_${idx}_TARGET:-}"; eval "meta=\${DISK_${idx}_META:-}"; eval "bytes=\${DISK_${idx}_BYTES:-}"
    [[ -n $job && -n $target && -n $meta && -n $bytes ]] || die "Replication state is incomplete for $vm disk $idx"
    obj=$(query_job_json "$vm" "$job")
    # An active mirror job owns the destination qcow2 lock. Do not inspect or
    # recreate its target from the daemon while QEMU is writing it.
    if [[ -z $obj ]]; then
      # Builds that misread qemu-img's JSON recorded the source's host file
      # length instead of its virtual size. Re-measure before (re)creating the
      # target so that state heals itself instead of failing every cycle.
      current=$(image_virtual_size "$(vm_disk_path_index "$vm" "$idx")")
      if [[ $current != "$bytes" ]]; then
        sed -i "s/^DISK_${idx}_BYTES=.*/DISK_${idx}_BYTES=${current}/" "$state"; bytes=$current
        if [[ -r $meta ]]; then
          read_meta "$meta"
          if [[ -n $OWNER && -n $FILE_NAME ]]; then write_meta "$meta" "$OWNER" "$vm" "$idx" "$bytes" "$FILE_NAME" true; fi
        fi
      fi
      # A missing mirror is resynchronised from the live source. Recreate the
      # destination through QEMU rather than reusing/pre-sizing a qcow2 file.
      prepare_new_replica_target "$target"
      start_mirror_job "$vm" "$idx" "$target" "$job" "$speed" absolute-paths
    fi
    refresh_meta "$meta" true
  done < <(state_disk_indexes "$state")
}

status_replication(){
  local vm=${1:?VM required} dir state peer idx job meta obj ready offset len first=true connected=false
  validate_vm_name "$vm"; dir=$(job_dir "$vm"); state="$dir/state.conf"
  [[ -r $state ]] || { printf '{"vm":"%s","configured":false}\n' "$vm"; return; }
  PEER=''; source "$state"; peer=$PEER; backplane_ready "$peer" && connected=true
  printf '{"vm":"%s","configured":true,"paused":%s,"peer_id":"%s","running":%s,"transport":"nfs4-wss-backplane","disks":[' \
    "$vm" "$(replication_paused "$vm" && echo true || echo false)" "$peer" "$([[ $(vm_state "$vm") == running ]] && echo true || echo false)"
  while IFS= read -r idx; do
    eval "job=\${DISK_${idx}_JOB:-}"; eval "meta=\${DISK_${idx}_META:-}"
    ready=false; offset=0; len=0; obj=''
    [[ $(vm_state "$vm") == running ]] && obj=$(query_job_json "$vm" "$job")
    [[ $obj == *'"ready":true'* ]] && ready=true
    offset=$(printf '%s' "$obj" | sed -n 's/.*"offset":\([0-9][0-9]*\).*/\1/p' | head -n1); offset=${offset:-0}
    len=$(printf '%s' "$obj" | sed -n 's/.*"len":\([0-9][0-9]*\).*/\1/p' | head -n1); len=${len:-0}
    [[ -z $meta ]] || refresh_meta "$meta" true
    $first || printf ','; first=false
    printf '{"index":%s,"job":"%s","ready":%s,"offset":%s,"length":%s,"tunnel_running":%s,"backplane_connected":%s}' \
      "$idx" "$job" "$ready" "$offset" "$len" "$connected" "$connected"
  done < <(state_disk_indexes "$state")
  printf ']}\n'
}

# QEMU will not start another block job (such as a live backup) on a node a
# mirror job owns, so a holder pauses replication around its own job. Resuming
# restarts each mirror with sync=full, which resends the disk to the peer.
pause_replication(){
  local vm=${1:?VM required} holder=${2:?holder PID required} dir state idx job deadline tmp
  validate_vm_name "$vm"; validate_positive_int "$holder"; dir=$(job_dir "$vm"); state="$dir/state.conf"
  [[ -r $state ]] || { printf '{"vm":"%s","configured":false,"paused":false}\n' "$vm"; return 0; }
  kill -0 "$holder" 2>/dev/null || die "Pause holder is not running: $holder"
  tmp="$dir/.paused.$$"; printf 'PID=%s\nSINCE=%s\n' "$holder" "$(date +%s)" > "$tmp"; mv -f -- "$tmp" "$(pause_file "$vm")"
  load_state "$state"
  if [[ $(vm_state "$vm") == running ]]; then
    while IFS= read -r idx; do
      eval "job=\${DISK_${idx}_JOB:-}"; [[ -n $job ]] || continue
      deadline=$((SECONDS + 60))
      # Re-issue the cancel while waiting: a daemon pass that read the job list
      # just before the marker appeared may have restarted the mirror.
      while [[ -n $(query_job_json "$vm" "$job") ]]; do
        ((SECONDS < deadline)) || { rm -f -- "$(pause_file "$vm")"; die "Replication job $job for $vm did not stop"; }
        cancel_job "$vm" "$job"; sleep 0.5
      done
    done < <(state_disk_indexes "$state")
  fi
  printf '{"vm":"%s","configured":true,"paused":true,"holder":%s}\n' "$vm" "$holder"
}

unpause_replication(){
  local vm=${1:?VM required} dir
  validate_vm_name "$vm"; dir=$(job_dir "$vm")
  # Drop the marker first so the daemon retries even if this resume fails.
  rm -f -- "$(pause_file "$vm")"
  [[ -r $dir/state.conf ]] || { printf '{"vm":"%s","configured":false,"paused":false}\n' "$vm"; return 0; }
  resume_replication "$vm"
  status_replication "$vm"
}

stop_replication(){
  local vm=${1:?VM required} quiet=${2:-false} dir state idx job meta
  validate_vm_name "$vm"; dir=$(job_dir "$vm"); state="$dir/state.conf"
  [[ -r $state ]] || { $quiet || printf '{"stopped":true,"vm":"%s"}\n' "$vm"; return; }
  load_state "$state"
  while IFS= read -r idx; do
    eval "job=\${DISK_${idx}_JOB:-}"; eval "meta=\${DISK_${idx}_META:-}"
    [[ $(vm_state "$vm") == running && -n $job ]] && cancel_job "$vm" "$job"
    [[ -z $meta ]] || refresh_meta "$meta" false
  done < <(state_disk_indexes "$state")
  rm -rf -- "$dir"
  $quiet || printf '{"stopped":true,"vm":"%s","replica_retained":true}\n' "$vm"
}

list_replications(){
  local d first=true
  printf '['
  for d in "$JOB_ROOT"/*; do
    [[ -d $d ]] || continue
    $first || printf ','; first=false
    status_replication "$(basename "$d")" | tr -d '\n'
  done
  printf ']\n'
}

resume_all(){
  local d vm
  for d in "$JOB_ROOT"/*; do
    [[ -d $d ]] || continue
    vm=$(basename "$d")
    [[ -f $(vm_conf "$vm") && $(vm_state "$vm") == running ]] || continue
    resume_replication "$vm" || echo "Could not resume replication for $vm" >&2
  done
}

find_replica_meta(){
  local wanted=$1 meta owner vm idx
  valid_replica_id "$wanted"; shopt -s nullglob
  for meta in "$BACKPLANE_ROOT"/peers/*/replicas/*/disk*.meta; do
    [[ -f $meta ]] || continue
    OWNER=''; VM=''; DISK_INDEX=''; BYTES=''; FILE_NAME=''; ACTIVE=''; UPDATED=''
    read_meta "$meta"; owner=$OWNER; vm=$VM; idx=$DISK_INDEX
    [[ -n $owner && -n $vm && -n $idx ]] || continue
    if [[ $(replica_id "$owner" "$vm" "$idx") == "$wanted" ]]; then printf '%s\n' "$meta"; shopt -u nullglob; return 0; fi
  done
  shopt -u nullglob; return 1
}

replica_show(){
  local id=${1:?id required} meta now active=false allocated=0
  meta=$(find_replica_meta "$id") || die 'Replica not found'
  OWNER=''; VM=''; DISK_INDEX=''; BYTES=''; FILE_NAME=''; ACTIVE=''; UPDATED=''
  read_meta "$meta"
  validate_vm_name "$VM"; validate_int "$DISK_INDEX"; validate_positive_int "$BYTES"; [[ $FILE_NAME =~ ^[A-Za-z0-9._-]+$ ]] || die 'Replica metadata has an invalid file name'
  local FILE="$(dirname "$meta")/$FILE_NAME"
  now=$(date +%s)
  if [[ $ACTIVE == true && $UPDATED =~ ^[0-9]+$ && $((now-UPDATED)) -le $STALE_SECONDS ]]; then active=true; fi
  [[ -f $FILE ]] && allocated=$(( $(du -k "$FILE" 2>/dev/null | awk '{print $1+0}') * 1024 ))
  printf '{"id":"%s","owner":"%s","vm":"%s","disk_index":%s,"bytes":%s,"allocated_bytes":%s,"active":%s,"nbd_running":false,"websocket_running":%s,"backplane":true,"transport":"nfs4-wss-backplane","replica":"%s"}\n' \
    "$id" "$(json_escape "$OWNER")" "$(json_escape "$VM")" "$DISK_INDEX" "$BYTES" "$allocated" "$active" "$active" "$(json_escape "$FILE")"
}

replica_list(){
  local meta owner vm idx id first=true
  printf '['; shopt -s nullglob
  for meta in "$BACKPLANE_ROOT"/peers/*/replicas/*/disk*.meta; do
    [[ -f $meta ]] || continue
    OWNER=''; VM=''; DISK_INDEX=''; BYTES=''; FILE_NAME=''; ACTIVE=''; UPDATED=''
    read_meta "$meta"; owner=$OWNER; vm=$VM; idx=$DISK_INDEX
    [[ -n $owner && -n $vm && $idx =~ ^[0-9]+$ ]] || continue
    id=$(replica_id "$owner" "$vm" "$idx")
    $first || printf ','; first=false
    replica_show "$id" | tr -d '\n'
  done
  shopt -u nullglob; printf ']\n'
}

replica_purge(){
  local id=${1:?id required} delete_file=${2:-false} meta now active=false replica
  validate_bool "$delete_file"; meta=$(find_replica_meta "$id") || die 'Replica not found'
  OWNER=''; VM=''; DISK_INDEX=''; BYTES=''; FILE_NAME=''; ACTIVE=''; UPDATED=''; read_meta "$meta"
  [[ $FILE_NAME =~ ^[A-Za-z0-9._-]+$ ]] || die 'Replica metadata has an invalid file name'
  local FILE="$(dirname "$meta")/$FILE_NAME"
  now=$(date +%s)
  [[ $ACTIVE != true || ! $UPDATED =~ ^[0-9]+$ || $((now-UPDATED)) -gt $STALE_SECONDS ]] || die 'Cannot purge an active replica'
  replica=$FILE; rm -f -- "$meta"; $delete_file && rm -f -- "$replica"
  printf '{"purged":true,"deleted_file":%s,"id":"%s","replica":"%s"}\n' "$delete_file" "$id" "$(json_escape "$replica")"
}

revoke_peer(){
  local peer=${1:?peer required} _owner=${2:-} d state vm
  valid_peer_id "$peer"; peer=${peer,,}
  for d in "$JOB_ROOT"/*; do
    [[ -d $d ]] || continue; state="$d/state.conf"; [[ -r $state ]] || continue
    PEER=''; source "$state"; [[ $PEER == "$peer" ]] || continue
    vm=$(basename "$d"); stop_replication "$vm" true || true
  done
}

daemon_cleanup(){
  local d vm state idx job meta
  for d in "$JOB_ROOT"/*; do
    [[ -d $d ]] || continue; vm=$(basename "$d"); state="$d/state.conf"; [[ -r $state ]] || continue
    load_state "$state"
    while IFS= read -r idx; do
      eval "job=\${DISK_${idx}_JOB:-}"; eval "meta=\${DISK_${idx}_META:-}"
      [[ $(vm_state "$vm") == running && -n $job ]] && cancel_job "$vm" "$job"
      [[ -z $meta ]] || refresh_meta "$meta" false
    done < <(state_disk_indexes "$state")
  done
}
suspend(){ daemon_cleanup; printf '{"suspended":true}\n'; }
daemon(){
  ensure_dirs; trap 'daemon_cleanup; exit 0' TERM INT
  while :; do resume_all; sleep "$DAEMON_INTERVAL" & wait $!; done
}

case ${1:-help} in
  start) shift; start_replication "$@";;
  resume) shift; resume_replication "$@"; status_replication "$1";;
  resume-all) resume_all;;
  status) shift; status_replication "$@";;
  stop) shift; stop_replication "$@";;
  pause) shift; pause_replication "$@";;
  unpause) shift; unpause_replication "$@";;
  list) list_replications;;
  replica-show) shift; replica_show "$@";;
  replica-list) replica_list;;
  replica-purge) shift; replica_purge "$@";;
  revoke-peer) shift; revoke_peer "$@";;
  suspend) suspend;;
  daemon) daemon;;
  help|-h|--help) echo 'replicationctl start VM PEER_ID [BYTES_PER_SEC] | resume VM | status VM | stop VM | pause VM HOLDER_PID | unpause VM | list | replica-list | replica-show ID | replica-purge ID [true|false] | daemon';;
  *) die "Unknown replication command: ${1:-}";;
esac
