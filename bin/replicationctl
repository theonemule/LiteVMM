#!/usr/bin/env bash
# Continuous QEMU disk replication onto the shared LiteVMM NFSv4/WebSocket peer backplane.
set -Eeuo pipefail
LIB=${VMAPI_LIB:-/usr/local/lib/vmapi/common.sh}
[[ -r "$LIB" ]] || LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)/common.sh"
source "$LIB"

BACKPLANECTL=${VMAPI_BACKPLANECTL:-/usr/local/bin/backplanectl}
PEERCTL=${VMAPI_PEERCTL:-/usr/local/bin/peerctl}
QEMU_IMG=${QEMU_IMG:-/usr/bin/qemu-img}
SOCAT=${SOCAT:-$(command -v socat 2>/dev/null || printf '%s' /usr/bin/socat)}
BACKPLANE_ROOT=${VMAPI_BACKPLANE_ROOT:-/var/lib/vmapi/backplane}
JOB_ROOT=${VMAPI_REPLICATION_JOB_ROOT:-/var/lib/vmapi/replication-jobs}
DAEMON_INTERVAL=${VMAPI_REPLICATION_DAEMON_INTERVAL:-10}
STALE_SECONDS=${VMAPI_REPLICATION_STALE_SECONDS:-45}
# Catch-up after a pause copies changed blocks while the guest runs, then
# freezes it only for a final pass once the remaining delta is this small.
CATCHUP_FINAL_BYTES=${VMAPI_REPLICATION_CATCHUP_FINAL_BYTES:-67108864}
CATCHUP_PASSES=${VMAPI_REPLICATION_CATCHUP_PASSES:-5}

valid_peer_id(){ [[ ${1:-} =~ ^[a-fA-F0-9]{32}$ ]] || die "Invalid peer node id: ${1:-}"; }
valid_replica_id(){ [[ ${1:-} =~ ^[a-f0-9]{24}$ ]] || die "Invalid replica id: ${1:-}"; }
job_dir(){ validate_vm_name "$1"; printf '%s/%s\n' "$JOB_ROOT" "$1"; }
state_disk_indexes(){ sed -nE 's/^DISK_([0-9]+)_JOB=.*/\1/p' "$1" | sort -n -u; }
ensure_dirs(){ install -d -m 0750 "$JOB_ROOT"; }
# Load a job's state.conf, clearing DISK_* values left over from another job.
load_state(){ [[ -z ${!DISK_@} ]] || unset "${!DISK_@}"; PEER=''; SPEED=0; OWNER=''; source "$1"; }
# A pause marker holds a VM's replication off while another block job (a live
# backup) needs its disks. It records the holder's PID so a holder that dies
# without unpausing cannot leave replication stopped: the marker is then stale.
pause_file(){ printf '%s/paused\n' "$(job_dir "$1")"; }
replication_paused(){
  local file pid; file=$(pause_file "$1"); [[ -f $file ]] || return 1
  pid=$(sed -n 's/^PID=//p' "$file" | head -n1)
  [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null && return 0
  rm -f -- "$file"; return 1
}
# Serialise replication changes to one VM between CLI commands, backups,
# hibernation and the daemon. The lock is released when the process exits.
REPL_LOCK_FD=''
lock_replication(){
  local vm=$1 wait=${2:-300} dir; dir=$(job_dir "$vm")
  [[ -z $REPL_LOCK_FD && -d $dir ]] || return 0
  command -v flock >/dev/null 2>&1 || return 0
  exec {REPL_LOCK_FD}>"$dir/.lock"
  if (( wait == 0 )); then flock -n "$REPL_LOCK_FD" || return 1
  else flock -w "$wait" "$REPL_LOCK_FD" || die "Replication for $vm is busy"; fi
}

# Change tracking. A disk's bitmap exists only while its mirror is stopped and
# its replica was exact when tracking began (a READY mirror cancelled with the
# guest frozen). Its bits are then precisely the blocks the replica is missing,
# so a paused replica catches up with those blocks instead of a full resync.
# Persistent bitmaps (qcow2) survive QEMU restarts, including hibernation.
repl_bitmap(){ printf 'vmapi-repl-%s\n' "$1"; }
# Stop the VM's mirrors, leaving each in-sync replica exact and tracking later
# guest writes in that disk's bitmap. The guest is frozen from the cancels to
# the bitmap creation so no write can fall between the two. A mirror still in
# its initial copy leaves an incomplete replica: it gets no bitmap, and that
# disk is resynchronised in full when replication resumes.
quiesce_mirrors(){
  local vm=$1 state=$2 conf idx job info qid bitmap persistent deadline active=false
  local -a synced=() unsynced=()
  [[ $(vm_state "$vm") == running ]] || return 0
  conf=$(vm_conf "$vm"); load_state "$state"
  while IFS= read -r idx; do
    eval "job=\${DISK_${idx}_JOB:-}"; [[ -z $job || -z $(mirror_job_info "$vm" "$job") ]] || active=true
  done < <(state_disk_indexes "$state")
  $active || return 0
  trap 'vm_thaw' EXIT
  vm_freeze "$vm"
  while IFS= read -r idx; do
    eval "job=\${DISK_${idx}_JOB:-}"; [[ -n $job ]] || continue
    info=$(mirror_job_info "$vm" "$job"); [[ -n $info ]] || continue
    if [[ $info == *'"ready": true'* ]]; then synced+=("$idx"); else unsynced+=("$idx"); fi
    deadline=$((SECONDS + 60))
    # Re-issue the cancel while waiting: a daemon pass that read the job list
    # just before the pause marker appeared may have restarted the mirror.
    while [[ -n $(mirror_job_info "$vm" "$job") ]]; do
      ((SECONDS < deadline)) || die "Replication job $job for $vm did not stop"
      qmp_call "$vm" "{\"execute\":\"block-job-cancel\",\"arguments\":{\"device\":\"$job\"}}" >/dev/null || true
      sleep 0.01
    done
  done < <(state_disk_indexes "$state")
  for idx in ${synced[@]+"${synced[@]}"}; do
    qid=$(disk_qemu_id "$conf" "$idx"); bitmap=$(repl_bitmap "$idx")
    [[ -z $(bitmap_info "$vm" "$bitmap") ]] || continue
    persistent=false; [[ $(cfg_get_file "$conf" "DISK_${idx}_FORMAT" qcow2) == qcow2 ]] && persistent=true
    qmp_do "$vm" "{\"execute\":\"block-dirty-bitmap-add\",\"arguments\":{\"node\":\"$qid\",\"name\":\"$bitmap\",\"persistent\":$persistent}}" 'change tracking' >/dev/null
  done
  for idx in ${unsynced[@]+"${unsynced[@]}"}; do remove_bitmap "$vm" "$(disk_qemu_id "$conf" "$idx")" "$(repl_bitmap "$idx")"; done
  vm_thaw; trap - EXIT
}

# Copy the blocks set in BITMAP from disk QID to the replica node. on-success
# leaves the bitmap holding exactly the writes made while the copy ran.
copy_changed_blocks(){
  local vm=$1 qid=$2 node=$3 bitmap=$4 speed=$5 payload
  payload="{\"execute\":\"blockdev-backup\",\"arguments\":{\"device\":\"$qid\",\"target\":\"$node\",\"sync\":\"bitmap\",\"bitmap\":\"$bitmap\",\"bitmap-mode\":\"on-success\",\"job-id\":\"vmapi-catchup\",\"auto-dismiss\":false"
  ((speed > 0)) && payload+=",\"speed\":$speed"
  qmp_do "$vm" "$payload}}" 'catch-up copy' >/dev/null
  qmp_wait_job "$vm" vmapi-catchup
}

# Bring disk IDX's replica up to date from its bitmap, then hand over to a
# mirror that forwards only new writes (sync=none). Passes run while the guest
# keeps working; it is frozen only for the last pass, once the delta is small.
catch_up_disk(){
  local vm=$1 idx=$2 target=$3 job=$4 speed=$5 conf qid bitmap node count pass payload
  conf=$(vm_conf "$vm"); qid=$(disk_qemu_id "$conf" "$idx"); bitmap=$(repl_bitmap "$idx"); node="vmapi-replica-$idx"
  trap "vm_thaw; qmp_call $(printf '%q' "$vm") '{\"execute\":\"blockdev-del\",\"arguments\":{\"node-name\":\"$node\"}}' >/dev/null 2>&1 || true" EXIT
  # Clear leftovers of an interrupted catch-up before reusing their names.
  qmp_call "$vm" '{"execute":"job-dismiss","arguments":{"id":"vmapi-catchup"}}' >/dev/null 2>&1 || true
  qmp_call "$vm" "{\"execute\":\"blockdev-del\",\"arguments\":{\"node-name\":\"$node\"}}" >/dev/null 2>&1 || true
  qmp_do "$vm" "{\"execute\":\"blockdev-add\",\"arguments\":{\"driver\":\"qcow2\",\"node-name\":\"$node\",\"file\":{\"driver\":\"file\",\"filename\":\"$(json_escape "$target")\"}}}" 'replica open' >/dev/null
  for ((pass = 1; pass <= CATCHUP_PASSES; pass++)); do
    count=$(json_int_field "$(bitmap_info "$vm" "$bitmap")" count)
    [[ -n $count ]] || die "Change tracking for $vm disk $idx disappeared"
    (( count > CATCHUP_FINAL_BYTES )) || break
    copy_changed_blocks "$vm" "$qid" "$node" "$bitmap" "$speed"
  done
  vm_freeze "$vm"
  copy_changed_blocks "$vm" "$qid" "$node" "$bitmap" 0
  qmp_do "$vm" "{\"execute\":\"blockdev-del\",\"arguments\":{\"node-name\":\"$node\"}}" 'replica close' >/dev/null
  qmp_do "$vm" "{\"execute\":\"block-dirty-bitmap-remove\",\"arguments\":{\"node\":\"$qid\",\"name\":\"$bitmap\"}}" 'change tracking removal' >/dev/null
  payload="{\"execute\":\"drive-mirror\",\"arguments\":{\"device\":\"$qid\",\"job-id\":\"$job\",\"target\":\"$(json_escape "$target")\",\"format\":\"qcow2\",\"sync\":\"none\",\"mode\":\"existing\""
  ((speed > 0)) && payload+=",\"speed\":$speed"
  qmp_do "$vm" "$payload}}" 'mirror restart' >/dev/null
  vm_thaw
  trap - EXIT
  sleep 0.2
  [[ -n $(mirror_job_info "$vm" "$job") ]] || die "Mirror for $vm disk $idx stopped right after restarting"
}

bitmap_info(){
  local out; out=$(qmp_call "$1" '{"execute":"query-block"}' 2>/dev/null) || return 0
  json_flat_object "$out" name "$2"
}
bitmap_usable(){ local info; info=$(bitmap_info "$1" "$2"); [[ -n $info && $info != *'"inconsistent": true'* && $info != *'"busy": true'* ]]; }
remove_bitmap(){ [[ -z $(bitmap_info "$1" "$3") ]] || qmp_call "$1" "{\"execute\":\"block-dirty-bitmap-remove\",\"arguments\":{\"node\":\"$2\",\"name\":\"$3\"}}" >/dev/null 2>&1 || true; }
# Drop tracking for every disk of VM, running or not.
remove_all_bitmaps(){
  local vm=$1 conf idx bitmap path
  conf=$(vm_conf "$vm")
  while IFS= read -r idx; do
    bitmap=$(repl_bitmap "$idx")
    if [[ $(vm_state "$vm") == running ]]; then remove_bitmap "$vm" "$(disk_qemu_id "$conf" "$idx")" "$bitmap"
    elif [[ $(cfg_get_file "$conf" "DISK_${idx}_FORMAT" qcow2) == qcow2 ]]; then
      path=$(vm_disk_path_index "$vm" "$idx" 2>/dev/null) || continue
      "$QEMU_IMG" bitmap --remove "$path" "$bitmap" >/dev/null 2>&1 || true
    fi
  done < <(indexes_for "$conf" DISK)
}

replica_id(){ printf '%s' "$1/$2/$3" | sha256sum | cut -c1-24; }

qmp(){
  local vm=$1 payload=$2 sock="$(vm_dir "$vm")/runtime/qmp.sock"
  [[ -S $sock ]] || die "QMP socket is unavailable for $vm"
  need_cmd "$SOCAT"
  { printf '%s\n' '{"execute":"qmp_capabilities"}'; sleep .03; printf '%s\n' "$payload"; sleep .08; } | "$SOCAT" -T 5 - "UNIX-CONNECT:$sock"
}
qmp_ok(){ [[ $1 != *'"error"'* ]] || die "QMP rejected replication request: $1"; }
disk_qemu_id(){ local conf=$1 idx=$2 bus; bus=$(cfg_get_file "$conf" "DISK_${idx}_BUS" virtio); [[ $bus == virtio ]] && printf 'drive%s' "$idx" || printf 'disk%s' "$idx"; }
query_job_json(){
  local vm=$1 job=$2 out compact
  out=$(qmp "$vm" '{"execute":"query-block-jobs"}' 2>/dev/null || true)
  compact=$(printf '%s' "$out" | tr -d ' \t\r\n')
  printf '%s' "$compact" | grep -o '{[^{}]*"device":"'"$job"'"[^{}]*}' | head -n1 || true
}
mirror_job_info(){ json_flat_object "$(qmp_do "$1" '{"execute":"query-block-jobs"}' 'job query')" device "$2"; }
cancel_job(){ local vm=$1 job=$2; qmp "$vm" '{"execute":"block-job-cancel","arguments":{"device":"'"$job"'"}}' >/dev/null 2>&1 || true; }

meta_get(){ local f=$1 k=$2; sed -n "s/^$k=//p" "$f" | head -n1; }
read_meta(){
  local meta=$1
  OWNER=$(meta_get "$meta" OWNER); VM=$(meta_get "$meta" VM); DISK_INDEX=$(meta_get "$meta" DISK_INDEX)
  BYTES=$(meta_get "$meta" BYTES); FILE_NAME=$(meta_get "$meta" FILE_NAME); ACTIVE=$(meta_get "$meta" ACTIVE); UPDATED=$(meta_get "$meta" UPDATED)
  RECOVERABLE=$(meta_get "$meta" RECOVERABLE); [[ $RECOVERABLE == true ]] || RECOVERABLE=false
}
write_meta(){
  local meta=$1 owner=$2 vm=$3 idx=$4 bytes=$5 file=$6 active=$7 recoverable=${8:-false} tmp
  valid_peer_id "$owner"; validate_vm_name "$vm"; validate_int "$idx"; validate_positive_int "$bytes"
  [[ $file =~ ^[A-Za-z0-9._-]+$ ]] || die 'Invalid replica metadata file name'
  validate_bool "$recoverable"
  tmp="${meta}.tmp.$$"
  printf 'OWNER=%s\nVM=%s\nDISK_INDEX=%s\nBYTES=%s\nFILE_NAME=%s\nACTIVE=%s\nRECOVERABLE=%s\nUPDATED=%s\n' \
    "$owner" "$vm" "$idx" "$bytes" "$file" "$active" "$recoverable" "$(date +%s)" > "$tmp"
  chmod 0640 "$tmp"; mv -f "$tmp" "$meta"
}

refresh_meta(){
  local meta=$1 active=${2:-true} recoverable=${3-}
  [[ -r $meta ]] || return 0
  read_meta "$meta"
  [[ -n $OWNER && -n $VM && -n $DISK_INDEX && -n $BYTES && -n $FILE_NAME ]] || return 0
  [[ -n $recoverable ]] || recoverable=$RECOVERABLE
  write_meta "$meta" "$OWNER" "$VM" "$DISK_INDEX" "$BYTES" "$FILE_NAME" "$active" "$recoverable"
}

image_virtual_size(){
  local file=$1 out bytes
  need_cmd "$QEMU_IMG"
  # A running QEMU owns the qcow2 write lock. Metadata inspection for
  # replication must not try to acquire a conflicting shared lock.
  out=$("$QEMU_IMG" info --force-share --output=json "$file" 2>&1) ||
    die "Could not inspect image $file: $out"
  bytes=$(printf '%s' "$out" | qemu_img_top_int virtual-size)
  validate_positive_int "$bytes"
  printf '%s\n' "$bytes"
}

prepare_new_replica_target(){
  local file=$1 dir
  dir=$(dirname -- "$file")
  [[ -d $dir ]] || die "Replica directory is unavailable: $dir"
  rm -f -- "$file"
}

start_mirror_job(){
  local vm=$1 idx=$2 target=$3 job=$4 speed=$5 sync=${6:-full} mode conf qid escaped payload out
  conf=$(vm_conf "$vm"); qid=$(disk_qemu_id "$conf" "$idx"); escaped=$(json_escape "$target")
  mode=existing; [[ $sync == full ]] && mode=absolute-paths
  payload='{"execute":"drive-mirror","arguments":{"device":"'"$qid"'","job-id":"'"$job"'","target":"'"$escaped"'","format":"qcow2","sync":"'"$sync"'","mode":"'"$mode"'"'
  ((speed>0)) && payload+=',"speed":'"$speed"
  payload+='}}'
  out=$(qmp "$vm" "$payload"); qmp_ok "$out"
  sleep 0.1
  [[ -n $(query_job_json "$vm" "$job") ]] || die "Replication mirror for $vm disk $idx stopped immediately after it was started"
}

backplane_ready(){
  local peer=$1 out
  out=$("$BACKPLANECTL" show "$peer" 2>/dev/null || true)
  [[ $out == *'"mounted":true'* && $out == *'"tunnel_running":true'* ]]
}

start_replication(){
  ensure_dirs
  local vm=${1:?VM required} peer=${2:?peer required} speed=${3:-0}
  validate_vm_name "$vm"; valid_peer_id "$peer"; require_vm "$vm"; require_running "$vm"; validate_int "$speed"
  need_cmd "$BACKPLANECTL"; need_cmd "$QEMU_IMG"; need_cmd sha256sum
  local dir state conf idx source bytes remote target meta job owner
  dir=$(job_dir "$vm"); [[ ! -e $dir ]] || die "Replication already configured for $vm"
  remote=$("$BACKPLANECTL" path "$peer" replicas "$vm")
  [[ $remote == /* && -d $remote ]] || die 'Peer backplane replica directory is unavailable'
  owner=$("$PEERCTL" identity | sed -n 's/.*"node_id":"\([a-fA-F0-9]*\)".*/\1/p' | head -n1)
  valid_peer_id "$owner"; owner=${owner,,}
  # die() exits directly, which never fires an ERR trap, so a rejected
  # drive-mirror used to leave a half-configured job behind for the daemon to
  # retry forever. Roll back on any exit until every disk's mirror is running.
  trap "stop_replication $(printf '%q' "$vm") true >/dev/null 2>&1 || true; rm -rf -- $(printf '%q' "$dir")" EXIT
  install -d -m 0700 "$dir"; state="$dir/state.conf"
  printf 'PEER=%q\nSPEED=%q\nOWNER=%q\n' "${peer,,}" "$speed" "$owner" > "$state"
  conf=$(vm_conf "$vm")
  remove_all_bitmaps "$vm"
  while IFS= read -r idx; do
    source=$(vm_disk_path_index "$vm" "$idx")
    [[ -f $source ]] || die "Disk file missing: $source"
    bytes=$(image_virtual_size "$source")
    target="$remote/disk${idx}.qcow2"; meta="$remote/disk${idx}.meta"; job="repl-$idx"
    prepare_new_replica_target "$target"
    write_meta "$meta" "$owner" "$vm" "$idx" "$bytes" "disk${idx}.qcow2" true false
    printf 'DISK_%s_JOB=%q\nDISK_%s_TARGET=%q\nDISK_%s_META=%q\nDISK_%s_BYTES=%q\n' \
      "$idx" "$job" "$idx" "$target" "$idx" "$meta" "$idx" "$bytes" >> "$state"
    start_mirror_job "$vm" "$idx" "$target" "$job" "$speed"
  done < <(indexes_for "$conf" DISK)
  trap - EXIT
  status_replication "$vm"
}

resume_replication(){
  local vm=${1:?VM required} dir state peer speed idx job target meta bytes obj current conf qid bitmap
  validate_vm_name "$vm"; dir=$(job_dir "$vm"); state="$dir/state.conf"; [[ -r $state ]] || return 0
  require_vm "$vm"; [[ $(vm_state "$vm") == running ]] || return 0
  ! replication_paused "$vm" || return 0
  PEER=''; SPEED=0; OWNER=''; source "$state"; peer=$PEER; speed=${SPEED:-0}
  valid_peer_id "$peer"; validate_int "$speed"
  "$BACKPLANECTL" connect "$peer" >/dev/null
  conf=$(vm_conf "$vm")
  while IFS= read -r idx; do
    eval "job=\${DISK_${idx}_JOB:-}"; eval "target=\${DISK_${idx}_TARGET:-}"; eval "meta=\${DISK_${idx}_META:-}"; eval "bytes=\${DISK_${idx}_BYTES:-}"
    [[ -n $job && -n $target && -n $meta && -n $bytes ]] || die "Replication state is incomplete for $vm disk $idx"
    obj=$(query_job_json "$vm" "$job")
    # An active mirror job owns the destination qcow2 lock. Do not inspect or
    # recreate its target from the daemon while QEMU is writing it.
    if [[ -z $obj ]]; then
      # Builds that misread qemu-img's JSON recorded the source's host file
      # length instead of its virtual size. Re-measure before (re)creating the
      # target so that state heals itself instead of failing every cycle.
      current=$(image_virtual_size "$(vm_disk_path_index "$vm" "$idx")")
      if [[ $current != "$bytes" ]]; then
        sed -i "s/^DISK_${idx}_BYTES=.*/DISK_${idx}_BYTES=${current}/" "$state"; bytes=$current
        if [[ -r $meta ]]; then
          read_meta "$meta"
          if [[ -n $OWNER && -n $FILE_NAME ]]; then write_meta "$meta" "$OWNER" "$vm" "$idx" "$bytes" "$FILE_NAME" true "$RECOVERABLE"; fi
        fi
      fi
      qid=$(disk_qemu_id "$conf" "$idx"); bitmap=$(repl_bitmap "$idx")
      # Tracked changes since a pause: send only those. Anything else, or a
      # catch-up that fails part way, falls back to a full resynchronisation.
      if bitmap_usable "$vm" "$bitmap" && [[ -f $target && $(image_virtual_size "$target" 2>/dev/null) == "$bytes" ]] \
         && ( catch_up_disk "$vm" "$idx" "$target" "$job" "$speed" ); then
        :
      else
        [[ -z $(bitmap_info "$vm" "$bitmap") ]] || err "Replica of $vm disk $idx could not catch up from tracked changes; resynchronising it in full"
        remove_bitmap "$vm" "$qid" "$bitmap"
        [[ -z $(query_job_json "$vm" "$job") ]] || { cancel_job "$vm" "$job"; sleep 1; }
        prepare_new_replica_target "$target"
        refresh_meta "$meta" true false
        start_mirror_job "$vm" "$idx" "$target" "$job" "$speed"
      fi
    fi
    obj=$(query_job_json "$vm" "$job")
    if [[ $obj == *'"ready":true'* ]]; then refresh_meta "$meta" true true; else refresh_meta "$meta" true; fi
  done < <(state_disk_indexes "$state")
}

status_replication(){
  local vm=${1:?VM required} dir state peer idx job meta disk_bytes obj ready recoverable=false offset len first=true connected=false running=false
  validate_vm_name "$vm"; dir=$(job_dir "$vm"); state="$dir/state.conf"
  [[ -r $state ]] || { printf '{"vm":"%s","configured":false}\n' "$vm"; return; }
  PEER=''; source "$state"; peer=$PEER; backplane_ready "$peer" && connected=true
  [[ $(vm_state "$vm") == running ]] && running=true
  printf '{"vm":"%s","configured":true,"paused":%s,"peer_id":"%s","running":%s,"transport":"nfs4-wss-backplane","disks":[' \
    "$vm" "$(replication_paused "$vm" && echo true || echo false)" "$peer" "$running"
  while IFS= read -r idx; do
    eval "job=\${DISK_${idx}_JOB:-}"; eval "meta=\${DISK_${idx}_META:-}"; eval "disk_bytes=\${DISK_${idx}_BYTES:-0}"
    ready=false; recoverable=false; offset=0; len=0; obj=''
    $running && obj=$(query_job_json "$vm" "$job")
    [[ $obj == *'"ready":true'* ]] && ready=true
    offset=$(printf '%s' "$obj" | sed -n 's/.*"offset":\([0-9][0-9]*\).*/\1/p' | head -n1); offset=${offset:-0}
    len=$(printf '%s' "$obj" | sed -n 's/.*"len":\([0-9][0-9]*\).*/\1/p' | head -n1); len=${len:-0}
    if [[ -n $meta && -r $meta ]]; then
      read_meta "$meta"
      if $ready; then recoverable=true; refresh_meta "$meta" "$running" true
      else recoverable=$RECOVERABLE; refresh_meta "$meta" "$running"; fi
    fi
    $first || printf ','; first=false
    printf '{"index":%s,"job":"%s","ready":%s,"recoverable":%s,"offset":%s,"length":%s,"bytes":%s,"tunnel_running":%s,"backplane_connected":%s}' \
      "$idx" "$job" "$ready" "$recoverable" "$offset" "$len" "${disk_bytes:-0}" "$connected" "$connected"
  done < <(state_disk_indexes "$state")
  printf ']}\n'
}

# QEMU will not start another block job (such as a live backup) on a node a
# mirror job owns, so a holder swaps the mirror for dirty-bitmap tracking.
# Unpause catches up only the changed blocks and then resumes continuous mirror.
pause_replication(){
  local vm=${1:?VM required} holder=${2:?holder PID required} dir state tmp
  validate_vm_name "$vm"; validate_positive_int "$holder"; dir=$(job_dir "$vm"); state="$dir/state.conf"
  [[ -r $state ]] || { printf '{"vm":"%s","configured":false,"paused":false}\n' "$vm"; return 0; }
  kill -0 "$holder" 2>/dev/null || die "Pause holder is not running: $holder"
  tmp="$dir/.paused.$$"; printf 'PID=%s\nSINCE=%s\n' "$holder" "$(date +%s)" > "$tmp"; mv -f -- "$tmp" "$(pause_file "$vm")"
  if ! ( quiesce_mirrors "$vm" "$state" ); then
    rm -f -- "$(pause_file "$vm")"; die "Could not pause replication for $vm"
  fi
  printf '{"vm":"%s","configured":true,"paused":true,"holder":%s}\n' "$vm" "$holder"
}

unpause_replication(){
  local vm=${1:?VM required} dir
  validate_vm_name "$vm"; dir=$(job_dir "$vm")
  # Drop the marker first so the daemon retries even if this resume fails.
  rm -f -- "$(pause_file "$vm")"
  [[ -r $dir/state.conf ]] || { printf '{"vm":"%s","configured":false,"paused":false}\n' "$vm"; return 0; }
  resume_replication "$vm"
  status_replication "$vm"
}

stop_replication(){
  local vm=${1:?VM required} quiet=${2:-false} dir state idx job meta
  validate_vm_name "$vm"; dir=$(job_dir "$vm"); state="$dir/state.conf"
  [[ -r $state ]] || { $quiet || printf '{"stopped":true,"vm":"%s"}\n' "$vm"; return; }
  load_state "$state"
  while IFS= read -r idx; do
    eval "job=\${DISK_${idx}_JOB:-}"; eval "meta=\${DISK_${idx}_META:-}"
    [[ $(vm_state "$vm") == running && -n $job ]] && cancel_job "$vm" "$job"
    [[ -z $meta ]] || refresh_meta "$meta" false
  done < <(state_disk_indexes "$state")
  remove_all_bitmaps "$vm"
  rm -rf -- "$dir"
  $quiet || printf '{"stopped":true,"vm":"%s","replica_retained":true}\n' "$vm"
}

list_replications(){
  local d first=true
  printf '['
  for d in "$JOB_ROOT"/*; do
    [[ -d $d ]] || continue
    $first || printf ','; first=false
    status_replication "$(basename "$d")" | tr -d '\n'
  done
  printf ']\n'
}

resume_all(){
  local d vm
  for d in "$JOB_ROOT"/*; do
    [[ -d $d ]] || continue
    vm=$(basename "$d")
    [[ -f $(vm_conf "$vm") && $(vm_state "$vm") == running ]] || continue
    ( lock_replication "$vm" 0 || exit 0; resume_replication "$vm" ) || echo "Could not resume replication for $vm" >&2
  done
}

find_replica_meta(){
  local wanted=$1 meta owner vm idx
  valid_replica_id "$wanted"; shopt -s nullglob
  for meta in "$BACKPLANE_ROOT"/peers/*/replicas/*/disk*.meta; do
    [[ -f $meta ]] || continue
    OWNER=''; VM=''; DISK_INDEX=''; BYTES=''; FILE_NAME=''; ACTIVE=''; RECOVERABLE=''; UPDATED=''
    read_meta "$meta"; owner=$OWNER; vm=$VM; idx=$DISK_INDEX
    [[ -n $owner && -n $vm && -n $idx ]] || continue
    if [[ $(replica_id "$owner" "$vm" "$idx") == "$wanted" ]]; then printf '%s\n' "$meta"; shopt -u nullglob; return 0; fi
  done
  shopt -u nullglob; return 1
}

replica_show(){
  local id=${1:?id required} meta now active=false allocated=0
  meta=$(find_replica_meta "$id") || die 'Replica not found'
  OWNER=''; VM=''; DISK_INDEX=''; BYTES=''; FILE_NAME=''; ACTIVE=''; RECOVERABLE=''; UPDATED=''
  read_meta "$meta"
  validate_vm_name "$VM"; validate_int "$DISK_INDEX"; validate_positive_int "$BYTES"; [[ $FILE_NAME =~ ^[A-Za-z0-9._-]+$ ]] || die 'Replica metadata has an invalid file name'
  local FILE="$(dirname "$meta")/$FILE_NAME"
  now=$(date +%s)
  if [[ $ACTIVE == true && $UPDATED =~ ^[0-9]+$ && $((now-UPDATED)) -le $STALE_SECONDS ]]; then active=true; fi
  [[ -f $FILE ]] && allocated=$(( $(du -k "$FILE" 2>/dev/null | awk '{print $1+0}') * 1024 ))
  printf '{"id":"%s","owner":"%s","vm":"%s","disk_index":%s,"bytes":%s,"allocated_bytes":%s,"active":%s,"recoverable":%s,"nbd_running":false,"websocket_running":%s,"backplane":true,"transport":"nfs4-wss-backplane","replica":"%s"}\n' \
    "$id" "$(json_escape "$OWNER")" "$(json_escape "$VM")" "$DISK_INDEX" "$BYTES" "$allocated" "$active" "$RECOVERABLE" "$active" "$(json_escape "$FILE")"
}

replica_list(){
  local meta owner vm idx id first=true
  printf '['; shopt -s nullglob
  for meta in "$BACKPLANE_ROOT"/peers/*/replicas/*/disk*.meta; do
    [[ -f $meta ]] || continue
    OWNER=''; VM=''; DISK_INDEX=''; BYTES=''; FILE_NAME=''; ACTIVE=''; RECOVERABLE=''; UPDATED=''
    read_meta "$meta"; owner=$OWNER; vm=$VM; idx=$DISK_INDEX
    [[ -n $owner && -n $vm && $idx =~ ^[0-9]+$ ]] || continue
    id=$(replica_id "$owner" "$vm" "$idx")
    $first || printf ','; first=false
    replica_show "$id" | tr -d '\n'
  done
  shopt -u nullglob; printf ']\n'
}

restore_replica_to_source(){
  local vm=${1:?VM required} peer=${2:?peer required} dir state configured_peer='' owner remote conf idx meta replica target format expected actual now active had_state=false
  local token=$$ i swapped=0 metadata_count=0 stage rollback
  local -a indexes=() replicas=() targets=() stages=() rollbacks=() formats=()
  restore_cleanup(){
    local j
    for ((j=0; j<${#targets[@]}; j++)); do
      if [[ -e ${rollbacks[$j]:-} ]]; then
        rm -f -- "${targets[$j]}" 2>/dev/null || true
        mv -- "${rollbacks[$j]}" "${targets[$j]}" 2>/dev/null || true
      fi
    done
    for stage in "${stages[@]}"; do [[ -z $stage ]] || rm -f -- "$stage" 2>/dev/null || true; done
  }
  trap restore_cleanup EXIT
  validate_vm_name "$vm"; valid_peer_id "$peer"; peer=${peer,,}
  require_vm "$vm"
  [[ $(vm_state "$vm") == stopped ]] || die "VM must be stopped before restoring a continuous replica: $vm"
  need_cmd "$BACKPLANECTL"; need_cmd "$PEERCTL"; need_cmd "$QEMU_IMG"

  dir=$(job_dir "$vm"); state="$dir/state.conf"
  if [[ -r $state ]]; then
    lock_replication "$vm"
    load_state "$state"; configured_peer=${PEER,,}; had_state=true
    [[ $configured_peer == "$peer" ]] || die "Replication for $vm is configured to a different peer"
    # Keep the relationship configured. Because the VM is stopped there is no
    # QEMU writer; after recovery the next VM start will re-establish the mirror.
  fi

  "$BACKPLANECTL" connect "$peer" >/dev/null
  remote=$("$BACKPLANECTL" path "$peer" replicas "$vm")
  [[ $remote == /* && -d $remote ]] || die 'Peer backplane replica directory is unavailable'
  owner=$("$PEERCTL" identity | sed -n 's/.*"node_id":"\([a-fA-F0-9]*\)".*/\1/p' | head -n1)
  valid_peer_id "$owner"; owner=${owner,,}
  conf=$(vm_conf "$vm")
  mapfile -t indexes < <(indexes_for "$conf" DISK)
  ((${#indexes[@]} > 0)) || die "VM has no configured disks: $vm"

  shopt -s nullglob
  local all_meta=("$remote"/disk*.meta)
  shopt -u nullglob
  metadata_count=${#all_meta[@]}
  ((metadata_count == ${#indexes[@]})) || die "Replica disk count does not match $vm; expected ${#indexes[@]}, found $metadata_count"

  # Stage and validate every restored disk before replacing any source disk.
  for idx in "${indexes[@]}"; do
    meta="$remote/disk${idx}.meta"
    [[ -r $meta ]] || die "Replica metadata is missing for $vm disk $idx"
    OWNER=''; VM=''; DISK_INDEX=''; BYTES=''; FILE_NAME=''; ACTIVE=''; UPDATED=''; read_meta "$meta"
    [[ ${OWNER,,} == "$owner" && $VM == "$vm" && $DISK_INDEX == "$idx" ]] || die "Replica metadata does not belong to this source VM: disk $idx"
    [[ $RECOVERABLE == true ]] || die "Replica for $vm disk $idx has never completed initial synchronization and cannot be restored"
    validate_positive_int "$BYTES"
    [[ $FILE_NAME =~ ^[A-Za-z0-9._-]+$ ]] || die "Replica metadata has an invalid file name for disk $idx"
    replica="$(dirname "$meta")/$FILE_NAME"
    [[ -f $replica ]] || die "Replica disk is missing: $replica"
    now=$(date +%s); active=false
    if [[ $ACTIVE == true && $UPDATED =~ ^[0-9]+$ && $((now-UPDATED)) -le $STALE_SECONDS ]]; then active=true; fi
    $active && ! $had_state && die "Replica for $vm disk $idx is still active on another source; stop replication before restoring"
    actual=$(image_virtual_size "$replica"); [[ $actual == "$BYTES" ]] || die "Replica size mismatch for $vm disk $idx"

    target=$(vm_disk_path_index "$vm" "$idx")
    [[ -f $target ]] || die "Source disk is missing: $target"
    format=$(cfg_get_file "$conf" "DISK_${idx}_FORMAT" qcow2)
    [[ $format == qcow2 || $format == raw || $format == vmdk ]] || die "Unsupported source disk format for restore: $format"
    stage="${target}.replica-restore.${token}"
    rollback="${target}.pre-replica-restore.${token}"
    rm -f -- "$stage" "$rollback"
    "$QEMU_IMG" convert -f qcow2 -O "$format" "$replica" "$stage" || { rm -f -- "$stage"; die "Could not materialize replica for $vm disk $idx"; }
    actual=$(image_virtual_size "$stage"); [[ $actual == "$BYTES" ]] || { rm -f -- "$stage"; die "Restored disk validation failed for $vm disk $idx"; }
    chown --reference="$target" "$stage" 2>/dev/null || true
    chmod --reference="$target" "$stage" 2>/dev/null || true
    replicas+=("$replica"); targets+=("$target"); stages+=("$stage"); rollbacks+=("$rollback"); formats+=("$format")
  done

  # No process can be writing the replicas while the source VM is stopped.
  # Mark their storage-side metadata inactive for accurate inventory display.
  if $had_state; then
    for idx in "${indexes[@]}"; do refresh_meta "$remote/disk${idx}.meta" false; done
  fi

  # All disks have been staged. Swap them in one at a time while retaining the
  # originals under same-filesystem rollback names. If any swap fails, put all
  # originals back before returning an error.
  for ((i=0; i<${#targets[@]}; i++)); do
    if ! mv -- "${targets[$i]}" "${rollbacks[$i]}"; then
      for ((i=0; i<swapped; i++)); do rm -f -- "${targets[$i]}"; mv -- "${rollbacks[$i]}" "${targets[$i]}" || true; done
      for stage in "${stages[@]}"; do rm -f -- "$stage"; done
      die "Could not preserve the original source disk during replica restore"
    fi
    if ! mv -- "${stages[$i]}" "${targets[$i]}"; then
      mv -- "${rollbacks[$i]}" "${targets[$i]}" || true
      for ((i=0; i<swapped; i++)); do rm -f -- "${targets[$i]}"; mv -- "${rollbacks[$i]}" "${targets[$i]}" || true; done
      for stage in "${stages[@]}"; do rm -f -- "$stage"; done
      die "Could not install the restored replica disk; original disks were restored"
    fi
    swapped=$((swapped+1))
  done

  for rollback in "${rollbacks[@]}"; do rm -f -- "$rollback"; done
  stages=(); rollbacks=(); trap - EXIT
  printf '{"restored":true,"vm":"%s","peer_id":"%s","disk_count":%s,"source":"continuous-replica"}\n' \
    "$(json_escape "$vm")" "$peer" "${#targets[@]}"
}

replica_purge(){
  local id=${1:?id required} delete_file=${2:-false} meta now active=false replica
  validate_bool "$delete_file"; meta=$(find_replica_meta "$id") || die 'Replica not found'
  OWNER=''; VM=''; DISK_INDEX=''; BYTES=''; FILE_NAME=''; ACTIVE=''; UPDATED=''; read_meta "$meta"
  [[ $FILE_NAME =~ ^[A-Za-z0-9._-]+$ ]] || die 'Replica metadata has an invalid file name'
  local FILE="$(dirname "$meta")/$FILE_NAME"
  now=$(date +%s)
  [[ $ACTIVE != true || ! $UPDATED =~ ^[0-9]+$ || $((now-UPDATED)) -gt $STALE_SECONDS ]] || die 'Cannot purge an active replica'
  replica=$FILE; rm -f -- "$meta"; $delete_file && rm -f -- "$replica"
  printf '{"purged":true,"deleted_file":%s,"id":"%s","replica":"%s"}\n' "$delete_file" "$id" "$(json_escape "$replica")"
}

revoke_peer(){
  local peer=${1:?peer required} _owner=${2:-} d state vm
  valid_peer_id "$peer"; peer=${peer,,}
  for d in "$JOB_ROOT"/*; do
    [[ -d $d ]] || continue; state="$d/state.conf"; [[ -r $state ]] || continue
    PEER=''; source "$state"; [[ $PEER == "$peer" ]] || continue
    vm=$(basename "$d"); stop_replication "$vm" true || true
  done
}

daemon_cleanup(){
  local d vm state idx meta
  for d in "$JOB_ROOT"/*; do
    [[ -d $d ]] || continue; vm=$(basename "$d"); state="$d/state.conf"; [[ -r $state ]] || continue
    # Leave replicas exact and changes tracked, so the service restart (an
    # upgrade, for example) catches up instead of resynchronising in full.
    ( quiesce_mirrors "$vm" "$state" ) || err "Could not quiesce replication for $vm"
    load_state "$state"
    while IFS= read -r idx; do
      eval "meta=\${DISK_${idx}_META:-}"
      [[ -z $meta ]] || refresh_meta "$meta" false
    done < <(state_disk_indexes "$state")
  done
}
suspend(){ daemon_cleanup; printf '{"suspended":true}\n'; }
daemon(){
  ensure_dirs; trap 'daemon_cleanup; exit 0' TERM INT
  while :; do resume_all; sleep "$DAEMON_INTERVAL" & wait $!; done
}

case ${1:-help} in
  start) shift; start_replication "$@";;
  resume) shift; lock_replication "${1:?VM required}"; resume_replication "$@"; status_replication "$1";;
  resume-all) resume_all;;
  status) shift; status_replication "$@";;
  stop) shift; lock_replication "${1:?VM required}"; stop_replication "$@";;
  pause) shift; lock_replication "${1:?VM required}"; pause_replication "$@";;
  unpause) shift; lock_replication "${1:?VM required}"; unpause_replication "$@";;
  list) list_replications;;
  replica-show) shift; replica_show "$@";;
  replica-list) replica_list;;
  replica-purge) shift; replica_purge "$@";;
  restore) shift; lock_replication "${1:?VM required}"; restore_replica_to_source "$@";;
  revoke-peer) shift; revoke_peer "$@";;
  suspend) suspend;;
  daemon) daemon;;
  help|-h|--help) echo 'replicationctl start VM PEER_ID [BYTES_PER_SEC] | resume VM | status VM | stop VM | pause VM HOLDER_PID | unpause VM | list | replica-list | replica-show ID | replica-purge ID [true|false] | restore VM PEER_ID | daemon';;
  *) die "Unknown replication command: ${1:-}";;
esac
