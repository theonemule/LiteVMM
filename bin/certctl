#!/usr/bin/env bash
# LiteVMM HTTPS certificate lifecycle: Let's Encrypt, CSR workflow, and direct PEM import.
set -Eeuo pipefail
VMAPI_CONFIG=${VMAPI_CONFIG:-/etc/vmapi/vmapi.conf}
[[ -r "$VMAPI_CONFIG" ]] && source "$VMAPI_CONFIG"

VMAPI_HTTP_PORT=${VMAPI_HTTP_PORT:-5186}
VMAPI_HTTPS_PORT=${VMAPI_HTTPS_PORT:-5187}
VMAPI_TLS_ENABLED=${VMAPI_TLS_ENABLED:-false}
VMAPI_TLS_DISABLED_EXPLICITLY=${VMAPI_TLS_DISABLED_EXPLICITLY:-false}
VMAPI_TLS_RELOAD_REQUIRED=${VMAPI_TLS_RELOAD_REQUIRED:-false}
VMAPI_TLS_TRANSPORT=${VMAPI_TLS_TRANSPORT:-replace}
VMAPI_TLS_MODE=${VMAPI_TLS_MODE:-none}
VMAPI_TLS_DOMAIN=${VMAPI_TLS_DOMAIN:-}
VMAPI_TLS_CERT_FILE=${VMAPI_TLS_CERT_FILE:-}
VMAPI_TLS_KEY_FILE=${VMAPI_TLS_KEY_FILE:-}
VMAPI_TLS_CSR_FILE=${VMAPI_TLS_CSR_FILE:-}
VMAPI_TLS_CSR_KEY_FILE=${VMAPI_TLS_CSR_KEY_FILE:-}
VMAPI_TLS_CSR_DOMAIN=${VMAPI_TLS_CSR_DOMAIN:-}
TLS_ROOT=${VMAPI_TLS_ROOT:-/etc/vmapi/tls}
VMAPI_TLS_CA_CERT_FILE=${VMAPI_TLS_CA_CERT_FILE:-$TLS_ROOT/litevmm-root-ca.crt}
VMAPI_TLS_CA_KEY_FILE=${VMAPI_TLS_CA_KEY_FILE:-$TLS_ROOT/litevmm-root-ca.key}
LE_ROOT=${VMAPI_LETSENCRYPT_ROOT:-/etc/letsencrypt/live}
NGINX_SITE=${VMAPI_NGINX_SITE:-/etc/nginx/sites-available/vmapi}
LIGHTTPD_TLS_CONF=${VMAPI_LIGHTTPD_TLS_CONF:-/etc/lighttpd/conf.d/vmapi-tls.conf}
LIGHTTPD_PEM=${VMAPI_LIGHTTPD_PEM:-/etc/lighttpd/vmapi-tls.pem}
LIGHTTPD_MAIN_CONF=${VMAPI_LIGHTTPD_MAIN_CONF:-/etc/lighttpd/lighttpd.conf}
CERTBOT_CONFIG_DIR=${VMAPI_CERTBOT_CONFIG_DIR:-}
CERTBOT_WORK_DIR=${VMAPI_CERTBOT_WORK_DIR:-}
CERTBOT_LOGS_DIR=${VMAPI_CERTBOT_LOGS_DIR:-}

die(){ printf 'ERROR: %s\n' "$*" >&2; exit 1; }
json_escape(){ local s=${1-}; s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\r'/\\r}; s=${s//$'\t'/\\t}; printf '%s' "$s"; }
valid_domain(){ [[ ${1:-} =~ ^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$ && ${1:-} == *.* ]] || die 'Invalid DNS name'; }
is_ipv4(){
  local value=${1:-} a b c d x
  IFS=. read -r a b c d <<< "$value"
  [[ -n $a && -n $b && -n $c && -n $d && $value != *.*.*.*.* ]] || return 1
  for x in "$a" "$b" "$c" "$d"; do
    [[ $x =~ ^[0-9]{1,3}$ ]] || return 1
    ((10#$x <= 255)) || return 1
  done
}
valid_cert_host(){
  local value=${1:-}
  is_ipv4 "$value" && return 0
  [[ $value =~ ^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$ ]] || die 'Invalid certificate DNS name or IPv4 address'
}
san_entry(){ is_ipv4 "$1" && printf 'IP:%s' "$1" || printf 'DNS:%s' "$1"; }
valid_email(){ [[ ${1:-} =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] || die 'Invalid email address'; }
valid_key_type(){ [[ ${1:-} =~ ^(rsa2048|rsa4096|ec256)$ ]] || die 'key_type must be rsa2048, rsa4096, or ec256'; }
safe_dn(){ [[ ${#1} -le 128 && $1 != *$'\n'* && $1 != *$'\r'* ]] || die 'CSR subject field is invalid'; }
require_root(){ [[ $EUID -eq 0 ]] || die 'Certificate changes require root privileges'; }
need(){ command -v "$1" >/dev/null 2>&1 || die "Required command is missing: $1"; }
valid_port(){ [[ ${1:-} =~ ^[0-9]{1,5}$ ]] && ((10#$1 >= 1 && 10#$1 <= 65535)); }
valid_transport(){ [[ ${1:-} =~ ^(replace|dual|redirect)$ ]] || die 'TLS transport must be replace, dual, or redirect'; }

set_config(){
  local key=$1 value=${2-} tmp target=$VMAPI_CONFIG
  [[ $key =~ ^VMAPI_[A-Z0-9_]+$ ]] || die 'Invalid configuration key'
  [[ $value != *$'\n'* && $value != *$'\r'* ]] || die 'Invalid configuration value'
  # Container installs keep /etc/vmapi/vmapi.conf as a symlink into the
  # persistent /var/lib/vmapi volume. Write to the resolved target rather than
  # replacing the symlink with an ephemeral regular file.
  if [[ -L $VMAPI_CONFIG ]]; then
    target=$(readlink -f -- "$VMAPI_CONFIG") || die "Could not resolve persistent configuration: $VMAPI_CONFIG"
  fi
  tmp=$(mktemp)
  if [[ -r $target ]]; then
    awk -v k="$key" -v v="$value" 'BEGIN{done=0} index($0,k"=")==1 {if(!done){print k"="v;done=1};next} {print} END{if(!done)print k"="v}' "$target" > "$tmp"
  else
    printf '%s=%s\n' "$key" "$value" > "$tmp"
  fi
  install -m 0644 "$tmp" "$target"; rm -f "$tmp"
}

ensure_tls_root(){ require_root; install -d -m 0700 "$TLS_ROOT"; }
detect_platform(){
  if command -v nginx >/dev/null 2>&1 && [[ -f $NGINX_SITE ]]; then printf debian
  elif command -v lighttpd >/dev/null 2>&1; then printf alpine
  else printf unsupported; fi
}

validate_key(){
  local key=$1
  [[ -s $key ]] || die 'Private key is empty'
  openssl pkey -in "$key" -check -noout >/dev/null 2>&1 || die 'Private key is invalid or encrypted with an unsupported passphrase'
}
validate_cert(){
  local cert=$1
  [[ -s $cert ]] || die 'Certificate is empty'
  openssl x509 -in "$cert" -noout >/dev/null 2>&1 || die 'Certificate is not a valid PEM X.509 certificate'
}
validate_csr(){
  local csr=$1
  [[ -s $csr ]] || die 'CSR is empty'
  openssl req -in "$csr" -verify -noout >/dev/null 2>&1 || die 'CSR is invalid'
}
pubkey_digest_key(){ openssl pkey -in "$1" -pubout 2>/dev/null | openssl sha256 | awk '{print $2}'; }
pubkey_digest_cert(){ openssl x509 -in "$1" -pubkey -noout 2>/dev/null | openssl pkey -pubin -outform PEM 2>/dev/null | openssl sha256 | awk '{print $2}'; }
pubkey_digest_csr(){ openssl req -in "$1" -pubkey -noout 2>/dev/null | openssl pkey -pubin -outform PEM 2>/dev/null | openssl sha256 | awk '{print $2}'; }
validate_pair(){
  local cert=$1 key=$2 a b
  validate_cert "$cert"; validate_key "$key"
  a=$(pubkey_digest_cert "$cert"); b=$(pubkey_digest_key "$key")
  [[ -n $a && $a == "$b" ]] || die 'Certificate and private key do not match'
}

rewrite_nginx(){
  local file="$NGINX_SITE" tls_include=${VMAPI_NGINX_TLS_CONF:-${NGINX_SITE%/*}/vmapi-tls.conf} ssl='' authority
  [[ -f $file ]] || die 'LiteVMM Nginx configuration is missing'
  valid_transport "$VMAPI_TLS_TRANSPORT"
  valid_port "$VMAPI_HTTP_PORT" || die 'Invalid HTTP port'
  valid_port "$VMAPI_HTTPS_PORT" || die 'Invalid HTTPS port'
  if [[ $VMAPI_TLS_TRANSPORT != replace ]]; then
    [[ $VMAPI_HTTPS_PORT != "$VMAPI_HTTP_PORT" ]] || die 'HTTPS port must differ from HTTP port when keeping the HTTP listener'
  fi

  # Keep one stable HTTP server block and place the TLS listener/directives in
  # a generated server-context include. This lets one Nginx server serve both
  # HTTP and HTTPS without duplicating all LiteVMM locations.
  grep -Fq "include $tls_include;" "$file" || sed -i "/server_name _;/a\\    include $tls_include;" "$file"
  [[ $VMAPI_TLS_ENABLED == true && $VMAPI_TLS_TRANSPORT == replace ]] && ssl=' ssl'
  sed -i -E "0,/listen 127\\.0\\.0\\.1:[0-9]+( ssl)?;/s//listen 127.0.0.1:${VMAPI_HTTP_PORT}${ssl};/" "$file"
  : > "$tls_include"
  if [[ $VMAPI_TLS_ENABLED == true ]]; then
    [[ -r $VMAPI_TLS_CERT_FILE && -r $VMAPI_TLS_KEY_FILE ]] || die 'Certificate files are missing'
    if [[ $VMAPI_TLS_TRANSPORT != replace ]]; then
      printf 'listen 127.0.0.1:%s ssl;\n' "$VMAPI_HTTPS_PORT" >> "$tls_include"
    fi
    printf 'ssl_certificate %s;\nssl_certificate_key %s;\nssl_protocols TLSv1.2 TLSv1.3;\nssl_session_cache shared:VMAPITLS:10m;\n' "$VMAPI_TLS_CERT_FILE" "$VMAPI_TLS_KEY_FILE" >> "$tls_include"
    if [[ $VMAPI_TLS_TRANSPORT == redirect ]]; then
      [[ -n $VMAPI_TLS_DOMAIN ]] || die 'Redirect mode requires a certificate DNS name or IPv4 address'
      authority=$VMAPI_TLS_DOMAIN; [[ $VMAPI_HTTPS_PORT == 443 ]] || authority+=":$VMAPI_HTTPS_PORT"
      printf 'if ($server_port = %s) { return 308 https://%s$request_uri; }\n' "$VMAPI_HTTP_PORT" "$authority" >> "$tls_include"
    fi
  fi
  nginx -t >/dev/null
}

rewrite_lighttpd(){
  local conf="$LIGHTTPD_TLS_CONF" pem="$LIGHTTPD_PEM" authority
  valid_transport "$VMAPI_TLS_TRANSPORT"
  valid_port "$VMAPI_HTTP_PORT" || die 'Invalid HTTP port'
  valid_port "$VMAPI_HTTPS_PORT" || die 'Invalid HTTPS port'
  if [[ $VMAPI_TLS_TRANSPORT != replace ]]; then
    [[ $VMAPI_HTTPS_PORT != "$VMAPI_HTTP_PORT" ]] || die 'HTTPS port must differ from HTTP port when keeping the HTTP listener'
  fi
  if [[ $VMAPI_TLS_ENABLED == true ]]; then
    [[ -r $VMAPI_TLS_CERT_FILE && -r $VMAPI_TLS_KEY_FILE ]] || die 'Certificate files are missing'
    cat "$VMAPI_TLS_KEY_FILE" "$VMAPI_TLS_CERT_FILE" > "$pem"; chown root:lighttpd "$pem" 2>/dev/null || true; chmod 0640 "$pem"
    case "$VMAPI_TLS_TRANSPORT" in
      replace)
        cat > "$conf" <<CFG
server.modules += ( "mod_openssl" )
ssl.engine = "enable"
ssl.pemfile = "$pem"
CFG
        ;;
      dual|redirect)
        cat > "$conf" <<CFG
server.modules += ( "mod_openssl" )
\$SERVER["socket"] == ":$VMAPI_HTTPS_PORT" {
  ssl.engine = "enable"
  ssl.pemfile = "$pem"
}
CFG
        if [[ $VMAPI_TLS_TRANSPORT == redirect ]]; then
          [[ -n $VMAPI_TLS_DOMAIN ]] || die 'Redirect mode requires a certificate DNS name or IPv4 address'
          authority=$VMAPI_TLS_DOMAIN; [[ $VMAPI_HTTPS_PORT == 443 ]] || authority+=":$VMAPI_HTTPS_PORT"
          cat >> "$conf" <<CFG
server.modules += ( "mod_redirect" )
\$SERVER["socket"] == ":$VMAPI_HTTP_PORT" {
  # Redirect-only HTTP listener: do not challenge for Basic auth before the
  # browser can reach the authenticated HTTPS endpoint.
  auth.require = ()
  url.redirect-code = 308
  # mod_rewrite has already mapped public API paths to CGI aliases by the time
  # mod_redirect evaluates them. Map those aliases back to public URLs.
  url.redirect = (
    "^/api[.]cgi/(.*)\$" => "https://$authority/api/\$1",
    "^/peer-api[.]cgi/(.*)\$" => "https://$authority/peer-api/\$1",
    "^/(.*)\$" => "https://$authority/\$1"
  )
}
CFG
        fi
        ;;
    esac
  else
    rm -f "$conf" "$pem"
  fi
  lighttpd -tt -f "$LIGHTTPD_MAIN_CONF" >/dev/null
}

apply_web_tls(){
  [[ $VMAPI_TLS_ENABLED != true ]] || validate_pair "$VMAPI_TLS_CERT_FILE" "$VMAPI_TLS_KEY_FILE"
  case $(detect_platform) in
    debian) rewrite_nginx;;
    alpine) rewrite_lighttpd;;
    *) die 'No supported LiteVMM web server was detected';;
  esac
}

reload_web_tls(){
  require_root
  local transport=${1:-$VMAPI_TLS_TRANSPORT} https_port=${2:-$VMAPI_HTTPS_PORT}
  valid_transport "$transport"; valid_port "$https_port" || die 'Invalid HTTPS port'
  [[ $transport == replace || $https_port != "$VMAPI_HTTP_PORT" ]] || die 'HTTPS port must differ from HTTP port when keeping HTTP enabled'
  [[ $transport != redirect || -n $VMAPI_TLS_DOMAIN ]] || die 'Redirect mode requires a certificate DNS name or IPv4 address'
  set_config VMAPI_TLS_TRANSPORT "$transport"
  set_config VMAPI_HTTPS_PORT "$https_port"
  VMAPI_TLS_TRANSPORT=$transport VMAPI_HTTPS_PORT=$https_port
  apply_web_tls
  case $(detect_platform) in
    debian)
      if command -v systemctl >/dev/null 2>&1; then
        systemctl reload nginx
      else
        nginx -s reload
      fi
      ;;
    alpine)
      local reload=${VMAPI_WEB_RELOAD:-/usr/local/bin/vmapi-web-reload}
      if [[ -x $reload ]]; then
        VMAPI_LIGHTTPD_CONF="$LIGHTTPD_MAIN_CONF" "$reload"
      elif command -v rc-service >/dev/null 2>&1; then
        rc-service lighttpd restart >/dev/null
      else
        die 'Lighttpd configuration changed but no reload helper is available'
      fi
      ;;
    *) die 'No supported LiteVMM web server was detected';;
  esac
  set_config VMAPI_TLS_RELOAD_REQUIRED false
  VMAPI_TLS_RELOAD_REQUIRED=false
  status
}

validate_ca(){
  local cert=$1
  validate_cert "$cert"
  openssl x509 -in "$cert" -noout -text 2>/dev/null | grep -q 'CA:TRUE' || die 'Certificate is not a CA certificate'
  openssl verify -CAfile "$cert" "$cert" >/dev/null 2>&1 || die 'CA certificate is not self-verifying'
}

ensure_local_ca(){
  require_root; ensure_tls_root; need openssl
  if [[ -s $VMAPI_TLS_CA_CERT_FILE || -s $VMAPI_TLS_CA_KEY_FILE ]]; then
    [[ -s $VMAPI_TLS_CA_CERT_FILE && -s $VMAPI_TLS_CA_KEY_FILE ]] || die 'Local CA is incomplete; both certificate and private key are required'
    validate_ca "$VMAPI_TLS_CA_CERT_FILE"; validate_key "$VMAPI_TLS_CA_KEY_FILE"
    [[ $(pubkey_digest_cert "$VMAPI_TLS_CA_CERT_FILE") == "$(pubkey_digest_key "$VMAPI_TLS_CA_KEY_FILE")" ]] || die 'Local CA certificate and private key do not match'
    return 0
  fi

  local ca_name cfg host
  host=$(hostname -s 2>/dev/null || hostname 2>/dev/null || printf litevmm)
  host=${host//[^A-Za-z0-9._-]/-}
  ca_name="LiteVMM Root CA - $host"
  openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:prime256v1 -out "$VMAPI_TLS_CA_KEY_FILE" >/dev/null 2>&1
  chmod 0600 "$VMAPI_TLS_CA_KEY_FILE"
  cfg="$TLS_ROOT/.ca.$$.cnf"
  cat > "$cfg" <<CFG
[req]
prompt = no
distinguished_name = dn
x509_extensions = v3_ca
[dn]
CN = $ca_name
O = LiteVMM
[v3_ca]
basicConstraints = critical,CA:TRUE,pathlen:0
keyUsage = critical,keyCertSign,cRLSign
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always
CFG
  openssl req -x509 -new -sha256 -days 36500 -key "$VMAPI_TLS_CA_KEY_FILE" -out "$VMAPI_TLS_CA_CERT_FILE" -config "$cfg"
  rm -f "$cfg"
  chmod 0644 "$VMAPI_TLS_CA_CERT_FILE"
  validate_ca "$VMAPI_TLS_CA_CERT_FILE"
  set_config VMAPI_TLS_CA_CERT_FILE "$VMAPI_TLS_CA_CERT_FILE"
  set_config VMAPI_TLS_CA_KEY_FILE "$VMAPI_TLS_CA_KEY_FILE"
}

local_ca_metadata(){
  local available=false fingerprint='' subject='' expires=''
  if [[ -s $VMAPI_TLS_CA_CERT_FILE ]]; then
    available=true
    fingerprint=$(openssl x509 -in "$VMAPI_TLS_CA_CERT_FILE" -noout -fingerprint -sha256 2>/dev/null | sed 's/^sha256 Fingerprint=//' || true)
    subject=$(openssl x509 -in "$VMAPI_TLS_CA_CERT_FILE" -noout -subject 2>/dev/null | sed 's/^subject=//' || true)
    expires=$(openssl x509 -in "$VMAPI_TLS_CA_CERT_FILE" -noout -enddate 2>/dev/null | sed 's/^notAfter=//' || true)
  fi
  printf '"local_ca_available":%s,"local_ca_certificate":"%s","local_ca_fingerprint_sha256":"%s","local_ca_subject":"%s","local_ca_expires":"%s"' \
    "$available" "$(json_escape "$VMAPI_TLS_CA_CERT_FILE")" "$(json_escape "$fingerprint")" "$(json_escape "$subject")" "$(json_escape "$expires")"
}

self_sign(){
  require_root; ensure_tls_root; need openssl
  local host=${1:?DNS name or IPv4 address required} sans=${2-} days=${3:-825}
  valid_cert_host "$host"
  [[ $days =~ ^[0-9]+$ ]] && ((days >= 1 && days <= 36500)) || die 'days must be between 1 and 36500'
  ensure_local_ca

  local key="$TLS_ROOT/local-endpoint.key" csr="$TLS_ROOT/local-endpoint.csr" cert="$TLS_ROOT/local-endpoint.crt"
  local reqcfg="$TLS_ROOT/.selfsign-req.$$.cnf" extcfg="$TLS_ROOT/.selfsign-ext.$$.cnf" san_list item entry
  san_list=$(san_entry "$host")
  IFS=',' read -ra items <<< "$sans"
  for item in "${items[@]}"; do
    item=${item//[[:space:]]/}
    [[ -z $item ]] && continue
    valid_cert_host "$item"
    entry=$(san_entry "$item")
    [[ ",$san_list," == *",$entry,"* ]] || san_list+=",$entry"
  done

  openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:prime256v1 -out "$key" >/dev/null 2>&1
  chmod 0600 "$key"
  cat > "$reqcfg" <<CFG
[req]
prompt = no
distinguished_name = dn
req_extensions = req_ext
[dn]
CN = $host
O = LiteVMM
[req_ext]
subjectAltName = $san_list
CFG
  cat > "$extcfg" <<CFG
[v3_server]
basicConstraints = critical,CA:FALSE
keyUsage = critical,digitalSignature,keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = $san_list
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer
CFG
  openssl req -new -key "$key" -out "$csr" -config "$reqcfg"
  openssl x509 -req -in "$csr" -CA "$VMAPI_TLS_CA_CERT_FILE" -CAkey "$VMAPI_TLS_CA_KEY_FILE" -CAcreateserial \
    -out "$cert" -days "$days" -sha256 -extfile "$extcfg" -extensions v3_server >/dev/null 2>&1
  rm -f "$reqcfg" "$extcfg" "$csr" "$VMAPI_TLS_CA_CERT_FILE.srl"
  chmod 0644 "$cert"
  validate_pair "$cert" "$key"
  openssl verify -CAfile "$VMAPI_TLS_CA_CERT_FILE" "$cert" >/dev/null 2>&1 || die 'Generated endpoint certificate does not validate against the local CA'
  activate local-ca "$host" "$cert" "$key" ''
  status
}

show_ca(){
  [[ -s $VMAPI_TLS_CA_CERT_FILE ]] || die 'No LiteVMM local CA certificate is available'
  validate_ca "$VMAPI_TLS_CA_CERT_FILE"
  cat "$VMAPI_TLS_CA_CERT_FILE"
}

cert_metadata(){
  local expiry='' subject='' issuer='' serial='' fingerprint='' not_before='' sans=''
  if [[ -n $VMAPI_TLS_CERT_FILE && -r $VMAPI_TLS_CERT_FILE ]]; then
    expiry=$(openssl x509 -in "$VMAPI_TLS_CERT_FILE" -noout -enddate 2>/dev/null | sed 's/^notAfter=//' || true)
    not_before=$(openssl x509 -in "$VMAPI_TLS_CERT_FILE" -noout -startdate 2>/dev/null | sed 's/^notBefore=//' || true)
    subject=$(openssl x509 -in "$VMAPI_TLS_CERT_FILE" -noout -subject 2>/dev/null | sed 's/^subject=//' || true)
    issuer=$(openssl x509 -in "$VMAPI_TLS_CERT_FILE" -noout -issuer 2>/dev/null | sed 's/^issuer=//' || true)
    serial=$(openssl x509 -in "$VMAPI_TLS_CERT_FILE" -noout -serial 2>/dev/null | sed 's/^serial=//' || true)
    fingerprint=$(openssl x509 -in "$VMAPI_TLS_CERT_FILE" -noout -fingerprint -sha256 2>/dev/null | sed 's/^sha256 Fingerprint=//' || true)
    sans=$(openssl x509 -in "$VMAPI_TLS_CERT_FILE" -noout -ext subjectAltName 2>/dev/null | tail -n +2 | tr -d '\n ' || true)
  fi
  printf '"expires":"%s","not_before":"%s","subject":"%s","issuer":"%s","serial":"%s","fingerprint_sha256":"%s","sans":"%s"' \
    "$(json_escape "$expiry")" "$(json_escape "$not_before")" "$(json_escape "$subject")" "$(json_escape "$issuer")" "$(json_escape "$serial")" "$(json_escape "$fingerprint")" "$(json_escape "$sans")"
}

status(){
  local available=false platform csr_available=false csr_subject=''
  command -v certbot >/dev/null 2>&1 && available=true
  [[ -n $VMAPI_TLS_CSR_FILE && -r $VMAPI_TLS_CSR_FILE ]] && { csr_available=true; csr_subject=$(openssl req -in "$VMAPI_TLS_CSR_FILE" -noout -subject 2>/dev/null | sed 's/^subject=//' || true); }
  platform=$(detect_platform)
  printf '{"profile":"%s","port":%s,"https_port":%s,"certbot_available":%s,"tls_enabled":%s,"tls_disabled_explicitly":%s,"reload_required":%s,"tls_transport":"%s","mode":"%s","domain":"%s","certificate":"%s","private_key":"%s","csr":"%s","csr_key":"%s","csr_domain":"%s","csr_available":%s,"csr_subject":"%s","platform":"%s",' \
    "$(json_escape "${VMAPI_PROFILE:-unknown}")" "$VMAPI_HTTP_PORT" "$VMAPI_HTTPS_PORT" "$available" "$VMAPI_TLS_ENABLED" "$VMAPI_TLS_DISABLED_EXPLICITLY" "$VMAPI_TLS_RELOAD_REQUIRED" "$(json_escape "$VMAPI_TLS_TRANSPORT")" "$(json_escape "$VMAPI_TLS_MODE")" "$(json_escape "$VMAPI_TLS_DOMAIN")" "$(json_escape "$VMAPI_TLS_CERT_FILE")" "$(json_escape "$VMAPI_TLS_KEY_FILE")" "$(json_escape "$VMAPI_TLS_CSR_FILE")" "$(json_escape "$VMAPI_TLS_CSR_KEY_FILE")" "$(json_escape "$VMAPI_TLS_CSR_DOMAIN")" "$csr_available" "$(json_escape "$csr_subject")" "$platform"
  cert_metadata
  printf ','
  local_ca_metadata
  printf '}\n'
}

activate(){
  local mode=$1 domain=$2 cert=$3 key=$4 csr=${5-}
  validate_pair "$cert" "$key"
  set_config VMAPI_TLS_ENABLED true
  set_config VMAPI_TLS_DISABLED_EXPLICITLY false
  set_config VMAPI_TLS_RELOAD_REQUIRED true
  set_config VMAPI_TLS_MODE "$mode"
  set_config VMAPI_TLS_DOMAIN "$domain"
  set_config VMAPI_TLS_CERT_FILE "$cert"
  set_config VMAPI_TLS_KEY_FILE "$key"
  set_config VMAPI_TLS_CSR_FILE ""
  set_config VMAPI_TLS_CSR_KEY_FILE ""
  set_config VMAPI_TLS_CSR_DOMAIN ""
  VMAPI_TLS_CSR_FILE='' VMAPI_TLS_CSR_KEY_FILE='' VMAPI_TLS_CSR_DOMAIN=''
  VMAPI_TLS_ENABLED=true VMAPI_TLS_DISABLED_EXPLICITLY=false VMAPI_TLS_RELOAD_REQUIRED=true VMAPI_TLS_MODE=$mode VMAPI_TLS_DOMAIN=$domain VMAPI_TLS_CERT_FILE=$cert VMAPI_TLS_KEY_FILE=$key
  apply_web_tls
}

issue(){
  require_root
  local domain=${1:?domain required} email=${2:?email required}
  valid_domain "$domain"; valid_email "$email"; need certbot
  local -a cb_args=()
  [[ -n $CERTBOT_CONFIG_DIR ]] && cb_args+=(--config-dir "$CERTBOT_CONFIG_DIR")
  [[ -n $CERTBOT_WORK_DIR ]] && cb_args+=(--work-dir "$CERTBOT_WORK_DIR")
  [[ -n $CERTBOT_LOGS_DIR ]] && cb_args+=(--logs-dir "$CERTBOT_LOGS_DIR")
  certbot certonly "${cb_args[@]}" --standalone --non-interactive --agree-tos --keep-until-expiring --preferred-challenges http --email "$email" -d "$domain"
  local live_root="$LE_ROOT"
  [[ -n $CERTBOT_CONFIG_DIR ]] && live_root="$CERTBOT_CONFIG_DIR/live"
  local cert="$live_root/$domain/fullchain.pem" key="$live_root/$domain/privkey.pem"
  [[ -r $cert && -r $key ]] || die 'Certbot completed but the expected certificate files were not found'
  activate certbot "$domain" "$cert" "$key" ''
  status
}

renew(){
  require_root
  [[ $VMAPI_TLS_MODE == certbot && -n $VMAPI_TLS_DOMAIN ]] || die 'The active certificate is not Certbot-managed'
  need certbot
  local -a cb_args=()
  [[ -n $CERTBOT_CONFIG_DIR ]] && cb_args+=(--config-dir "$CERTBOT_CONFIG_DIR")
  [[ -n $CERTBOT_WORK_DIR ]] && cb_args+=(--work-dir "$CERTBOT_WORK_DIR")
  [[ -n $CERTBOT_LOGS_DIR ]] && cb_args+=(--logs-dir "$CERTBOT_LOGS_DIR")
  certbot renew "${cb_args[@]}" --non-interactive --cert-name "$VMAPI_TLS_DOMAIN"
  set_config VMAPI_TLS_RELOAD_REQUIRED true
  VMAPI_TLS_RELOAD_REQUIRED=true
  apply_web_tls
  status
}

generate_csr(){
  require_root; ensure_tls_root; need openssl
  local domain=${1:?domain required} sans=${2-} org=${3-} ou=${4-} country=${5-} state=${6-} locality=${7-} key_type=${8:-rsa2048}
  valid_domain "$domain"; valid_key_type "$key_type"
  for field in "$org" "$ou" "$state" "$locality"; do safe_dn "$field"; done
  [[ -z $country || $country =~ ^[A-Za-z]{2}$ ]] || die 'Country must be a two-letter code'
  local key="$TLS_ROOT/$domain.key" csr="$TLS_ROOT/$domain.csr" cfg="$TLS_ROOT/.csr.$$.cnf" san_list="DNS:$domain" item
  IFS=',' read -ra items <<< "$sans"
  for item in "${items[@]}"; do
    item=${item//[[:space:]]/}; [[ -z $item ]] && continue; valid_domain "$item"; [[ $item == "$domain" ]] || san_list+=",DNS:$item"
  done
  case "$key_type" in
    rsa2048) openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$key" >/dev/null 2>&1;;
    rsa4096) openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 -out "$key" >/dev/null 2>&1;;
    ec256) openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:prime256v1 -out "$key" >/dev/null 2>&1;;
  esac
  chmod 0600 "$key"
  cat > "$cfg" <<CFG
[req]
prompt = no
distinguished_name = dn
req_extensions = req_ext
[dn]
CN = $domain
CFG
  [[ -n $org ]] && printf 'O = %s\n' "$org" >> "$cfg"
  [[ -n $ou ]] && printf 'OU = %s\n' "$ou" >> "$cfg"
  [[ -n $country ]] && printf 'C = %s\n' "${country^^}" >> "$cfg"
  [[ -n $state ]] && printf 'ST = %s\n' "$state" >> "$cfg"
  [[ -n $locality ]] && printf 'L = %s\n' "$locality" >> "$cfg"
  cat >> "$cfg" <<CFG
[req_ext]
subjectAltName = $san_list
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
CFG
  openssl req -new -key "$key" -out "$csr" -config "$cfg"
  rm -f "$cfg"; chmod 0644 "$csr"; validate_csr "$csr"
  [[ $(pubkey_digest_key "$key") == "$(pubkey_digest_csr "$csr")" ]] || die 'Generated CSR does not match generated private key'
  set_config VMAPI_TLS_CSR_DOMAIN "$domain"
  set_config VMAPI_TLS_CSR_KEY_FILE "$key"
  set_config VMAPI_TLS_CSR_FILE "$csr"
  VMAPI_TLS_CSR_DOMAIN=$domain VMAPI_TLS_CSR_KEY_FILE=$key VMAPI_TLS_CSR_FILE=$csr
  local csr_text; csr_text=$(cat "$csr")
  printf '{"generated":true,"domain":"%s","key_type":"%s","private_key":"%s","csr_file":"%s","csr":"%s"}\n' \
    "$(json_escape "$domain")" "$key_type" "$(json_escape "$key")" "$(json_escape "$csr")" "$(json_escape "$csr_text")"
}

show_csr(){
  [[ -n $VMAPI_TLS_CSR_FILE && -r $VMAPI_TLS_CSR_FILE ]] || die 'No generated CSR is available'
  cat "$VMAPI_TLS_CSR_FILE"
}

import_signed(){
  require_root; ensure_tls_root
  local source=${1:?certificate file required}
  [[ -f $source && -r $source ]] || die 'Signed certificate file is not readable'
  (( $(stat -c %s "$source") <= 1048576 )) || die 'Certificate file exceeds 1 MiB'
  [[ -n $VMAPI_TLS_CSR_KEY_FILE && -r $VMAPI_TLS_CSR_KEY_FILE ]] || die 'No retained CSR private key is available'
  [[ -n $VMAPI_TLS_CSR_FILE && -r $VMAPI_TLS_CSR_FILE ]] || die 'No retained CSR is available'
  local domain=${VMAPI_TLS_CSR_DOMAIN:-certificate} tmp cert
  tmp="$TLS_ROOT/.signed.$$.pem"
  cert="$TLS_ROOT/$domain.crt"
  install -m 0600 "$source" "$tmp"
  validate_cert "$tmp"
  [[ $(pubkey_digest_cert "$tmp") == "$(pubkey_digest_key "$VMAPI_TLS_CSR_KEY_FILE")" ]] || { rm -f "$tmp"; die 'Signed certificate does not match the retained CSR private key'; }
  [[ $(pubkey_digest_csr "$VMAPI_TLS_CSR_FILE") == "$(pubkey_digest_key "$VMAPI_TLS_CSR_KEY_FILE")" ]] || { rm -f "$tmp"; die 'Retained CSR and private key no longer match'; }
  install -m 0644 "$tmp" "$cert"; rm -f "$tmp"
  activate imported-csr "$domain" "$cert" "$VMAPI_TLS_CSR_KEY_FILE" "$VMAPI_TLS_CSR_FILE"
  status
}

import_pair(){
  require_root; ensure_tls_root
  local cert_source=${1:?certificate file required} key_source=${2:?private key file required} domain=${3-}
  [[ -f $cert_source && -r $cert_source ]] || die 'Certificate file is not readable'
  [[ -f $key_source && -r $key_source ]] || die 'Private-key file is not readable'
  (( $(stat -c %s "$cert_source") <= 1048576 )) || die 'Certificate file exceeds 1 MiB'
  (( $(stat -c %s "$key_source") <= 1048576 )) || die 'Private-key file exceeds 1 MiB'
  local cert="$TLS_ROOT/imported.crt" key="$TLS_ROOT/imported.key" ctmp="$TLS_ROOT/.cert.$$.pem" ktmp="$TLS_ROOT/.key.$$.pem"
  install -m 0600 "$cert_source" "$ctmp"; install -m 0600 "$key_source" "$ktmp"
  validate_pair "$ctmp" "$ktmp"
  [[ -n $domain ]] && valid_domain "$domain"
  if [[ -z $domain ]]; then
    domain=$(openssl x509 -in "$ctmp" -noout -subject -nameopt RFC2253 | sed -n 's/^subject=.*CN=\([^,]*\).*$/\1/p' | head -n1)
  fi
  install -m 0644 "$ctmp" "$cert"; install -m 0600 "$ktmp" "$key"; rm -f "$ctmp" "$ktmp"
  activate imported "$domain" "$cert" "$key" ''
  status
}

disable(){
  require_root
  set_config VMAPI_TLS_ENABLED false
  set_config VMAPI_TLS_DISABLED_EXPLICITLY true
  set_config VMAPI_TLS_RELOAD_REQUIRED true
  VMAPI_TLS_ENABLED=false VMAPI_TLS_DISABLED_EXPLICITLY=true VMAPI_TLS_RELOAD_REQUIRED=true
  apply_web_tls
  reload_web_tls
}

managed_tls_file(){
  local path=${1-}
  [[ -n $path && $path == "$TLS_ROOT"/* && $path != "$VMAPI_TLS_CA_CERT_FILE" && $path != "$VMAPI_TLS_CA_KEY_FILE" ]]
}

remove_certificate(){
  require_root
  local old_mode=$VMAPI_TLS_MODE old_domain=$VMAPI_TLS_DOMAIN old_cert=$VMAPI_TLS_CERT_FILE old_key=$VMAPI_TLS_KEY_FILE
  local -a cb_args=()

  set_config VMAPI_TLS_ENABLED false
  set_config VMAPI_TLS_DISABLED_EXPLICITLY true
  set_config VMAPI_TLS_RELOAD_REQUIRED true
  set_config VMAPI_TLS_MODE none
  set_config VMAPI_TLS_DOMAIN ''
  set_config VMAPI_TLS_CERT_FILE ''
  set_config VMAPI_TLS_KEY_FILE ''
  VMAPI_TLS_ENABLED=false VMAPI_TLS_DISABLED_EXPLICITLY=true VMAPI_TLS_RELOAD_REQUIRED=true
  VMAPI_TLS_MODE=none VMAPI_TLS_DOMAIN='' VMAPI_TLS_CERT_FILE='' VMAPI_TLS_KEY_FILE=''

  # Remove TLS from the listener first. If the reload fails, do not destroy the
  # certificate files; the administrator can retry safely.
  apply_web_tls
  reload_web_tls replace "$VMAPI_HTTPS_PORT" >/dev/null

  if [[ $old_mode == certbot && -n $old_domain ]] && command -v certbot >/dev/null 2>&1; then
    [[ -n $CERTBOT_CONFIG_DIR ]] && cb_args+=(--config-dir "$CERTBOT_CONFIG_DIR")
    [[ -n $CERTBOT_WORK_DIR ]] && cb_args+=(--work-dir "$CERTBOT_WORK_DIR")
    [[ -n $CERTBOT_LOGS_DIR ]] && cb_args+=(--logs-dir "$CERTBOT_LOGS_DIR")
    certbot delete "${cb_args[@]}" --non-interactive --cert-name "$old_domain" >/dev/null 2>&1 || true
  else
    managed_tls_file "$old_cert" && rm -f -- "$old_cert" || true
    managed_tls_file "$old_key" && rm -f -- "$old_key" || true
  fi
  rm -f -- "$LIGHTTPD_PEM" 2>/dev/null || true
  status
}

case ${1:-status} in
  status) status;;
  apply) require_root; apply_web_tls; status;;
  reload) shift; reload_web_tls "$@";;
  issue) shift; issue "$@";;
  renew) renew;;
  csr-generate) shift; generate_csr "$@";;
  csr-show) show_csr;;
  import-signed) shift; import_signed "$@";;
  import-pair) shift; import_pair "$@";;
  self-sign) shift; self_sign "$@";;
  ca-show) show_ca;;
  disable) disable;;
  remove) remove_certificate;;
  *) die 'Usage: certctl status | apply | reload [replace|dual|redirect] [HTTPS_PORT] | issue DOMAIN EMAIL | renew | self-sign HOST [SANS] [DAYS] | ca-show | csr-generate DOMAIN [SANS] [ORG] [OU] [COUNTRY] [STATE] [LOCALITY] [rsa2048|rsa4096|ec256] | csr-show | import-signed CERT_FILE | import-pair CERT_FILE KEY_FILE [DOMAIN] | disable | remove';;
esac
