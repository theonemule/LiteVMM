#!/usr/bin/env bash
# Purpose: VMAPI privileged command-line component.
# Called by the CGI API or service units; environment variables may override paths for tests.
# Validate externally supplied values before passing them to host virtualization or container tools.
set -Eeuo pipefail
BRIDGE_CONFIG_ROOT=${VMAPI_BRIDGE_CONFIG_ROOT:-/etc/vmapi/bridges}
valid_bridge() { [[ ${1:-} =~ ^[A-Za-z0-9_.:-]{1,31}$ ]] || { echo "Invalid bridge name: ${1:-}" >&2; exit 2; }; }
valid_iface() { [[ ${1:-} =~ ^[A-Za-z0-9_.:-]{1,31}$ ]] || { echo "Invalid interface name: ${1:-}" >&2; exit 2; }; }
valid_vm_tap() { [[ ${1:-} =~ ^tap[0-9]{1,10}$ ]] || { echo "Invalid VM TAP name: ${1:-}" >&2; exit 2; }; }
valid_vlan() { [[ ${1:-} =~ ^[0-9]{1,4}$ ]] && (( 10#$1 >= 1 && 10#$1 <= 4094 )) || { echo "Invalid VLAN ID: ${1:-}; expected 1-4094" >&2; exit 2; }; }
valid_addr() { [[ ${1:-} =~ ^[0-9A-Fa-f:.]+/[0-9]{1,3}$ ]] || { echo "Invalid address CIDR: ${1:-}" >&2; exit 2; }; }
valid_gateway() { [[ ${1:-} =~ ^[0-9A-Fa-f:.]+$ ]] || { echo "Invalid gateway: ${1:-}" >&2; exit 2; }; }
json_escape() { local s=${1-}; s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\r'/\\r}; s=${s//$'\t'/\\t}; printf '%s' "$s"; }
ensure_qemu_bridge_allowed() {
  local br=$1
  install -d -m 0755 /etc/qemu
  touch /etc/qemu/bridge.conf
  grep -Fxq "allow $br" /etc/qemu/bridge.conf || echo "allow $br" >> /etc/qemu/bridge.conf
  getent group qemu >/dev/null && chown root:qemu /etc/qemu/bridge.conf
  chmod 0640 /etc/qemu/bridge.conf
}
bridge_config() { printf '%s/%s.conf' "$BRIDGE_CONFIG_ROOT" "$1"; }
bridge_is_persisted() { [[ -f $(bridge_config "$1") ]]; }
write_bridge_config() {
  local name=$1 mode=$2 address=$3 gateway=$4; shift 4
  local tmp
  install -d -m 0750 "$BRIDGE_CONFIG_ROOT"
  tmp=$(mktemp "$BRIDGE_CONFIG_ROOT/.bridge.XXXXXX")
  printf 'SCHEMA=1\nBRIDGE=%q\nMODE=%q\nADDRESS=%q\nGATEWAY=%q\nMEMBERS_LIST=%q\n' \
    "$name" "$mode" "$address" "$gateway" "$*" > "$tmp"
  chmod 0640 "$tmp"
  mv -f -- "$tmp" "$(bridge_config "$name")"
}
load_bridge_config() {
  local file=$1
  SCHEMA='' BRIDGE='' MODE='' ADDRESS='' GATEWAY='' MEMBERS_LIST=''
  # Only this privileged controller writes bridge definitions.
  # shellcheck source=/dev/null
  source "$file"
  [[ $SCHEMA == 1 ]] || { echo "Unsupported bridge definition in $file" >&2; return 1; }
  valid_bridge "$BRIDGE"
  [[ $MODE == manual || $MODE == static || $MODE == dhcp ]] || { echo "Invalid bridge mode in $file" >&2; return 1; }
  [[ -z $ADDRESS || $MODE == static ]] || { echo "Unexpected bridge address in $file" >&2; return 1; }
  [[ -z $ADDRESS ]] || valid_addr "$ADDRESS"
  [[ -z $GATEWAY ]] || valid_gateway "$GATEWAY"
  local raw_members member
  read -r -a raw_members <<< "$MEMBERS_LIST"
  MEMBERS=()
  for member in "${raw_members[@]}"; do
    valid_iface "$member"
    is_vm_bridge_port "$member" || MEMBERS+=("$member")
  done
}
bridge_members() {
  local br=$1 iface master
  for iface in /sys/class/net/*/brport; do
    [[ -e $iface ]] || continue
    master=$(basename "$(readlink -f "$iface/bridge" 2>/dev/null || true)")
    [[ $master == "$br" ]] && basename "$(dirname "$iface")"
  done | sort
}
is_vm_bridge_port() { [[ $1 =~ ^(tap[0-9]+|vnet[0-9]+)$ ]]; }
configured_bridge_members() {
  local br=$1 member
  if bridge_is_persisted "$br"; then
    load_bridge_config "$(bridge_config "$br")"
    printf '%s\n' "${MEMBERS[@]}"
    return
  fi
  while IFS= read -r member; do
    is_vm_bridge_port "$member" || printf '%s\n' "$member"
  done < <(bridge_members "$br")
}
clear_iface_network() {
  local iface=$1
  if command -v udhcpc >/dev/null 2>&1; then
    udhcpc -R -n -q -i "$iface" >/dev/null 2>&1 || true
  fi
  while IFS= read -r address; do
    [[ -n $address ]] || continue
    ip address del "$address" dev "$iface" 2>/dev/null || true
  done < <(ip -o addr show dev "$iface" scope global 2>/dev/null | awk '{print $4}')
  ip route flush dev "$iface" 2>/dev/null || true
}
default_gateway_for() {
  local iface=$1
  ip route show default dev "$iface" 2>/dev/null | awk 'NR==1 {print $3; exit}'
}
first_global_address_for() {
  local iface=$1
  ip -o addr show dev "$iface" scope global 2>/dev/null | awk 'NR==1 {print $4; exit}'
}
ensure_bridge_route() {
  local name=$1 gateway=$2
  [[ -n $gateway ]] || return 0
  ip route replace default via "$gateway" dev "$name" 2>/dev/null || {
    local subnet
    subnet=$(ip -o route show dev "$name" scope link 2>/dev/null | awk 'NR==1 {print $1; exit}')
    [[ -n $subnet ]] && ip route replace "$subnet" dev "$name" 2>/dev/null || true
    ip route replace default via "$gateway" dev "$name" 2>/dev/null || true
  }
}
case ${1:-} in
  bridges)
    shopt -s nullglob
    for p in /sys/class/net/*/bridge; do basename "$(dirname "$p")"; done | sort
    shopt -u nullglob;;
  interfaces)
    for p in /sys/class/net/*; do basename "$p"; done | sort;;
  vm-tap-up)
    iface=${2:?TAP name required}; br=${3:?bridge name required}; shift 3
    valid_vm_tap "$iface"; valid_bridge "$br"
    [[ -d /sys/class/net/$br/bridge ]] || { echo "Bridge not found: $br" >&2; exit 1; }
    vlan=''
    while (($#)); do case "$1" in --vlan) vlan=${2:?}; valid_vlan "$vlan"; shift 2;; *) echo "Unknown option: $1" >&2; exit 2;; esac; done
    ip link show "$iface" >/dev/null 2>&1 && ip link delete dev "$iface" 2>/dev/null || true
    ip tuntap add dev "$iface" mode tap user "$(id -u vmapi)"
    ip link set dev "$iface" master "$br"
    if [[ -n $vlan ]]; then
      ip link set dev "$br" type bridge vlan_filtering 1
      bridge vlan del dev "$iface" vid 1 2>/dev/null || true
      bridge vlan add dev "$iface" vid "$vlan" pvid untagged
      while IFS= read -r member; do
        [[ -n $member && $member != "$iface" ]] || continue
        is_vm_bridge_port "$member" && continue
        bridge vlan add dev "$member" vid "$vlan" 2>/dev/null || true
      done < <(bridge_members "$br")
    fi
    ip link set dev "$iface" up
    printf '%s\n' "$iface";;
  vm-tap-down)
    iface=${2:?TAP name required}; valid_vm_tap "$iface"
    ip link show "$iface" >/dev/null 2>&1 || exit 0
    ip link set dev "$iface" down 2>/dev/null || true
    ip link delete dev "$iface";;
  bridge-info)
    name=${2:?bridge name required}; valid_bridge "$name"
    [[ -d /sys/class/net/$name/bridge ]] || { echo "Bridge not found: $name" >&2; exit 1; }
    printf '{"name":"%s","addresses":[' "$(json_escape "$name")"
    first=true
    while IFS= read -r addr; do [[ -n $addr ]] || continue; $first || printf ','; first=false; printf '"%s"' "$(json_escape "$addr")"; done < <(ip -o addr show dev "$name" scope global 2>/dev/null | awk '{print $4}')
    printf '],"gateway":"'
    ip route show default dev "$name" 2>/dev/null | awk 'NR==1 {printf $3}'
    printf '","members":['; first=true
    while IFS= read -r member; do [[ -n $member ]] || continue; $first || printf ','; first=false; printf '"%s"' "$(json_escape "$member")"; done < <(configured_bridge_members "$name")
    printf '],"ports":['; first=true
    while IFS= read -r member; do [[ -n $member ]] || continue; $first || printf ','; first=false; printf '"%s"' "$(json_escape "$member")"; done < <(bridge_members "$name")
    printf '],"persist":'
    bridge_is_persisted "$name" && printf 'true' || printf 'false'
    printf '}\n';;
  bridge-create)
    name=${2:?bridge name required}; shift 2; valid_bridge "$name"
    mode=manual address='' gateway='' persist=false; members=()
    while (($#)); do case "$1" in
      --address) address=${2:?}; valid_addr "$address"; mode=static; shift 2;;
      --dhcp) mode=dhcp; shift;;
      --manual) mode=manual; address=''; shift;;
      --gateway) gateway=${2:?}; valid_gateway "$gateway"; shift 2;;
      --member) valid_iface "${2:?}"; members+=("$2"); shift 2;;
      --persist) persist=true; shift;;
      *) echo "Unknown option: $1" >&2; exit 2;;
    esac; done
    if [[ ${#members[@]} -gt 0 ]]; then
      [[ -n $gateway ]] || gateway=$(default_gateway_for "${members[0]}")
      if [[ $mode == static && -z $address ]]; then address=$(first_global_address_for "${members[0]}"); fi
    fi
    [[ $mode != dhcp ]] || gateway=''
    ip link show "$name" >/dev/null 2>&1 || ip link add name "$name" type bridge
    ip link set dev "$name" up
    for iface in "${members[@]}"; do clear_iface_network "$iface"; ip link set dev "$iface" master "$name"; ip link set dev "$iface" up; done
    [[ -z $address || $mode != static ]] || ip address replace "$address" dev "$name"
    ensure_bridge_route "$name" "$gateway"
    ensure_qemu_bridge_allowed "$name"
    if [[ $mode == dhcp ]] && command -v udhcpc >/dev/null 2>&1; then udhcpc -n -q -i "$name" >/dev/null 2>&1 || true; fi
    $persist && write_bridge_config "$name" "$mode" "$address" "$gateway" "${members[@]}"
    printf '%s\n' "$name";;
  bridge-update)
    name=${2:?bridge name required}; shift 2; valid_bridge "$name"
    [[ -d /sys/class/net/$name/bridge ]] || { echo "Bridge not found: $name" >&2; exit 1; }
    address_set=false; mode_set=false; gateway_set=false; members_set=false; persist=false; no_persist=false; mode=manual; address='' gateway='' members=()
    while (($#)); do case "$1" in
      --address) address_set=true; mode_set=true; mode=static; address=${2-}; [[ -z $address ]] || valid_addr "$address"; shift 2;;
      --dhcp) mode_set=true; mode=dhcp; address=''; shift;;
      --manual) mode_set=true; mode=manual; address=''; shift;;
      --gateway) gateway_set=true; gateway=${2-}; [[ -z $gateway ]] || valid_gateway "$gateway"; shift 2;;
      --member) members_set=true; valid_iface "${2:?}"; members+=("$2"); shift 2;;
      --clear-members) members_set=true; members=(); shift;;
      --persist) persist=true; shift;;
      --no-persist) no_persist=true; shift;;
      *) echo "Unknown option: $1" >&2; exit 2;;
    esac; done
    if $members_set && [[ ${#members[@]} -gt 0 ]]; then
      if ! $gateway_set; then gateway=$(default_gateway_for "${members[0]}"); gateway_set=true; fi
      if [[ $mode == static && -z $address ]]; then address=$(first_global_address_for "${members[0]}"); address_set=true; fi
    fi
    if $mode_set && [[ $mode == dhcp ]]; then gateway=''; gateway_set=true; fi
    ip link set dev "$name" up
    if $address_set; then
      while IFS= read -r old; do [[ -n $old ]] && ip address del "$old" dev "$name" 2>/dev/null || true; done < <(ip -o addr show dev "$name" scope global 2>/dev/null | awk '{print $4}')
      [[ -z $address ]] || ip address replace "$address" dev "$name"
    fi
    if $mode_set && [[ $mode != static ]]; then
      while IFS= read -r old; do [[ -n $old ]] && ip address del "$old" dev "$name" 2>/dev/null || true; done < <(ip -o addr show dev "$name" scope global 2>/dev/null | awk '{print $4}')
    fi
    if $mode_set && [[ $mode == dhcp ]] && command -v udhcpc >/dev/null 2>&1; then udhcpc -n -q -i "$name" >/dev/null 2>&1 || true; fi
    if $members_set; then
      while IFS= read -r member; do ip link set dev "$member" nomaster || true; done < <(configured_bridge_members "$name")
      for iface in "${members[@]}"; do clear_iface_network "$iface"; ip link set dev "$iface" master "$name"; ip link set dev "$iface" up; done
    fi
    if $gateway_set; then
      ip route del default dev "$name" 2>/dev/null || true
      ensure_bridge_route "$name" "$gateway"
    fi
    ensure_qemu_bridge_allowed "$name"
    if $persist; then
      if ! $mode_set; then mode=static; address=$(ip -o addr show dev "$name" scope global 2>/dev/null | awk 'NR==1 {print $4}'); [[ -n $address ]] || mode=manual; fi
      $gateway_set || gateway=$(ip route show default dev "$name" 2>/dev/null | awk 'NR==1 {print $3}')
      if ! $members_set; then mapfile -t members < <(configured_bridge_members "$name"); fi
      [[ $mode == dhcp ]] && gateway=''
      write_bridge_config "$name" "$mode" "$address" "$gateway" "${members[@]}"
    fi
    $no_persist && rm -f -- "$(bridge_config "$name")"
    printf '%s\n' "$name";;
  restore)
    shopt -s nullglob
    for file in "$BRIDGE_CONFIG_ROOT"/*.conf; do
      load_bridge_config "$file"
      args=(bridge-create "$BRIDGE")
      case $MODE in
        static) args+=(--address "$ADDRESS");;
        dhcp) args+=(--dhcp);;
        manual) args+=(--manual);;
      esac
      [[ -z $GATEWAY ]] || args+=(--gateway "$GATEWAY")
      for member in "${MEMBERS[@]}"; do args+=(--member "$member"); done
      "$0" "${args[@]}"
    done
    shopt -u nullglob;;
  bridge-delete)
    name=${2:?bridge name required}; shift 2; valid_bridge "$name"
    ip link show "$name" >/dev/null 2>&1 || exit 0
    for iface in /sys/class/net/*/brport; do
      [[ -e $iface ]] || continue
      parent=$(basename "$(dirname "$iface")")
      master=$(basename "$(readlink -f "$iface/bridge" 2>/dev/null || true)")
      [[ $master == "$name" ]] && ip link set "$parent" nomaster || true
    done
    ip link set dev "$name" down || true
    ip link delete dev "$name" type bridge
    rm -f -- "$(bridge_config "$name")";;
  *) echo 'Usage: netctl bridges | interfaces | vm-tap-up TAP BRIDGE [--vlan VID] | vm-tap-down TAP | bridge-info NAME | bridge-create NAME [--address CIDR|--dhcp|--manual] [--gateway IP] [--member IFACE] [--persist] | bridge-update NAME [--address CIDR|--dhcp|--manual] [--gateway IP] [--member IFACE] [--clear-members] [--persist|--no-persist] | restore | bridge-delete NAME' >&2; exit 2;;
esac
